{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ESNext"
    ],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
  },
  "exclude": [
    "node_modules",
    "dist",
    "build",
    ".sandstone"
  ],
  "include": [
    "sandstone.config.ts",
    "src",
    "lib/indexer.ts",
    "lib/errors.ts"
  ]
}