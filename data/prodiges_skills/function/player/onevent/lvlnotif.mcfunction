execute if entity @s[tag=prodiges_skills.pref.sound] at @s run playsound minecraft:entity.player.levelup ambient @s[tag=prodiges_skills.pref.sound] ~ ~ ~ 1 0
$say Leveled up $(name) from $(previousLvl) to $(currentLvl)! Rewards: $(show), +$(point) SP
$tellraw @p[tag=prodiges_skills.pref.lvl_notif] ["",{"text":"=================================","color":"#715979"},{"text":"\n "},{"text":"Skill ","color":"yellow"},{"text":"Level Up","bold":true,"color":"yellow"},{"text":"!","color":"yellow"},{"text":" $(name)","color":"#A888B5"},{"text":" $(prev_lvl)","color":"dark_gray"},{"text":"\u2192","bold":true,"color":"dark_gray"},{"text":"$(current_lvl)\n ","bold":true,"color":"#EFB6C8"},{"text":"\n"},{"text":" Rewards:","color":"yellow"},{"text":"\n"},{"text":"  -","color":"dark_gray"},{"text":" $(show)\n"},{"text":"  -","color":"dark_gray"},{"text":" +$(point) SP","color":"gold"},{"text":"\n"},{"text":" ","italic":true},{"text":"Claim your rewards in the menu. (i)","italic":true,"color":"gray","hoverEvent":{"action":"show_text","contents":"\u00a7fOpen the UI using \u00a7d/trigger skills.lib.ui"}},{"text":"\n\n "},{"text":"Progress to","color":"gray"},{"text":" $(name)","color":"#A888B5"},{"text":" $(next_lvl)","bold":true,"color":"#EFB6C8"},{"text":":","color":"gray"},{"text":" $(100ratio)%","color":"gray"},{"text":"\n"},{"text":" $(bar)"},{"text":" $(xp)","color":"#EFB6C8"},{"text":"/","color":"#A888B5"},{"text":"$(xpToNext)","color":"#EFB6C8"},{"text":"\n"},{"text":"=================================","color":"#715979"}]
$title @s title ["",{"text":"$(name) ","color":"yellow","type":"text"},{"text":"Level Up!","color":"green","type":"text"}]
$title @s subtitle ["",{"text":"$(prev_lvl) ","color":"gray","type":"text"},{"text":"\u279c ","color":"dark_gray","bold":true,"type":"text"},{"text":"$(currentLvl)","bold":true,"color":"green","type":"text"}]