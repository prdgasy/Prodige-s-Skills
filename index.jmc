// -- Imports -- //
import 'libs/Arrays.jmc';
import 'libs/Gui.jmc';

import 'src/Consts.jmc';

import 'src/ExploitFilter.jmc';
// Initialize Exploit Filter
ExploitFilter.createScore();

import 'src/Config.jmc';
// Load data
Config.Skills();
Config.Rewards();
Config.specialItems();
Config.Crate();

import 'src/RomanConverter.jmc';
import 'src/Player/Init.jmc';

import 'src/Player/Imports.jmc';

import 'src/Menu/Imports.jmc';

// First join setup
Player.firstJoin(() => {
    // Initialize skills data for first join players
    execute as @a run Player.Init.initData();
});

say "Loaded";