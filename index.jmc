

// -- Imports -- //
import 'src/Array.jmc';
import 'src/ExploitFilter.jmc';
import 'src/Config.jmc';
import 'src/RomanConverter.jmc';
import 'src/Player/Init.jmc';

import 'src/Player/Ability.jmc';
import 'src/Player/OnEvent.jmc';
import 'src/Player/Schedule.jmc';

import 'libs/guilib.jmc';
import 'src/Menu/Pages.jmc';

// Initialize Exploit Filter
ExploitFilter.createScore();

// Load data
Config.Skills();
Config.Rewards();
Config.specialItems();
Config.Crate();

// Launch scheduled functions
Player.Schedule.wait1s();
Player.Schedule.wait5s();
Player.Schedule.wait10s();
Player.Schedule.wait1m();

// First join setup
Player.firstJoin(() => {
    // Initialize skills data for first join players
    execute as @a run Player.Init.initData();
});