Scoreboard.add(skills.player.sp);
Scoreboard.add(skills.booster.1.power);
Scoreboard.add(skills.booster.1.duration);
Scoreboard.add(skills.booster.2.power);
Scoreboard.add(skills.booster.2.duration);
Scoreboard.add(skills.crate.cooldown);
advancement revoke @a only prodiges_skills:trigger_enable;
class Player {

    function 5s() {
        Player.onEvent.eligible_test();
        Player.onEvent.check();
        
    }

    function 1m() {
        Player.Booster.loop();
        if (skills.crate.cooldown:@p >= 0) {
            skills.crate.cooldown:@p -= 1;
        }
    }

    function 20s() {
        tag @s remove skills.not_eligible;
    }

    class onEvent {
        function check() { 
            Hardcode.repeatList(
                "[name]",
                () => {
                    $isTask = 1;
                    $i = 0;
                    while ($isTask) {
                        
                        ::temp.vars.i = $i;
                        execute run {
                            ::temp.Player.Task.del();
                            $$isTask ?= ::temp.Player.Task = ::DB.Skills.[name].Tasks[$(i)];
                            ::temp.Player.Task.name = ::DB.Skills.[name].name;
                            ::temp.Player.Task.name_lower = ::DB.Skills.[name].name_lower;
                            if ($isTask) { Player.onEvent.test_tasking() with ::temp.Player.Task; }
                        } with ::temp.vars; 
                        $i++;
                    }
            }, #skillList);
        }

        function eligible_test() {
            len_array($len, DB.notEligible);
            for ($len = $len; $len >= 0; $len--) {
                ::temp.eli.i = $len;
                execute run { $::temp.eli.id = ::DB.notEligible[$(i)]; } with ::temp.eli;
                execute run { $execute if score @s skills.noteligible.$(id) matches 1.. run {
                    tag @s add skills.not_eligible;
                    $scoreboard players set @s skills.noteligible.$(id) 0;
                } with ::temp.eli; } with ::temp.eli;
            }
        }

        function test_tasking() {
            $execute if score @s[tag=skills.pref.skill_prog] skills.$(name).task.$(task) matches 1.. run {
                if (entity @s[tag=!skills.not_eligible]) {
                    Player.onEvent.task_is() with ::temp.Player.Task;
                }
                
                $execute if entity @s[tag=skills.ability.$(name)] run Player.Ability.main() with ::temp.Player.Task;
                $scoreboard players set @s skills.$(name).task.$(task) 0;
            }  with ::temp.Player.Task;
        }

        function task_is() {
            Player.onEvent.set_Xp() with ::temp.Player.Task;
            Player.onEvent.set_point() with ::temp.Player.Task;
            

            // Set storages
            $execute store result storage prodiges_skills:prodiges_skills temp.Player.tellraw_comp.current_Xp int 1 run scoreboard players get @s skills.$(name).Xp;
            $execute store result storage prodiges_skills:prodiges_skills temp.Player.tellraw_comp.XpToNext int 1 run scoreboard players get @s skills.$(name).XpToNext;
            $execute store result storage prodiges_skills:prodiges_skills temp.Player.tellraw_comp.current_lvl int 1 run scoreboard players get @s skills.$(name).lvl;
            ::temp.Player.tellraw_comp.roman_lvl = ::temp.Player.tellraw_comp.current_lvl;
            roman_conv(roman_lvl, temp.Player.tellraw_comp);

            // Get percentage %
            $scoreboard players operation $den skills.__variable__ = @s skills.$(name).Xp;
            $scoreboard players operation $num skills.__variable__ = @s skills.$(name).XpToNext;

            $100ratio = $den;
            $100ratio *= 100;
            $100ratio /= $num;
            ::temp.Player.tellraw_comp.100ratio = $100ratio;

            // Send notif
            $execute if score @s skills.$(name).lvl matches ..99 as @s[tag=skills.pref.Xp_notif] run Player.onEvent.Xp_notif() with ::temp.Player.tellraw_comp;
            $execute if score @s skills.$(name).lvl matches 100 as @s[tag=skills.pref.Xp_notif] run Player.onEvent.Xp_notif_max() with ::temp.Player.tellraw_comp;

            // Lvl check
            $execute if score @s skills.$(name).lvl matches ..99 if score @s skills.$(name).Xp >= @s skills.$(name).XpToNext run Player.onEvent.lvl() with ::temp.Player.tellraw_comp;
            
        }

        function Xp_notif() {
            $Text.actionbar(@s, "&<aqua>+$(Xp) &<aqua>Xp (x&<$Xp_power>) &<dark_gray>• &<gold>+$(point) &<gold>SP (x&<$point_power>) &<dark_gray>| &<#A888B5>$(name) &<#EFB6C8, bold>$(roman_lvl) &<dark_gray>| &<gray>$(current_Xp)&<dark_gray>/&<gray>$(XpToNext) $(100ratio)%");
        }

        function Xp_notif_max() {
            $Text.actionbar(@s, "&<gold>+$(point) &<bold>x&<$point_power> &<gold>SP &<dark_gray>| &<light_purple>$(name) &<dark_purple, bold>$(current_lvl) &<dark_gray>| &<gray>$(current_Xp)&<dark_gray>/&<gray>$(current_Xp) 100%");
        }

        function set_Xp() {
            // Get Xp from DB
            JMC.put("$scoreboard players set $Xp skills.__variable__ $(Xp)");

            // Mult by the number of times task was repeated -> 5sec loop
            JMC.put("$scoreboard players operation $Xp skills.__variable__ *= @s skills.$(name).task.$(task)");
            // Mult by booster
            $Xp_power = skills.booster.1.power:@s;
            $Xp *= $Xp_power;

            // Storage set
            ::temp.Player.tellraw_comp = ::temp.Player.Task;

            // Set new Xp to the multiplied one
            ::temp.Player.tellraw_comp.Xp = $Xp;
            
            // Add Xp with new components
            execute run { $scoreboard players add @s skills.$(name).Xp $(Xp); } with ::temp.Player.tellraw_comp;
        }

        function set_point() {
            $point = Config.Points();
            // Mult by the number of times task was repeated -> 5sec loop
            JMC.put("$scoreboard players operation $point skills.__variable__ *= @s skills.$(name).task.$(task)");
            $point_power = skills.booster.2.power:@s;
            $point *= $point_power;
            ::temp.Player.tellraw_comp.point = $point;

            skills.player.sp:@s += $point;
        }

        function lvl() {
            $execute if score @s skills.$(name).lvl matches ..98 run {
                // Reset Xp
                $scoreboard players operation @s skills.$(name).Xp -= @s skills.$(name).XpToNext;

                // Set new XpToNext: "U(n+1) = U(n)*1.2" < 2000
                    $scoreboard players operation $XpToNext skills.__variable__ = @s skills.$(name).XpToNext;
                    $XpToNext *= 12;
                    $XpToNext /= 10;
                    $scoreboard players operation @s skills.$(name).XpToNext = $XpToNext skills.__variable__;
                    $execute if score $XpToNext skills.__variable__ matches 2001.. run scoreboard players set @s skills.$(name).XpToNext 2000;
                
                // Store $temp_lvl for lvl_notif
                    $scoreboard players operation $temp_lvl skills.__variable__ = @s skills.$(name).lvl;

                // Previous lvl
                    ::temp.Player.title.prev_lvl = $temp_lvl;
                    $passed_lvl = $temp_lvl;
                    execute run { $tag @s add skills.claimed.$(name).$(prev_lvl); } with ::temp.Player.title;
                // New lvl
                    $scoreboard players add @s skills.$(name).lvl 1;
                // Current lvl
                    $execute store result storage prodiges_skills:prodiges_skills temp.Player.title.current_lvl int 1 run scoreboard players get @s skills.$(name).lvl;
                // Next lvl
                    $temp_lvl += 2;
                    ::temp.Player.title.next_lvl = $temp_lvl;

                // Set storages
                    ::temp.Player.title.name = ::temp.Player.tellraw_comp.name;
                // Roman conversion
                    execute run {
                        $::temp.Player.title.prev_lvl = ::DB.Roman.$(prev_lvl);
                        $::temp.Player.title.current_lvl = ::DB.Roman.$(current_lvl);
                        $::temp.Player.title.next_lvl = ::DB.Roman.$(next_lvl);
                    } with ::temp.Player.title;

                // Get percentage %
                    $scoreboard players operation $num skills.__variable__ = @s skills.$(name).Xp;
                    $scoreboard players operation $den skills.__variable__ = @s skills.$(name).XpToNext;
                    
                    ::temp.Player.title.Xp = $num;
                    ::temp.Player.title.XpToNext = $den;
                    $15ratio = $num;
                    $15ratio *= 15;
                    $15ratio /= $den;
                    $100ratio = $num;
                    $100ratio *= 100;
                    $100ratio /= $den;
                    ::temp.Player.title.100ratio = $100ratio;
                    ::temp.Player.title.15ratio = $15ratio;
                    if ($15ratio <= 15) {
                        execute run {
                            $::temp.Player.title.bar = ::DB.Progress.$(15ratio);
                        } with ::temp.Player.title;
                    } else {
                            ::temp.Player.title.bar = ::DB.Progress.15;
                    }
                // Set rewards
                    $mod = $passed_lvl;
                    $mod %= 10;

                    if ($mod == 0) {
                        ::temp.Player.title.point = ::DB.Rewards.3.point;
                        ::temp.Player.title.show = ::DB.Rewards.3.show;
                    }
                    else if ($mod == 6 || $mod == 2) {
                        ::temp.Player.title.point = ::DB.Rewards.2.point;
                        ::temp.Player.title.show = ::DB.Rewards.2.show;
                    }
                    else {
                        ::temp.Player.title.point = ::DB.Rewards.1.point;
                        ::temp.Player.title.show = ::DB.Rewards.1.show;

                    }
                // Send first notif
                execute as @s[tag=skills.pref.lvl_notif] run Player.onEvent.lvl_notif() with ::temp.Player.title;
                
                // Set storages
                    $execute store result storage prodiges_skills:prodiges_skills temp.Player.tellraw_comp.current_Xp int 1 run scoreboard players get @s skills.$(name).Xp;
                    $execute store result storage prodiges_skills:prodiges_skills temp.Player.tellraw_comp.XpToNext int 1 run scoreboard players get @s skills.$(name).XpToNext;
                    $execute store result storage prodiges_skills:prodiges_skills temp.Player.tellraw_comp.current_lvl int 1 run scoreboard players get @s skills.$(name).lvl;
                    ::temp.Player.tellraw_comp.roman_lvl = ::temp.Player.tellraw_comp.current_lvl;
                    roman_conv(roman_lvl, temp.Player.tellraw_comp);

                // Get percentage %
                    $scoreboard players operation $den skills.__variable__ = @s skills.$(name).Xp;
                    $scoreboard players operation $num skills.__variable__ = @s skills.$(name).XpToNext;

                    $100ratio = $den;
                    $100ratio *= 100;
                    $100ratio /= $num;
                    ::temp.Player.tellraw_comp.100ratio = $100ratio;

                // Re Send notif
                execute as @s[tag=skills.pref.lvl_notif] run Player.onEvent.Xp_notif() with ::temp.Player.tellraw_comp;
                execute as @s[tag=skills.pref.lvl_broadcast] run Player.onEvent.lvl_broadcast() with ::temp.Player.tellraw_comp;
                // While
                $execute if score @s skills.$(name).Xp >= @s skills.$(name).XpToNext run Player.onEvent.lvl() with ::temp.Player.tellraw_comp;
                
                
            } with ::temp.Player.tellraw_comp;
            $execute if score @s skills.$(name).lvl matches 99 run {
                // Reset Xp
                $scoreboard players operation @s skills.$(name).Xp -= @s skills.$(name).XpToNext;

                // Set new XpToNext: "U(n+1) = U(n)*1.2" < 5000
                $scoreboard players operation @s skills.$(name).XpToNext = @s skills.$(name).Xp;
                
                // Store $temp_lvl for lvl_notif
                $scoreboard players operation $temp_lvl skills.__variable__ = @s skills.$(name).lvl;

                // Previous lvl
                $passed_lvl = $temp_lvl;
                $tag @s add skills.claimed.$(name).99;

                $scoreboard players add @s skills.$(name).lvl 1;
                // Current lvl
                $current_lvl = 100;
                

                // Set storages
                ::temp.Player.title.name = ::temp.Player.tellraw_comp.name;
                // Roman conversion
                ::temp.Player.title.prev_lvl = ::DB.Roman.99;

                // Get percentage %
                $::temp.Player.title.Xp = scoreboard players get @s skills.$(name).Xp;
                
                $15ratio = 15;
                $100ratio = 100;
                
                ::temp.Player.title.100ratio = $100ratio;
                ::temp.Player.title.15ratio = $15ratio;
                execute run {
                    $::temp.Player.title.bar = ::DB.Progress.$(15ratio);
                } with ::temp.Player.title;

                // Set rewards
                    $mod = $passed_lvl;
                    $mod %= 10;

                    if ($mod == 0) {
                        ::temp.Player.title.point = ::DB.Rewards.3.point;
                        ::temp.Player.title.show = ::DB.Rewards.3.show;
                    }
                    else if ($mod == 6 || $mod == 2) {
                        ::temp.Player.title.point = ::DB.Rewards.2.point;
                        ::temp.Player.title.show = ::DB.Rewards.2.show;
                    }
                    else {
                        ::temp.Player.title.point = ::DB.Rewards.1.point;
                        ::temp.Player.title.show = ::DB.Rewards.1.show;

                    }
                    
                execute as @s[tag=skills.pref.lvl_notif] run Player.onEvent.lvl_max() with ::temp.Player.title;

                // Set New bar
                // Set storages
                $execute store result storage prodiges_skills:prodiges_skills temp.Player.tellraw_comp.current_Xp int 1 run scoreboard players get @s skills.$(name).Xp;
                $execute store result storage prodiges_skills:prodiges_skills temp.Player.tellraw_comp.XpToNext int 1 run scoreboard players get @s skills.$(name).XpToNext;
                $execute store result storage prodiges_skills:prodiges_skills temp.Player.tellraw_comp.current_lvl int 1 run scoreboard players get @s skills.$(name).lvl;
                ::temp.Player.tellraw_comp.roman_lvl = ::temp.Player.tellraw_comp.current_lvl;
                roman_conv(roman_lvl, temp.Player.tellraw_comp);

                // Get percentage %
                $scoreboard players operation $den skills.__variable__ = @s skills.$(name).Xp;
                $scoreboard players operation $num skills.__variable__ = @s skills.$(name).XpToNext;

                $100ratio = $den;
                $100ratio *= 100;
                $100ratio /= $num;
                ::temp.Player.tellraw_comp.100ratio = $100ratio;

                // Re Send notif
                execute as @s[tag=skills.pref.lvl_notif] run Player.onEvent.Xp_notif() with ::temp.Player.tellraw_comp;
                execute as @s[tag=skills.pref.lvl_broadcast] run Player.onEvent.lvl_broadcast() with ::temp.Player.tellraw_comp;

                
            } with ::temp.Player.tellraw_comp;
        }

        function lvl_notif() {
            // ╔ ╗ ║ ╚ ╝  ═  
            if (entity @s[tag=skills.pref.sound]) { execute at @s run playsound minecraft:entity.player.levelup ambient @s[tag=skills.pref.sound] ~ ~ ~ 1 0; }

            $tellraw @p[tag=skills.pref.lvl_notif] ["",{"text":"=================================","color":"#715979"},{"text":"\n "},{"text":"Skill ","color":"yellow"},{"text":"Level Up","bold":true,"color":"yellow"},{"text":"!","color":"yellow"},{"text":" $(name)","color":"#A888B5"},{"text":" $(prev_lvl)","color":"dark_gray"},{"text":"\u2192","bold":true,"color":"dark_gray"},{"text":"$(current_lvl)\n ","bold":true,"color":"#EFB6C8"},{"text":"\n"},{"text":" Rewards:","color":"yellow"},{"text":"\n"},{"text":"  -","color":"dark_gray"},{"text":" $(show)\n"},{"text":"  -","color":"dark_gray"},{"text":" +$(point) SP","color":"gold"},{"text":"\n"},{"text":" ","italic":true},{"text":"Claim your rewards in the menu. (i)","italic":true,"color":"gray","hoverEvent":{"action":"show_text","contents":"§fOpen the UI using §d/trigger skills.lib.ui"}},{"text":"\n\n "},{"text":"Progress to","color":"gray"},{"text":" $(name)","color":"#A888B5"},{"text":" $(next_lvl)","bold":true,"color":"#EFB6C8"},{"text":":","color":"gray"},{"text":" $(100ratio)%","color":"gray"},{"text":"\n"},{"text":" $(bar)"},{"text":" $(Xp)","color":"#EFB6C8"},{"text":"/","color":"#A888B5"},{"text":"$(XpToNext)","color":"#EFB6C8"},{"text":"\n"},{"text":"=================================","color":"#715979"}];
            
            $Text.title(@s, "&<#A888B5>$(name) &<#EFB6C8>Level Up!");
            $Text.subtitle(@s, "&<#ce81ff>$(prev_lvl) &<dark_gray,bold>➜ &<bold, #ce81ff>$(current_lvl)");
        }

        function lvl_max() {
            if (entity @s[tag=skills.pref.sound]) { 
                execute at @s run playsound minecraft:entity.player.levelup ambient @s[tag=skills.pref.sound] ~ ~ ~ 1 0; 
                execute at @s run playsound minecraft:entity.ender_dragon.growl ambient @s[tag=skills.pref.sound] ~ ~ ~ 1 0;
            }
            $tellraw @p ["",{"text":"=================================","color":"#715979"},{"text":"\n "},{"text":"Skill ","color":"yellow"},{"text":"Level Up","bold":true,"color":"yellow"},{"text":"!","color":"yellow"},{"text":" $(name)","color":"#A888B5"},{"text":" $(prev_lvl)","color":"dark_gray"},{"text":"\u2192","bold":true,"color":"dark_gray"},{"text":"C","bold":true,"color":"dark_purple"},{"text":"\n"},{"text":" \n"},{"text":" Rewards:","color":"yellow"},{"text":"\n"},{"text":"  -","color":"dark_gray"},{"text":" $(show)\n"},{"text":"  -","color":"dark_gray"},{"text":" $(point) SP","color":"gold"},{"text":"\n"},{"text":" ","italic":true},{"text":"Claim your rewards in the menu. (i)","italic":true,"color":"gray","hoverEvent":{"action":"show_text","contents":"§fOpen the UI using §d/trigger skills.lib.ui"}},{"text":"\n\n "},{"text":"Check out the","color":"gray","hoverEvent":{"action":"show_text","contents":"§fOpen the Shop using §d/trigger skills.lib.ui"}},{"text":" ","bold":true,"hoverEvent":{"action":"show_text","contents":"§fOpen the Shop using §d/trigger skills.lib.ui"}},{"text":"Prestige","bold":true,"color":"light_purple","hoverEvent":{"action":"show_text","contents":"§fOpen the Shop using §d/trigger skills.lib.ui"}},{"text":" ","hoverEvent":{"action":"show_text","contents":"§fOpen the Shop using §d/trigger skills.lib.ui"}},{"text":"menu in\n the ","color":"gray","hoverEvent":{"action":"show_text","contents":"§fOpen the Shop using §d/trigger skills.lib.ui"}},{"text":"Shop","color":"green","hoverEvent":{"action":"show_text","contents":"§fOpen the Shop using §d/trigger skills.lib.ui"}},{"text":"!","color":"gray","hoverEvent":{"action":"show_text","contents":"§fOpen the Shop using §d/trigger skills.lib.ui"}},{"text":" ","color":"#EFB6C8","hoverEvent":{"action":"show_text","contents":"§fOpen the Shop using §d/trigger skills.lib.ui"}},{"text":"(i)","italic":true,"color":"gray","hoverEvent":{"action":"show_text","contents":"§fOpen the Shop using §d/trigger skills.lib.ui"}},{"text":"\n"},{"text":"=================================","color":"#715979"}];

            $Text.title(@s, "&<#A888B5>$(name) &<#EFB6C8>Level Up!");
            $Text.subtitle(@s, "&<#ce81ff>$(prev_lvl) &<dark_gray,bold>➜ &<bold, #ce81ff>C");
        }

        function lvl_broadcast() {
            $Text.tellraw(@a[tag=skills.pref.lvl_broadcast], "&<yellow, bold>Skills ♦ &<light_purple>&<@s> &<yellow>has reached &<#A888B5>$(name) &<#EFB6C8, bold>$(roman_lvl)&<yellow>!");
        }
    }

    class Booster {
        function give() { 
            $give @p stone_pickaxe[custom_data={prodiges_skills:{power:$(power), type_int:$(type_int)b, type:$(type), duration:$(duration), booster_color:$(booster_color)}}, custom_name='{"text":"x$(power) $(type) Booster §7- $(duration) min §8§l♦ §eClick","color":$(booster_color),"italic":false}', lore=['[{"text":"Skills","color":"blue","italic":false}]','[{"text":"Click to use!","color":"gray","italic":false}]'],!attribute_modifiers, item_model="minecraft:$(model)", enchantment_glint_override=true, consumable={consume_seconds:930004}, food={nutrition:0, saturation:0, can_always_eat:true}, max_stack_size=16, !tool, !max_damage];
        }

        function use() {
            advancement revoke @s only prodiges_skills:booster/use;
            ::temp.Booster.use = @s::SelectedItem.components.minecraft:custom_data.prodiges_skills;
            
            $type = ::temp.Booster.use.type_int;
            if ($type == 1 && skills.booster.1.duration:@s > 1) {
                Text.actionbar(@s, "&<red, bold>Skills ♦ &<red>You already have an active &<aqua>Xp Booster&<red>!");
            } else if ($type == 2 && skills.booster.2.duration:@s > 1) {
                Text.actionbar(@s, "&<red, bold>Skills ♦ &<red>You already have an active &<gold>SP Booster&<red>!");
            } else {
                execute run { 
                    $clear @s stone_pickaxe[custom_data={prodiges_skills:{power:$(power), type_int:$(type_int)b, type:$(type), duration:$(duration), booster_color:$(booster_color)}}] 1;


                    $scoreboard players set @s skills.booster.$(type_int).duration $(duration);
                    $scoreboard players set @s skills.booster.$(type_int).power $(power);
                    
                    $tellraw @p [{"text":"§a§lSkills ♦ §aYou enabled a"}, {"text":" [x$(power) $(type) Booster] §afor §7$(duration) minutes§a.","color":"$(booster_color)"}];
                    
                    playsound entity.player.levelup ambient @s ~ ~ ~ 1 2;
                } with ::temp.Booster.use;
            }

            
        }

        function loop() {
            // Repeated every minutes
            Hardcode.repeat(
                "[type]",
                ()=>{
                    if (skills.booster.[type].duration:@s > 0) {
                        skills.booster.[type].duration:@s -= 1;
                    } else if (skills.booster.[type].duration:@s == 0) {
                        skills.booster.[type].duration:@s = -1;
                        skills.booster.[type].power:@s = 1;
                    }
                },
                1,
                3
            );
        }
    }

    class Ability {
        function main() {
            $get = random value 0..100;
            $scoreboard players operation $prestige_lvl skills.__variable__ = @s skills.$(name).prestige;
            $chance = $prestige_lvl;
            $chance *= 5;
            
            if ($get < $chance) {
                execute run {
                    JMC.put("$function prodiges_skills:player/ability/$(name_lower)");
                } with ::temp.Player.Task;
            }
            
        }

        function mining() {
            effect give @s haste 60 4;
        }

        function foraging() {
            execute at @s anchored eyes run loot spawn ^ ^ ^1.5 loot {"pools":[{"rolls":1,"entries":[{"type":"minecraft:item","name":"minecraft:golden_apple"}]}]};
            execute at @s run {
                playsound minecraft:entity.arrow.shoot ambient @s ~ ~ ~ 1 0;
                particle minecraft:happy_villager ~ ~ ~ 1 1 1 1 100;
                
                $r = random value 0..2;
                switch($r) {
                    case 0: ::temp.Player.ability.foraging.type = "oak_sapling";
                    case 1: ::temp.Player.ability.foraging.type = "dark_oak_sapling";
                    case 2: ::temp.Player.ability.foraging.type = "acacia_sapling";
                }
                execute run { $fill ~-2 ~-1 ~-2 ~2 ~ ~2 $(type) keep; } with ::temp.Player.ability.foraging;                    
            }
            
        }

        function excavation() {
            execute at @s anchored eyes run loot spawn ^ ^ ^1.5 loot {"pools":[{"rolls":3,"entries":[{"type":"minecraft:item","name":"minecraft:clay_ball","weight":10},{"type":"minecraft:item","name":"minecraft:flint","weight":8},{"type":"minecraft:item","name":"minecraft:brick","weight":6},{"type":"minecraft:item","name":"minecraft:bone","weight":7},{"type":"minecraft:item","name":"minecraft:bone_block","weight":4},{"type":"minecraft:item","name":"minecraft:glass","weight":3},{"type":"minecraft:item","name":"minecraft:amethyst_shard","weight":5},{"type":"minecraft:item","name":"minecraft:egg","weight":5},{"type":"minecraft:item","name":"minecraft:prismarine_crystals","weight":4},{"type":"minecraft:item","name":"minecraft:sniffer_egg","weight":1},{"type":"minecraft:item","name":"minecraft:cooked_porkchop","weight":6},{"type":"minecraft:item","name":"minecraft:rabbit_foot","weight":3},{"type":"minecraft:item","name":"minecraft:suspicious_sand","weight":3},{"type":"minecraft:item","name":"minecraft:globe_banner_pattern","weight":1},{"type":"minecraft:item","name":"minecraft:potato","weight":6}]}]};
        }

        function combat() {
            effect give @s strength 60 4;
        }

        function farming() {
            execute at @s anchored eyes run loot spawn ^ ^ ^1.5 loot {"pools":[{"rolls":3,"entries":[{"type":"minecraft:item","name":"bone_meal","weight":5},{"type":"item","name":"minecraft:golden_carrot","weight":5},{"type":"item","name":"minecraft:glow_berries","weight":7},{"type":"item","name":"minecraft:honey_bottle","weight":4},{"type":"item","name":"minecraft:beetroot_soup","weight":3},{"type":"item","name":"minecraft:cake","weight":2},{"type":"item","name":"minecraft:sweet_berries","weight":8},{"type":"item","name":"minecraft:melon_slice","weight":9},{"type":"item","name":"minecraft:pumpkin_pie","weight":4},{"type":"item","name":"minecraft:golden_apple","weight":1},{"type":"item","name":"minecraft:enchanted_golden_apple","weight":0.5},{"type":"item","name":"minecraft:baked_potato","weight":6},{"type":"item","name":"minecraft:cookie","weight":5},{"type":"item","name":"minecraft:rabbit_stew","weight":2},{"type":"item","name":"minecraft:mushroom_stew","weight":3}]}]};
        }
    }

    class Crate {
        function open() { // as menu
            len_inv($invlen);
            if (skills.crate.cooldown:@p > 0) {
                Text.tellraw(@p, "&<red, bold>Skills ♦ &<red>You are still on a cooldown (&<skills.crate.cooldown:@p> minute(s)).");
                playsound minecraft:entity.enderman.teleport ambient @p[tag=skills.pref.sound] ~ ~ ~ 1 1;
            } else if ($invlen > 34) {
                Text.tellraw(@p, "&<red, bold>Skills ♦ &<red>Inventory is full.");
                playsound minecraft:entity.enderman.teleport ambient @p[tag=skills.pref.sound] ~ ~ ~ 1 1;
            } else {
                playsound minecraft:block.chest.open ambient @p[tag=skills.pref.sound] ~ ~ ~ 1 0;
                playsound minecraft:entity.wind_charge.wind_burst ambient @p[tag=skills.pref.sound] ~ ~ ~ 1 0;
                skills.crate.cooldown:@p = 60;
                len_array($len_crate, DB.Shop.crate);
                $len_crate -= 1;
                ::temp.gui.crate.len = $len_crate;
                execute run { $::temp.gui.crate.i = random value 0..$(len); } with ::temp.gui.crate;

                execute run {
                    $::temp.gui.crate = ::DB.Shop.crate[$(i)];
                } with ::temp.gui.crate;

                execute run {
                    $$(command);
                } with ::temp.gui.crate;
                // Separé car $$(command) defini $(rerp)
                execute run {
                    $tellraw @p ["",  
                        {"text":"\n ♦ ","bold":true,"color":"aqua"},  
                        {"text":"Skill Crate","bold":true,"color":"gold"},  
                        {"text":" ♦\n","bold":true,"color":"aqua"},  
                        {"text":"\n §l\u25BA §eRewards:\n","bold":false,"color":"yellow"},  
                        {"text":" \u0020 \u25CF ","color":"gray"},  
                        {"text":"$(repr)"}  
                    ];
                } with ::temp.gui.crate;
            }
        }

    }

    class specialItems {
        function give() {
            $give @p $(item_repr)[custom_data={prodiges_skills:{specialItem: 1b}},custom_name='{"text":"$(item_name)","italic":false}',lore=['[{"text":"Skills - $(type)","italic":false,"color":"blue"}]','[{"text":"$(rarity)","italic":false,"color":"blue"}]','[""]','[{"text":"$(desc1)","italic":true,"color":"light_purple"}]','[{"text":"$(desc2)","italic":true,"color":"light_purple"}]'], enchantments={$(ench_0_name):$(ench_0_level), $(ench_1_name):$(ench_1_level)}];
        }

        function give_from_id() {
            $::temp.specialItems.give = ::DB.Shop.specialItems[$(id)];
            ::temp.specialItems.give.ench_0_name = ::temp.specialItems.give.Enchants[0].name;
            ::temp.specialItems.give.ench_0_level = ::temp.specialItems.give.Enchants[0].level;
            ::temp.specialItems.give.ench_1_name = ::temp.specialItems.give.Enchants[1].name;
            ::temp.specialItems.give.ench_1_level = ::temp.specialItems.give.Enchants[1].level;
            Player.specialItems.give() with ::temp.specialItems.give;
        }

        function give_random() {
            $id = random value 0..21;
            ::temp.crate.id = $id;
            execute run {
                $::temp.gui.crate.repr = ::DB.Shop.specialItems[$(id)].item_name;
            } with ::temp.crate;
            
            Player.specialItems.give_from_id() with ::temp.crate;
            
        }
    }
}

new advancement(booster.use) {"criteria":{"requirement":{"trigger":"minecraft:using_item","conditions":{"item":{"items":"minecraft:stone_pickaxe","components":{"minecraft:consumable":{"consume_seconds":930004}}}}}},"rewards":{"function":"prodiges_skills:player/booster/use"}}