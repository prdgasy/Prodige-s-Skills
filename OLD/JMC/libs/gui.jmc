Scoreboard.add(skills.lib.gui.id);
Scoreboard.add(skills.lib.gui.page);

Scoreboard.add(Skills, trigger);
forceload add 930005 930005;
setblock 930005 0 930005 yellow_shulker_box;
new loot_table(minecraft.blocks.yellow_shulker_box) {"type":"minecraft:block","pools":[{"rolls":1,"bonus_rolls":0,"entries":[{"type":"minecraft:item","name":"minecraft:yellow_shulker_box","functions":[{"function":"minecraft:copy_components","source":"block_entity","include":["minecraft:custom_name","minecraft:container","minecraft:lock","minecraft:container_loot"]}]}],"conditions":[{"condition":"minecraft:inverted","term":{"condition":"minecraft:match_tool","predicate":{"predicates":{"minecraft:custom_data":{"drop_contents":1}}}}}]},{"rolls":1,"bonus_rolls":0,"entries":[{"type":"minecraft:dynamic","name":"minecraft:contents"}],"conditions":[{"condition":"minecraft:match_tool","predicate":{"predicates":{"minecraft:custom_data":{"drop_contents":1}}}}]}],"random_sequence":"minecraft:blocks/yellow_shulker_box","__smithed__":{"priority":{"stage":"early"},"rules":[{"type":"append","target":"pools[0].conditions","source":{"type":"reference","path":"pools[0].conditions[0]"}},{"type":"append","target":"pools","source":{"type":"reference","path":"pools[1]"}}]}}


class skills.lib.gui {
    class Trigger {
        function enable() {
            scoreboard players enable @s Skills;
        }

        function main() {
            execute as @a[scores={Skills=1..}] at @s run skills.lib.gui.Trigger.Skill();
        }

        function Skill() {
            skills.lib.gui.construct.summon();
            Skills:@s = 0;
            scoreboard players enable @s Skills;
        }
    }
    
    class construct {
        function main() { // Auto
            execute at @s as @e[type = #cm, tag = skills.lib.gui] run {
                if (skills.lib.gui.id:@p == skills.lib.gui.id:@s) {
                    skills.lib.gui.construct.in();
                }
            }
        }

        function close() { // Auto
            tp @s ~ ~-1000 ~;
            kill @s;
        }

        function in() { // Auto
            execute at @s run {
                if (!entity @p[distance=..1]) {
                    skills.lib.gui.construct.close();
                }
            }
            
            skills.lib.gui.Logic.item_return();
            skills.lib.gui.Logic.main();
        }

        function summon() { // Auto
            // Creer l'entité porteuse du GUI
            // ID unique
            // => command: summon
            if (!entity @e[type = #cm, tag = skills.lib.gui, distance=..1] && block ~ ~ ~ air && block ~ ~1 ~ air) {
                summon #cm ~ ~1 ~ {Tags:[skills.lib.gui, this], NoGravity:1b, Silent:1b, Invulnerable:1b};
                skills.lib.gui.id:#global.id += 1;
                skills.lib.gui.id:@e[type=#cm, tag=skills.lib.gui, tag=this] = skills.lib.gui.id:#global.id;
                skills.lib.gui.page:@e[type=#cm, tag=skills.lib.gui, tag=this] = 1;

                skills.lib.gui.id:@s = skills.lib.gui.id:#global.id;
                
                execute as @e[type=#cm, tag=skills.lib.gui, tag=this] run {
                    tag @s remove this;
                    skills.lib.gui.Logic.refresh();
                }
            } else {
                Text.actionbar(@p, "&<red, bold>Skills ♦ &<red>GUI already active or there is no free space!");
            }
        }
    }
    
    class Logic {

        function main() { // Auto
            skills.lib.gui.Logic.item_return();
            skills.lib.gui.Logic.click_detect();
        }

        function item_return() { // Auto
            [930005, 0, 930005]::Items = @s::Items;
            [930005, 0, 930005]::Items[{components:{"minecraft:custom_data":{skills_lib_gui:1b}}}].del();

            $item_present = loot give @p mine 930005 0 930005 stick[custom_data={drop_contents: 1b}];

            if ($item_present) { skills.lib.gui.Logic.refresh(); }

        }
        
        function refresh() { // Auto
            // Rafraichi le menu:
            //  remet les items a leurs places.
            //  /!\ Execution post modification des scores /!\
            @s::Items.del();
            Hardcode.switch(
                skills.lib.gui.page:@s,
                "#id",
                ()=>{GUI.setItem.#id();},
                #page_number
            );


        }

        @lazy function switch_page(page_id) { // Auto
            skills.lib.gui.page:@s = $page_id;
            skills.lib.gui.Logic.click_event();
        }

        function click_event() { // Auto
            playsound minecraft:block.stone.break ambient @p[tag=skills.pref.sound] ~ ~ ~ .5;
            skills.lib.gui.Logic.refresh();
        }

        function click_detect() { // Auto
            // Detect les items manquant dans le menu
            // Selon la page, les places des items changent
            $has_ui_item ?= clear @p *[custom_data={skills_lib_gui:1b}];
            if ($has_ui_item) {
                Hardcode.switch(
                    skills.lib.gui.page:@s,
                    "#id",
                    () => {
                        GUI.Click.#id();
                    },
                    #page_number
                );
            }
        }

        
    }
}

new advancement(trigger_enable) {
    "criteria": {
        "requirement": {
            "trigger": "minecraft:tick"
        }
    },
    "rewards": {
        "function": "prodiges_skills:skills/lib/gui/trigger/enable"
    }
}