@lazy function roman_conv(var, storage) {
    ::temp.roman_conv.num = ::$storage.$var;
    execute run {
        $::$storage.$var = ::DB.Roman.$(num);
    } with ::temp.roman_conv;
    
}
@lazy function toggler_tag(tag) {
    if (entity @p[tag=skills.pref.$tag]) {
        tag @p remove skills.pref.$tag;
    } else {
        tag @p add skills.pref.$tag;
    }
    playsound minecraft:entity.arrow.hit_player ambient @p[tag=skills.pref.sound] ~ ~ ~ 1 0;
}
@lazy function len_array(var, array) {
    $var = execute if data storage prodiges_skills:prodiges_skills $array[];
}
@lazy function len_inv(var) {
    $var = execute if data entity @p Inventory[];
}

function uninstall() {
    Text.tellraw(@s, "&<red, bold>Skills ♦ &<red>Every trace of the datapack has been deleted. &<gray>You can safely remove it from your datapack folder.");
    for ($index = 0; $index < 7; $index++) {
        ::temp.init.index = $index;
        execute run { $::temp.init.name = ::DB.Indexes.$(index); } with ::temp.init;
        execute run {
            $scoreboard objectives remove skills.$(name).prestige;
            $scoreboard objectives remove skills.$(name).Xp;
            $scoreboard objectives remove skills.$(name).lvl;
            $scoreboard objectives remove skills.$(name).XpToNext;

            $i = 0;
            $exist = 0;
            ::temp.init.i = $i;
            execute run {
                $$exist ?= ::DB.Skills.$(name).Tasks[$(i)];
            } with ::temp.init;

            while ($exist) {
                
                execute run { 
                    $::temp.init.task = ::DB.Skills.$(name).Tasks[$(i)].task; 
                } with ::temp.init;
                
                execute run {
                    $scoreboard objectives remove skills.$(name).task.$(task);
                } with ::temp.init;

                $i++;
                ::temp.init.i = $i;
                execute run {
                    $$exist ?= ::DB.Skills.$(name).Tasks[$(i)];
                } with ::temp.init;
            }
        } with ::temp.init;
    }

    len_array($len, DB.notEligible);
    for ($len = $len; $len > 0; $len--) {
        ::temp.eli.i = $len;
        execute run { $::temp.eli.id = ::DB.notEligible[$(i)]; } with ::temp.eli;
        execute run { $scoreboard objectives remove skills.noteligible.$(id); }  with ::temp.eli;
    }
    kill @e[type=chest_minecart, tag=skills.lib.gui];
    ::temp.del();
    ::DB.del();
    
}

function index_to_name() {
    // @Param: storage
    ::temp.index_to_name.index = skills.gui.index:@s;
    execute run { $::temp.index_to_name.name = ::DB.Indexes.$(index); } with ::temp.index_to_name;
    $::$(storage) = ::temp.index_to_name.name;
}

class Assert {
    function inventoryFull() {
        Text.tellraw(@p, "&<red, bold>Skills ♦ &<red>Inventory full! Free up some space."); playsound minecraft:entity.enderman.teleport ambient @p[tag=skills.pref.sound] ~ ~ ~ 1 1;
    }

    function notEnoughSP() {
        Text.tellraw(@p, "&<red, bold>Skills ♦ &<red>Not enough Skill Point to buy this."); playsound minecraft:entity.enderman.teleport ambient @p[tag=skills.pref.sound] ~ ~ ~ 1 1;
    }

    function upgradeMax() {
        Text.tellraw(@p, "&<red, bold>Skills ♦ &<red>You cannot upgrade this Talent anymore.");
        playsound entity.item.picked_up ambient @p[tag=skills.pref.sound] ~ ~ ~ 1 0;
    }
}

eligible_scores();

Config.Skills();
Config.Rewards();
Config.specialItems();
Config.Crate();

import "libs/gui.jmc";

import "src/DB.jmc";
import "src/gui.jmc";
import "src/Player.jmc";

Scoreboard.add(skills.__int__);


function __tick__() {
    kill @e[type=item,nbt={Item:{components:{"minecraft:custom_data":{skills_lib_gui:1b}}}}];
    execute as @a run {
        skills.lib.gui.Trigger.main();
        skills.lib.gui.construct.main();
    }
}
Schedule.5s();
Schedule.1s();
Schedule.1m();
Schedule.20s();

class Schedule {
    function 1s() {
        execute as @e[type=chest_minecart, tag=skills.lib.gui, scores={skills.lib.gui.page=5}] run GUI.loop.booster_state();

        schedule function Schedule.1s() 1s;
    }

    function 20s() {
        execute as @a run Player.20s();
        
        schedule function Schedule.20s() 20s;
    }
    function 5s() {
        execute as @a run Player.5s();

        schedule function Schedule.5s() 5s;
    }
    function 1m() {
        execute as @a run Player.1m();

        schedule function Schedule.1m() 60s;
    }
}

Player.firstJoin(()=>{
    tag @s add skills.pref.sound;
    tag @s add skills.pref.lvl_notif;
    tag @s add skills.pref.lvl_broadcast;
    tag @s add skills.pref.Xp_notif;
    tag @s add skills.pref.skill_prog;
    skills.booster.1.power:@s = 1;
    skills.booster.2.power:@s = 1;
    Hardcode.repeatList(
        "[name]",
        ()=>{
            tag @s add skills.ability.[name];
            skills.[name].Xp:@s = 0;
            skills.[name].prestige:@s = 0;
            skills.[name].lvl:@s = 1;
            skills.[name].XpToNext:@s = ::DB.Skills.[name].Xpstart;
        },
        #skillList
    );
    
});

for ($index = 0; $index < 7; $index++) {
    ::temp.init.index = $index;
    execute run { $::temp.init.name = ::DB.Indexes.$(index); } with ::temp.init;
    execute run {
        $scoreboard objectives add skills.$(name).prestige dummy;
        $scoreboard objectives add skills.$(name).Xp dummy;
        $scoreboard objectives add skills.$(name).lvl dummy;
        $scoreboard objectives add skills.$(name).XpToNext dummy;


        // Main tasks
        $i = 0;
        ::temp.init.i = $i;
        execute run {
            $$exist ?= ::DB.Skills.$(name).Tasks[$(i)];
        } with ::temp.init;

        while ($exist) {
            execute run { 
                $::temp.init.criteria = ::DB.Skills.$(name).Tasks[$(i)].criteria; 
                $::temp.init.task = ::DB.Skills.$(name).Tasks[$(i)].task; 
            } with ::temp.init;
            
            execute run {
                $scoreboard objectives add skills.$(name).task.$(task) $(criteria):$(task);
            } with ::temp.init;

            $i++;
            ::temp.init.i = $i;
            execute run {
                $$exist ?= ::DB.Skills.$(name).Tasks[$(i)];
            } with ::temp.init;
        }
    } with ::temp.init;
}

