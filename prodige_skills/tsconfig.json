{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": [
			"ESNext",
		],
		"types": [
			"node"
		],
		"strict": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"allowSyntheticDefaultImports": true,
		"noEmit": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"allowImportingTsExtensions": true,
		"paths": {
			"@src/menu/*": [
				"./src/menu/pages/*"
			],
			"@src/*": [
				"./src/*"
			],
			"@lib/*": [
				"./lib/*"
			]
		}
	},
	"include": [
		"sandstone.config.ts",
		"src"
	]
}