{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ESNext"
    ],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/skills/*": [
        "src/skills/*"
      ],
      "@/pages/*": [
        "src/menu/pages/*"
      ],
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "sandstone.config.ts",
    "src"
  ]
}