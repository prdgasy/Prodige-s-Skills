                    {"name": "Farming", "task": "nether_wart", "xp": 8, "item_repr": "nether_wart", "item_name": "Nether Wart", "criteria": "mined"},
                    {"name": "Farming", "task": "mooshroom", "xp": 8, "item_repr": "mushroom_stew", "item_name": "Mooshroom", "criteria": "killed"},
                    {"name": "Farming", "task": "glow_squid", "xp": 9, "item_repr": "glow_ink_sac", "item_name": "Glow Squid", "criteria": "killed"},
                    {"name": "Farming", "task": "strider", "xp": 10, "item_repr": "warped_fungus_on_a_stick", "item_name": "Strider", "criteria": "killed"}
                ],
                item: "netherite_hoe",
                desc1: "Harvest §6crops§r and tend",
                desc2: "to your farm for XP!",
                prestige: {
                    ability: "Blessed Harvest",
                    ability_desc1: "While harvesting, §6find rare and",
                    ability_desc2: "§6valuable §rfarm goods."
