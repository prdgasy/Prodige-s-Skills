Scoreboard.add(skills.gui.index);
Scoreboard.add(skills.gui.prog.page);
Scoreboard.add(skills.gui.tasks.page);
Scoreboard.add(skills.gui.booster.type);
Scoreboard.add(skills.gui.booster.power);
Scoreboard.add(skills.gui.shop.boost_state);
Scoreboard.add(skills.gui.booster.duration);

@lazy function preference_toggle(tag) {
    if (entity @p[ tag = skills.pref.$tag ]) {
        tag @p remove skills.pref.$tag;
    } else {
        tag @p add skills.pref.$tag;
    }
    playsound minecraft:entity.arrow.hit_player ambient @p[ tag = skills.pref.sound ] ~ ~ ~ 1 0;
}

class GUI {
    class loop {
        function booster_state() {
            skills.gui.shop.boost_state:@s++;
            skillsLIB.Logic.refresh();
        }
    }
    class Mask {
        function 1() {
            Hardcode.repeat(
                "[SLOT]",
                () => {
                    item replace entity @s container.[ SLOT ] with minecraft:purple_stained_glass_pane[
                        minecraft:hide_tooltip = { }, custom_data = { skills_lib_gui:1b }
                    ];
                },
                0, 27
            );
        }
        function 2() {
            Hardcode.repeat(
                "[SLOT]",
                () => {
                    item replace entity @s container.[ SLOT ] with minecraft:gray_stained_glass_pane[
                        minecraft:hide_tooltip = { }, custom_data = { skills_lib_gui:1b }
                    ];
                },
                0, 9
            );
            Hardcode.repeat(
                "[SLOT]",
                () => {
                    item replace entity @s container.[ SLOT ] with minecraft:black_stained_glass_pane[
                        minecraft:hide_tooltip = { }, custom_data = { skills_lib_gui:1b }
                    ];
                },
                9, 18
            );
            Hardcode.repeat(
                "[SLOT]",
                () => {
                    item replace entity @s container.[ SLOT ] with minecraft:gray_stained_glass_pane[
                        minecraft:hide_tooltip = { }, custom_data = { skills_lib_gui:1b }
                    ];
                },
                18, 27
            );
        }
        function 3() {
            Hardcode.repeat(
                "[SLOT]",
                () => {
                    item replace entity @s container.[ SLOT ] with minecraft:red_stained_glass_pane[
                        minecraft:hide_tooltip = { }, custom_data = { skills_lib_gui:1b }
                    ];
                },
                0, 27
            );
        }
    }

    class Click {
        function 1() {

            // Skill detect
            $slot = 11;
            for ($index = 0; $index < #lenSkills; $index++) {
                ::temp.gui.prog.slot = $slot;
                ::temp.gui.prog.index = $index;
                execute run {
                    $execute unless data entity @s Items[ { Slot:$(slot)b } ] run {
                        // Set prog page:
                        $scoreboard players set @s skills.gui.index $(index);
                        ::temp.gui.prog.index = skills.gui.index:@s;
                        execute run { $::temp.gui.prog.name = ::DB.Indexes.$(index); } with ::temp.gui.prog;
                        execute run { $scoreboard players operation $lvl skills.__variable__ = @p skills.$(name).lvl; } with ::temp.gui.prog;
                        if ($lvl <= 21) { skills.gui.prog.page:@s = 1; }
                        else if ($lvl <= 43) { skills.gui.prog.page:@s = 2; }
                        else if ($lvl <= 65) { skills.gui.prog.page:@s = 3; }
                        else if ($lvl <= 87) { skills.gui.prog.page:@s = 4; }
                        else if ($lvl <= 100) { skills.gui.prog.page:@s = 5; }


                        skillsLIB.Logic.switch_page(2);
                        $index = #lenSkills; // <= Break loop
                    } with ::temp.gui.prog;

                } with ::temp.gui.prog;
                $slot++;
            }
            if (!data entity @s Items[ { Slot:4b } ]) {
                skillsLIB.Logic.switch_page(4);
            } else if (!data entity @s Items[ { Slot:8b } ]) {
                skillsLIB.Logic.switch_page(6);
            } else if (!data entity @s Items[ { Slot:22b } ]) {
                skills.gui.booster.type:@s = 1;
                skills.gui.booster.power:@s = 1;
                skills.gui.booster.duration:@s = 1;

                playsound minecraft:block.amethyst_block.place ambient @p[ tag = skills.pref.sound ] ~ ~ ~ 1 0;
                skillsLIB.Logic.switch_page(5);
            } else if (!data entity @s Items[ { Slot:26b } ]) {
                tellraw @p [ "", { "text":"Skills \u2666 ", "bold":true, "color":"#4593cd", "clickEvent":{ "action":"open_url", "value":"https://discord.gg/b2hkD4Fn43" } }, { "text":"Click ", "color":"#4593cd", "clickEvent":{ "action":"open_url", "value":"https://discord.gg/b2hkD4Fn43" } }, { "text":"here", "bold":true, "underlined":true, "color":"#4593cd", "clickEvent":{ "action":"open_url", "value":"https://discord.gg/b2hkD4Fn43" } }, { "text":" to join the ", "color":"#4593cd", "clickEvent":{ "action":"open_url", "value":"https://discord.gg/b2hkD4Fn43" } }, { "text":"Discord", "bold":true, "color":"#4593cd", "clickEvent":{ "action":"open_url", "value":"https://discord.gg/b2hkD4Fn43" } }, { "text":"!", "color":"#4593cd", "clickEvent":{ "action":"open_url", "value":"https://discord.gg/b2hkD4Fn43" } } ];
                skillsLIB.construct.close();
            } else if (!data entity @s Items[ { Slot:21b } ]) {
                playsound minecraft:block.ender_chest.open ambient @p[ tag = skills.pref.sound ] ~ ~ ~ 1 0;
                skillsLIB.Logic.switch_page(7);
            } else if (!data entity @s Items[ { Slot:23b } ]) {
                skillsLIB.construct.close();
            }

            skillsLIB.Logic.refresh();
        }

        function 2() {
            if (!data entity @s Items[ { Slot:0b } ]) {
                skillsLIB.Logic.switch_page(1);
            } else if (!data entity @s Items[ { Slot:9b } ]) {
                playsound minecraft:block.ender_chest.open ambient @p[ tag = skills.pref.sound ] ~ ~ ~ 1 0;
                skillsLIB.Logic.switch_page(7);
            } else if (!data entity @s Items[ { Slot:17b } ]) {
                skills.gui.tasks.page:@s = 0;
                skillsLIB.Logic.switch_page(3);
            } else if (!data entity @s Items[ { Slot:18b } ]) {
                GUI.prog.ability_switch();
            } else {
                // Levels
                ::temp.gui.prog.index = skills.gui.index:@s;
                execute run { $::temp.gui.prog.name = ::DB.Indexes.$(index); } with ::temp.gui.prog;

                // Get data
                execute run {
                    $::temp.gui.prog.data = ::DB.Skills.$(name);
                } with ::temp.gui.prog;

                switch(skills.gui.prog.page:@s) {
                    case 1: $lvlstart = 1; $lvlend = 21;
                    case 2: $lvlstart = 22; $lvlend = 43;
                    case 3: $lvlstart = 44; $lvlend = 65;
                    case 4: $lvlstart = 66; $lvlend = 87;
                    case 5: $lvlstart = 88; $lvlend = 100;
                }

                Hardcode.repeatLists(
                    [ "[start]", "[end]" ],
                    () => {
                        for ($slot = [ start ]; $slot < [ end ]; $slot++) {
                            if ($lvlstart > 100) { return 0; }
                            ::temp.gui.prog.data.slot = $slot;
                            ::temp.gui.prog.data.lvl = $lvlstart;
                            roman_conv(lvl, temp.gui.prog.data);
                            // Claimed ?
                            ::temp.gui.prog.data.lvl_id = $lvlstart;
                            $claimed = false;
                            execute run {
                                $execute if entity @p[ tag = !skills.claimed.$(name).$(lvl_id) ] run { $claimed = true; }
                            } with ::temp.gui.prog.data;

                            // Set rewards
                            $mod = $lvlstart;
                            $mod %= 10;

                            if ($mod == 0) {
                                ::temp.gui.prog.data.command = ::DB.Rewards.3.command;
                                ::temp.gui.prog.data.point = ::DB.Rewards.3.point;
                                ::temp.gui.prog.data.show = ::DB.Rewards.3.show;
                            }
                            else if ($mod == 6 || $mod == 2) {
                                ::temp.gui.prog.data.command = ::DB.Rewards.2.command;
                                ::temp.gui.prog.data.point = ::DB.Rewards.2.point;
                                ::temp.gui.prog.data.show = ::DB.Rewards.2.show;
                            }
                            else {
                                ::temp.gui.prog.data.command = ::DB.Rewards.1.command;
                                ::temp.gui.prog.data.point = ::DB.Rewards.1.point;
                                ::temp.gui.prog.data.show = ::DB.Rewards.1.show;
                            }

                            GUI.Macro.click_prog() with ::temp.gui.prog.data;
                            $lvlstart++;
                        }
                    },
                    [ ["1", "10", "19" ], [ "8", "17", "26" ]]
                );
            }
            // First page, no next button
            if (skills.gui.prog.page:@s < 5 && !data entity @s Items[ { Slot:26b } ]) {
                skills.gui.prog.page:@s++;
                skillsLIB.Logic.click_event();
            }
            // Last page, no prev button
            else if (skills.gui.prog.page:@s > 1 && !data entity @s Items[ { Slot:8b } ]) {
                skills.gui.prog.page:@s--;
                skillsLIB.Logic.click_event();
            }

            skillsLIB.Logic.refresh();
        }

        function 3() {
            if (!data entity @s Items[ { Slot:0b } ]) {
                skillsLIB.Logic.switch_page(2);
            } else if (!data entity @s Items[ { Slot:18b } ]) {
                skillsLIB.construct.close();
            }

            // First page, no next button
            if (skills.gui.tasks.page:@s < $page_number && !data entity @s Items[ { Slot:26b } ]) {
                skills.gui.tasks.page:@s++;
                skillsLIB.Logic.click_event();
            }
            // Last page, no prev button
            else if (skills.gui.tasks.page:@s > 0 && !data entity @s Items[ { Slot:8b } ]) {
                skills.gui.tasks.page:@s--;
                skillsLIB.Logic.click_event();
            }

            skillsLIB.Logic.refresh();
        }

        function 4() {
            if (!data entity @s Items[ { Slot:21b } ]) {
                skillsLIB.Logic.switch_page(1);
            } else if (!data entity @s Items[ { Slot:11b } ]) {
                preference_toggle(lvl_broadcast);
            } else if (!data entity @s Items[ { Slot:12b } ]) {
                preference_toggle(xp_notif);
            } else if (!data entity @s Items[ { Slot:13b } ]) {
                preference_toggle(lvl_notif);
            } else if (!data entity @s Items[ { Slot:14b } ]) {
                preference_toggle(sound);
            } else if (!data entity @s Items[ { Slot:15b } ]) {
                preference_toggle(skill_prog);
            } else if (!data entity @s Items[ { Slot:23b } ]) {
                skillsLIB.construct.close();
            }
            skillsLIB.Logic.refresh();
        }

        function 5() {
            if (!data entity @s Items[ { Slot:21b } ]) {
                skillsLIB.Logic.switch_page(1);
            } else if (!data entity @s Items[ { Slot:11b } ]) { // Tools
            playsound minecraft:item.armor.equip_iron ambient @p[ tag = skills.pref.sound ] ~ ~ ~ 2 1;
            skillsLIB.Logic.switch_page(8);
        } else if (!data entity @s Items[ { Slot:13b } ]) { // Crate
        Player.Crate.open();
    } else if (!data entity @s Items[ { Slot:15b } ]) { // Boosters
    playsound minecraft:item.bottle.fill ambient @p[ tag = skills.pref.sound ] ~ ~ ~ 2 1;
    skillsLIB.Logic.switch_page(9);
} else if (!data entity @s Items[ { Slot:23b } ]) {
    skillsLIB.construct.close();
}

skillsLIB.Logic.refresh();
}

function 6() {
    if (!data entity @s Items[ { Slot:21b } ]) {
        skillsLIB.Logic.switch_page(1);
    } else if (!data entity @s Items[ { Slot:11b } ]) {
        tellraw @p [ "", { "text":"\nSkills Config \u2666 Editing Rewards", "bold":true, "color":"yellow" }, { "text":"\n" }, { "text":"\u25ba Open the file: ", "color":"white" }, { "text":"Prodige's Skills\\data\\prodiges_skills\\function\\config\\rewards", "color":"light_purple" }, { "text":"\n\n" }, { "text":"\u25ba Replace the", "color":"white" }, { "text":" /function ...", "color":"light_purple" }, { "text":" commands with the function you want to execute when a player levels up.", "color":"white" }, { "text":"\n\n" }, { "text":"\u25ba Save the file and reload with ", "color":"white" }, { "text":"/reload", "color":"light_purple" }, { "text":".", "color":"white" } ];
        skillsLIB.Logic.click_event();
    } else if (!data entity @s Items[ { Slot:12b } ]) {
        tellraw @p [ "", { "text":"\n" }, { "text":"Skills Config \u2666 Editing XP from Tasks", "bold":true, "color":"yellow" }, { "text":"\n\u25ba Open the file: " }, { "text":"Prodige's Skills\\data\\prodiges_skills\\function\\config\\skills.mcfunction", "color":"light_purple" }, { "text":"\n You\u2019ll see a structure like this:\n" }, { "text":"...", "color":"gray" }, { "text":"\n" }, { "text":"Mining", "color":"white" }, { "text":": " }, { "text":"{", "color":"gold" }, { "text":"\n    " }, { "text":"...", "color":"gray" }, { "text":",\n    " }, { "text":"Tasks", "color":"light_purple" }, { "text":": " }, { "text":"[", "color":"blue" }, { "text":"\n        " }, { "text":"{", "color":"aqua" }, { "text":"..., task: \"stone\",", "color":"gray" }, { "text":" xp", "color":"green" }, { "text":": 1" }, { "text":", ...", "color":"gray" }, { "text":"}", "color":"aqua" }, { "text":",\n        " }, { "text":"...", "color":"gray" }, { "text":"\n    " }, { "text":"]", "color":"blue" }, { "text":",\n    " }, { "text":"...", "color":"gray" }, { "text":".\n" }, { "text":"}", "color":"gold" }, { "text":"\n" }, { "text":"...", "color":"gray" }, { "text":"\n\u25ba In the " }, { "text":"Tasks", "color":"light_purple" }, { "text":" list, modify the " }, { "text":"xp", "color":"green" }, { "text":" key to the value you want for each task.\n\u25ba Save the file and reload with " }, { "text":"/reload", "color":"light_purple" }, { "text":".\n " } ];
        skillsLIB.Logic.click_event();
    } else if (!data entity @s Items[ { Slot:13b } ]) {
        tellraw @p [ "", { "text":"\n" }, { "text":"Skills Config \u2666 Editing Points per Task", "bold":true, "color":"yellow" }, { "text":"\n\u25ba Open the file: " }, { "text":"Prodige's Skills\\data\\prodiges_skills\\function\\config\\points.mcfunction", "color":"light_purple" }, { "text":"\n\n" }, { "text":"execute store result score $skills.point skills.__variable__ run random ", "italic":true, "color":"gray" }, { "text":"roll", "italic":true, "color":"gold" }, { "text":" 1", "italic":true, "color":"gold" }, { "text":"..", "italic":true, "color":"gray" }, { "text":"5", "italic":true, "color":"gold" }, { "text":"\n\n\u25ba Modify the values of the " }, { "text":"roll", "color":"gold" }, { "text":", which represent the " }, { "text":"minimum", "color":"gold" }, { "text":" and " }, { "text":"maximum", "color":"gold" }, { "text":" points you can earn.\n\n\u25ba Save the file and reload with " }, { "text":"/reload", "color":"light_purple" }, { "text":"." } ];
        skillsLIB.Logic.click_event();
    } else if (!data entity @s Items[ { Slot:14b } ]) {
        tellraw @p [ "", { "text":"\n" }, { "text":"Skills Config \u2666 Adding Tasks", "bold":true, "color":"yellow" }, { "text":"\n\u25ba Open the file: " }, { "text":"Prodige's Skills\\data\\prodiges_skills\\function\\config\\skills.mcfunction", "color":"light_purple" }, { "text":"\n\n\u25ba Find the " }, { "text":"Tasks", "color":"light_purple" }, { "text":" list, and add a new task like this:\n" }, { "text":"{ name: \"Mining\", task: \"end_stone\", xp: 15, item_repr: \"end_stone\", item_name: \"End Stone\", criteria: \"mined\" }", "color":"gold" }, { "text":"\n\n\u25ba To remove a task, simply delete the corresponding dictionary.\n\n\u25ba Save the file and reload with " }, { "text":"/reload", "color":"light_purple" }, { "text":"." } ];
        skillsLIB.Logic.click_event();
    } else if (!data entity @s Items[ { Slot:15b } ]) {
        Text.tellraw(@p, "&<yellow, bold>Skills ♦ &<yellow>Everyone's skills were reset.");
        advancement revoke @a only prodiges_skills:__private__/player_first_join;
        skillsLIB.Logic.click_event();
    } else if (!data entity @s Items[ { Slot:23b } ]) {
        skillsLIB.construct.close();
    }
    skillsLIB.Logic.refresh();
}

function 7() {
    $slot = 11;
    for ($index = 0; $index < #lenSkills; $index++) {
        ::temp.gui.prestige.slot = $slot;
        ::temp.gui.prestige.index = $index;
        execute run {
            $execute unless data entity @s Items[ { Slot:$(slot)b } ] run {
                ::temp.gui.prestige.index = $index;
                execute run { $::temp.gui.prestige.name = ::DB.Indexes.$(index); } with ::temp.gui.prestige;

                GUI.Prestige.Click() with ::temp.gui.prestige;

                $index = #lenSkills; // <= Break loop
            } with ::temp.gui.prestige;

        } with ::temp.gui.prestige;
        $slot++;
    }
    if (!data entity @s Items[ { Slot:21b } ]) {
        skillsLIB.Logic.switch_page(1);
    } else if (!data entity @s Items[ { Slot:23b } ]) {
        skillsLIB.construct.close();
    }
    skillsLIB.Logic.refresh();
}

function 8() {
    GUI.Items.click();
    if (!data entity @s Items[ { Slot:0b } ]) {
        skillsLIB.Logic.switch_page(5);
    } else if (!data entity @s Items[ { Slot:18b } ]) {
        skillsLIB.construct.close();
    }

    skillsLIB.Logic.refresh();
}

function 9() {
    if (!data entity @s Items[ { Slot:21b } ]) {
        skillsLIB.Logic.switch_page(5);
    } else if (!data entity @s Items[ { Slot:23b } ]) {
        skillsLIB.construct.close();
    }
    GUI.Boosters.click();
    skillsLIB.Logic.refresh();
}
}

class Macro {
    function click_prog() {
        $execute unless data entity @s Items[ { Slot:$(slot)b } ] run {
            $scoreboard players operation $lvl skills.__variable__ = @p skills.$(name).lvl;

            if ($lvl < $lvlstart) {
                Text.tellraw(@p, "&<red, bold>Skills ♦ &<red>You cannot claim this reward yet.");
                execute at @p run playsound minecraft:entity.enderman.teleport ambient @p[ tag = skills.pref.sound ] ~ ~ ~ 1 1;
            } else if ($lvl > $lvlstart && $claimed) {
                Text.tellraw(@p, "&<red, bold>Skills ♦ &<red>You already claimed this reward.");
                execute at @p run playsound minecraft:entity.enderman.teleport ambient @p[ tag = skills.pref.sound ] ~ ~ ~ 1 1;
            } else if ($lvl > $lvlstart && !$claimed) {
                execute run {
                    $tag @p remove skills.claimed.$(name).$(lvl_id);
                    $Text.tellraw(@p, "&<green, bold>Skills ♦ &<green>You have claimed &<light_purple>$(name) &<dark_purple, bold>$(lvl)&<green>!");
                    $$(command);
                    $Text.tellraw(@p, " &<dark_gray>- $(show)");
                    $Text.tellraw(@p, " &<dark_gray>- &<gold>+$(point) Skill Points (SP)");
                    execute at @p run playsound minecraft:entity.arrow.hit_player ambient @p[ tag = skills.pref.sound ] ~ ~ ~ 1 2;
                } with ::temp.gui.prog.data;
            } else if ($lvl == 100 && $lvlstart == 100) {
                playsound minecraft:block.ender_chest.open ambient @p[ tag = skills.pref.sound ] ~ ~ ~ 1 0;
                skillsLIB.Logic.switch_page(7);
            } else {
                execute run {
                    $Text.tellraw(@p, "&<yellow, bold>Skills ♦ &<gold>$(name) $(lvl) &<yellow>is still in progress.");
                } with ::temp.gui.prog.data;
            }
        } with ::temp.gui.prog.data;

    }

    function set() {
        $item replace entity @s container.$(slot) with $(item)[
            custom_data = { skills_lib_gui:1b }, custom_name = '["",{"text":"$(name) ","italic":false,"color":"#A888B5"},{"text":"$(lvl)","italic":false,"color":"#EFB6C8","bold":true}]',
            lore = [
                '[{"text":"Level $(lvl_int)","italic":false,"color":"blue"}]',
                '["",{"text":"$(desc1)  ","italic":false,"color":"white"}]',
                '["",{"text":"$(desc2) ","italic":false,"color":"white"},{"text":" ","italic":false}]',
                '[""]',
                '["",{"text":"Progress to ","italic":false,"color":"gray"},{"text":"$(name) ","italic":false,"color":"yellow"},{"text":"$(nextLvl)","italic":false,"color":"yellow","bold":true},{"text":":","italic":false,"color":"gray"},{"text":" ","italic":false},{"text":"$(100ratio)%","italic":false,"color":"gray"}]',
                '["",{"text":" ","italic":false,"color":"gray"},{"text":"$(bar)","italic":false,"color":"white"},{"text":" ","italic":false,"color":"gray"},{"text":"$(xp)","italic":false,"color":"#efb6c8"},{"text":"/","italic":false,"color":"#a888b5"},{"text":"$(xpToNext)","italic":false,"color":"#efb6c8"}]',
                '[""]',
                '["",{"text":"♦","italic":false,"bold":true,"color":"dark_gray"},{"text":" ","italic":false},{"text":"Prestige:","italic":false,"color":"#a888b5"},{"text":" ","italic":false},{"text":"$(name) §8§l♦ §8[§c§l$(prestige_lvl)§8]","italic":false,"color":"#efb6c8"}]',
                '[""]',
                '["",{"text":"♦","italic":false,"bold":true,"color":"dark_gray"},{"text":" ","italic":false},{"text":"Ability:","italic":false,"color":"#a888b5"},{"text":" ","italic":false},{"text":"§l$(ability)","italic":false,"color":"#efb6c8"}]',
                '["",{"text":"  ","italic":false},{"text":"$(ability_desc1)  ","italic":false,"color":"#efb6c8"}]',
                '["",{"text":"  $(ability_desc2)","italic":false,"color":"#efb6c8"}]',
                '["",{"text":"  ","italic":false,"color":"yellow","bold":true},{"text":"→","italic":false,"bold":true,"color":"dark_gray"},{"text":" $(power)%","italic":false,"bold":true,"color":"red"}]',
                '[""]',
                '["",{"text":"Click to view!","italic":false,"color":"yellow"}]'
            ], !minecraft:attribute_modifiers ];
        }

        function set_max() {
            $item replace entity @s container.$(slot) with $(item)[
                custom_data = { skills_lib_gui:1b }, custom_name = '["",{"text":"$(name) ","italic":false,"color":"#A888B5"},{"text":"$(lvl)","italic":false,"color":"#EFB6C8","bold":true}]',
                lore = [
                    '[{"text":"Level $(lvl_int)","italic":false,"color":"blue"}]',
                    '["",{"text":"$(desc1)  ","italic":false,"color":"white"}]',
                    '["",{"text":"$(desc2) ","italic":false,"color":"white"},{"text":" ","italic":false}]',
                    '[""]',
                    '["",{"text":"♦","italic":false,"bold":true,"color":"dark_gray"},{"text":" ","italic":false},{"text":"Prestige:","italic":false,"color":"#a888b5"},{"text":" ","italic":false},{"text":"$(name) §8§l♦ §8[§c§l$(prestige_lvl)§8]","italic":false,"color":"#efb6c8"}]',
                    '[""]',
                    '["",{"text":"♦","italic":false,"bold":true,"color":"dark_gray"},{"text":" ","italic":false},{"text":"Ability:","italic":false,"color":"#a888b5"},{"text":" ","italic":false},{"text":"§l$(ability)","italic":false,"color":"#efb6c8"}]',
                    '["",{"text":"  ","italic":false},{"text":"$(ability_desc1)  ","italic":false,"color":"#efb6c8"}]',
                    '["",{"text":"  $(ability_desc2)","italic":false,"color":"#efb6c8"}]',
                    '["",{"text":"  ","italic":false,"color":"yellow","bold":true},{"text":"→","italic":false,"bold":true,"color":"dark_gray"},{"text":" $(power)%","italic":false,"bold":true,"color":"red"}]',
                    '[""]',
                    '["",{"text":"Click to view!","italic":false,"color":"yellow"}]'
                ], !minecraft:attribute_modifiers, enchantment_glint_override = true ];
            }

            function prestige_set() {
                $item replace entity @s container.$(slot) with $(item)[
                    custom_data = { skills_lib_gui:1b },
                    custom_name = '[{"text":"$(name) ","italic":false,"color":"$(color_1)"}, {"text":"$(lvl) §8§l♦ ","italic":false,"color":"$(color_2)","bold":true}, {"text":"[","color":"dark_gray"},{"text":"$(prestige_lvl)","bold":true,"color":"red"},{"text":"]","color":"dark_gray"}]',
                    lore = [
                        '[{"text":"Level $(lvl_int)","italic":false,"color":"blue"}]',
                        '[{"text":"$(desc1) ","italic":false,"color":"white"}]',
                        '[{"text":"$(desc2) ","italic":false,"color":"white"}]',

                        '[""]',
                        '["",{"text":"♦","italic":false,"bold":true,"color":"dark_gray"},{"text":" ","italic":false},{"text":"Prestige:","italic":false,"color":"#a888b5"},{"text":" ","italic":false},{"text":"$(name) §8§l♦ §8[§c§l$(prestige_lvl)§8]","italic":false,"color":"#efb6c8"}]',
                        '[""]',
                        '["",{"text":"♦","italic":false,"bold":true,"color":"dark_gray"},{"text":" ","italic":false},{"text":"Ability:","italic":false,"color":"#a888b5"},{"text":" ","italic":false},{"text":"§l$(ability)","italic":false,"color":"#efb6c8"}]',
                        '["",{"text":"  ","italic":false},{"text":"$(ability_desc1)  ","italic":false,"color":"#efb6c8"}]',
                        '["",{"text":"  $(ability_desc2)","italic":false,"color":"#efb6c8"}]',
                        '[{"text":"→ ","italic":false,"bold":true,"color":"dark_gray"}, {"text":"$(power)% ","italic":false,"bold":false,"color":"red"}]',
                        '[{"text":"→ ","italic":false,"bold":true,"color":"dark_gray"}, {"text":"§l+$(power_next)% §rat next Prestige","bold":false,"italic":false,"color":"aqua"}]',

                        '[""]',
                        '[{"text":"Click to Prestige!","italic":false,"color":"$(color_1)"}]'
                    ],

                    !minecraft:attribute_modifiers,
                    enchantment_glint_override = $(glint)
                ];
            }

            function prestige_set_max() {
                $item replace entity @s container.$(slot) with $(item)[
                    custom_data = { skills_lib_gui:1b },
                    custom_name = '[{"text":"$(name) ","italic":false,"color":"$(color_1)"}, {"text":"$(lvl) §8§l♦ ","italic":false,"color":"$(color_2)","bold":true}, {"text":"[","color":"dark_gray"},{"text":"$(prestige_lvl)","bold":true,"color":"red"},{"text":"]","color":"dark_gray"}]',
                    lore = [
                        '[{"text":"Level $(lvl_int)","italic":false,"color":"blue"}]',
                        '[{"text":"$(desc1) ","italic":false,"color":"white"}]',
                        '[{"text":"$(desc2) ","italic":false,"color":"white"}]',

                        '[""]',
                        '["",{"text":"♦","italic":false,"bold":true,"color":"dark_gray"},{"text":" ","italic":false},{"text":"Prestige:","italic":false,"color":"#a888b5"},{"text":" ","italic":false},{"text":"$(name) §8§l♦ §8[§c§l$(prestige_lvl)§8]","italic":false,"color":"#efb6c8"}]',
                        '[""]',
                        '["",{"text":"♦","italic":false,"bold":true,"color":"dark_gray"},{"text":" ","italic":false},{"text":"Ability:","italic":false,"color":"#a888b5"},{"text":" ","italic":false},{"text":"§l$(ability)","italic":false,"color":"#efb6c8"}]',
                        '["",{"text":"  ","italic":false},{"text":"$(ability_desc1)  ","italic":false,"color":"#efb6c8"}]',
                        '["",{"text":"  $(ability_desc2)","italic":false,"color":"#efb6c8"}]',
                        '[{"text":"→ ","italic":false,"bold":true,"color":"dark_gray"}, {"text":"$(power)% ","italic":false,"bold":false,"color":"red"}]'
                    ],

                    !minecraft:attribute_modifiers
                ];
            }
        }

        class setItem {
            function 1() { // Main
            GUI.Mask.2();
            // presitge
            item replace entity @s container.21 with netherite_scrap[ custom_data = { skills_lib_gui:1b }, custom_name = '["",{"text":"Prestiges","italic":false,"color":"dark_purple"}]', lore = [ '[{"text":"Once you reach ","italic":false,"color":"white"},{"text":"level","italic":false,"color":"gold"},{"text":" ","italic":false,"color":"white"},{"text":"100","italic":false},{"text":" (C) in a","italic":false,"color":"white"}]', '["",{"text":"skill, you can reset it to gain","italic":false,"color":"white"}]', '["",{"text":"a ","italic":false,"color":"white"},{"text":"permanent bonus","italic":false,"color":"green"},{"text":"!","italic":false,"color":"white"}]', '[{"text":"Grow even stronger over time!","italic":false,"color":"gray"}]', '[""]', '[{"text":"Click to view!","color":"yellow","italic":false}]' ], enchantment_glint_override = true ];
            // close
            item replace entity @s container.23 with barrier[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"Close","color":"red","italic":false}' ];
            // Config Panel
            if (entity @p[ tag = global.admin ]) {
                item replace entity @s container.8 with command_block[ custom_data = { skills_lib_gui:1b }, custom_name = '["",{"text":"Configuration Panel","italic":false,"color":"red"}]', lore = [ '["",{"text":"Modify all server-wide settings","italic":false,"color":"white"}]', '["",{"text":"here.","italic":false,"color":"white"}]', '[""]', '["",{"text":"Click to view!","italic":false,"color":"yellow"}]' ]];
            }

            // Shop
            item replace entity @s container.22 with player_head[ profile = { id:[ I; 1434832075, -102998962, -1229628019, 1369636598 ], properties:[ { name:"textures", value:"eyJ0ZXh0dXJlcyI6eyJTS0lOIjp7InVybCI6Imh0dHA6Ly90ZXh0dXJlcy5taW5lY3JhZnQubmV0L3RleHR1cmUvNTRjZGZiODhjZjhjMzY1NjMwNDI1NGU0ZDY3YTBhYjAyZjZkMjdjNzlmMWIxZTQwNGRjM2E3Y2U0ZWIyZGUwMCJ9fX0=" } ] }, custom_data = { skills_lib_gui:1b }, custom_name = '["",{"text":"Shop","italic":false,"color":"green"}]', lore = [ '["",{"text":"Buy ","italic":false,"color":"white"},{"text":"boosters","italic":false,"color":"gold"},{"text":", ","italic":false,"color":"white"},{"text":"XP","italic":false,"color":"gold"},{"text":", ","italic":false,"color":"white"},{"text":"prestige","italic":false,"color":"gold"},{"text":", and","italic":false,"color":"white"}]', '["",{"text":"more! Unlock exclusive perks to","italic":false,"color":"white"}]', '["",{"text":"enhance your gameplay experience!","italic":false,"color":"white"}]', '[""]', '["",{"text":"Click to view!","italic":false,"color":"yellow"}]' ]];
            // Discord
            item replace entity @s container.26 with player_head[ profile = { id:[ I; -566027055, -1373812234, -1824937619, -1364409557 ], properties:[ { name:"textures", value:"eyJ0ZXh0dXJlcyI6eyJTS0lOIjp7InVybCI6Imh0dHA6Ly90ZXh0dXJlcy5taW5lY3JhZnQubmV0L3RleHR1cmUvNzg3M2MxMmJmZmI1MjUxYTBiODhkNWFlNzVjNzI0N2NiMzlhNzVmZjFhODFjYmU0YzhhMzliMzExZGRlZGEifX19" } ] }, custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"Join the discord","color":"blue","italic":false}', lore = [ '[{"text":"Need help ?","color":"white","italic":false}]', '[""]', '[{"text":"Click to join the discord!","color":"yellow","italic":false}]' ]];

            // Profile & Preferences
            ::temp.gui.profile.sp = skills.player.sp:@p;

            ::temp.gui.profile.booster_xp = "§c-";
            $xp_duration = skills.booster.1.duration:@p;
            if ($xp_duration > 1) {
                ::temp.gui.profile.booster_xp_duration = $xp_duration;
                ::temp.gui.profile.booster_xp_power = skills.booster.1.power:@p;

                execute run {
                    $::temp.gui.profile.booster_xp = "§bx$(booster_xp_power) XP Booster §7- $(booster_xp_duration) minute(s) left";
                } with ::temp.gui.profile;
            }

            ::temp.gui.profile.booster_sp = "§c-";
            $sp_duration = skills.booster.2.duration:@p;
            if ($sp_duration > 1) {
                ::temp.gui.profile.booster_sp_duration = $sp_duration;
                ::temp.gui.profile.booster_sp_power = skills.booster.2.power:@p;

                execute run {
                    $::temp.gui.profile.booster_sp = "§6x$(booster_sp_power) Skill Point Booster §7- $(booster_sp_duration) minute(s) left";
                } with ::temp.gui.profile;
            }

            execute run {
                JMC.put('$execute as @p run loot replace entity @n[type=chest_minecart, tag=skillsLIB] container.4 loot {"type":"minecraft:command","pools":[{"rolls":1,"entries":[{"type":"minecraft:item","name":"minecraft:player_head","functions":[{"function":"minecraft:set_name","entity":"this","target":"custom_name","name":{"text":"Profile","color":"light_purple","italic":false}},{"function":"minecraft:fill_player_head","entity":"this"},{"function":"minecraft:set_custom_data","tag":"{skills_lib_gui:1b}"},{"function":"minecraft:set_lore","entity":"this","lore":[{"text":""},{"text":"§8§l♦ §rPoints: ","type":"text","extra":[{"text":"$(sp) SP","type":"text","color":"gold","italic":false}],"color":"#A888B5","italic":false},{"text":""},{"text":"Active Boosters:","color":"yellow","italic":false},{"text":"§8• $(booster_xp)","italic":false},{"text":"§8• $(booster_sp)","italic":false},{"text":""},{"text":"Click to view!","color":"yellow","italic":false}],"mode":"append"}],"conditions":[]}]}]}');
            } with ::temp.gui.profile;

            // Skills
            $slot = 11;
            for ($index = 0; $index < #lenSkills; $index++) {
                ::temp.init.index = $index;
                execute run { $::temp.init.name = ::DB.Indexes.$(index); } with ::temp.init;
                execute run {
                    ::temp.gui.profile.slot = $slot;
                    // Get inf
                    $::temp.gui.profile.name = ::DB.Skills.$(name).name;
                    $::temp.gui.profile.item = ::DB.Skills.$(name).item;
                    $::temp.gui.profile.desc1 = ::DB.Skills.$(name).desc1;
                    $::temp.gui.profile.desc2 = ::DB.Skills.$(name).desc2;

                    $::temp.gui.profile.ability_desc1 = ::DB.Skills.$(name).prestige.ability_desc1;
                    $::temp.gui.profile.ability_desc2 = ::DB.Skills.$(name).prestige.ability_desc2;
                    $::temp.gui.profile.ability = ::DB.Skills.$(name).prestige.ability;

                    $scoreboard players operation $prestige skills.__variable__ = @p skills.$(name).prestige;
                    ::temp.gui.profile.prestige_lvl = $prestige;
                    roman_conv(prestige_lvl, temp.gui.profile);

                    $prestige *= 5;
                    ::temp.gui.profile.power = $prestige;

                    // Get scores
                    $scoreboard players operation $x skills.__variable__ = @p skills.$(name).xp;
                    $scoreboard players operation $y skills.__variable__ = @p skills.$(name).xpToNext;
                    $scoreboard players operation $lvl skills.__variable__ = @p skills.$(name).lvl;
                    $nextLvl = $lvl;
                    $nextLvl += 1;

                    ::temp.gui.profile.xp = $x;
                    ::temp.gui.profile.xpToNext = $y;
                    ::temp.gui.profile.lvl_int = $lvl;
                    ::temp.gui.profile.lvl = $lvl;
                    ::temp.gui.profile.nextLvl = $nextLvl;
                    roman_conv(lvl, temp.gui.profile);
                    roman_conv(nextLvl, temp.gui.profile);
                    $100ratio = $x;
                    $10ratio = $x;

                    $100ratio *= 100;
                    $100ratio /= $y;
                    $10ratio *= 15;
                    $10ratio /= $y;


                    ::temp.gui.profile.100ratio = $100ratio;
                    ::temp.gui.profile.10ratio = $10ratio;

                    if ($lvl < 100) {
                        execute run { $::temp.gui.profile.bar = ::DB.Progress.$(10ratio); } with ::temp.gui.profile;
                        GUI.Macro.set() with ::temp.gui.profile;
                    } else {
                        GUI.Macro.set_max() with ::temp.gui.profile;
                    }


                } with ::temp.init;
                $slot++;
            }
        }

        function 2() {
            // Progress

            GUI.Mask.2();

            item replace entity @s container.0 with arrow[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"Go Back","color":"gray","italic":false}' ];


            ::temp.gui.prog.index = skills.gui.index:@s;
            execute run { $::temp.gui.prog.name = ::DB.Indexes.$(index); } with ::temp.gui.prog;


            // Get data
            execute run {
                $::temp.gui.prog.data = ::DB.Skills.$(name);
            } with ::temp.gui.prog;
            execute run {
                // Get scores
                $scoreboard players operation $x skills.__variable__ = @p skills.$(name).xp;
                $scoreboard players operation $y skills.__variable__ = @p skills.$(name).xpToNext;
                $scoreboard players operation $lvl skills.__variable__ = @p skills.$(name).lvl;
                $nextLvl = $lvl;
                $nextLvl += 1;

                ::temp.gui.prog.data.xp = $x;
                ::temp.gui.prog.data.xpToNext = $y;
                ::temp.gui.prog.data.lvl = $lvl;
                ::temp.gui.prog.data.nextLvl = $nextLvl;
                roman_conv(lvl, temp.gui.prog.data);
                roman_conv(nextLvl, temp.gui.prog.data);
                $100ratio = $x;
                $10ratio = $x;

                $100ratio *= 100;
                $100ratio /= $y;
                $10ratio *= 15;
                $10ratio /= $y;

                ::temp.gui.prog.data.100ratio = $100ratio;
                ::temp.gui.prog.data.10ratio = $10ratio;

                execute run { $::temp.gui.prog.data.bar = ::DB.Progress.$(10ratio); } with ::temp.gui.prog.data;
                if ($10ratio > 15) { ::temp.gui.prog.data.bar = ::DB.Progress.15; }
            } with ::temp.gui.prog;
            execute run {
                $item replace entity @s container.9 with $(item)[ custom_data = { skills_lib_gui:1b }, custom_name = '["",{"text":"🏆","italic":false,"bold":true,"color":"yellow"},{"text":" ","italic":false},{"text":"Prestige Your Skill!","italic":false,"color":"yellow","bold":false}]', lore = [ '["",{"text":"Once you reach ","italic":false,"color":"white"},{"text":"Level","italic":false,"color":"light_purple"},{"text":" ","italic":false,"color":"white"},{"text":"C ","italic":false,"color":"dark_purple"},{"text":"(100","italic":false,"color":"gray"},{"text":")","italic":false,"color":"gray"},{"text":",","italic":false,"color":"white"}]', '["",{"text":"you can ","italic":false,"color":"white"},{"text":"Prestige","italic":false,"color":"aqua"},{"text":" your skill!","italic":false,"color":"white"}]', '["",{"text":"Unlock ","italic":false,"color":"gray"},{"text":"exclusive bonuses","italic":false,"color":"gray"},{"text":" and","italic":false,"color":"gray"}]', '["",{"text":"showcase your mastery","italic":false,"color":"gray"}]', '[""]', '["",{"text":"Click here to view!","italic":false,"color":"yellow"}]' ], !attribute_modifiers, enchantment_glint_override = true ];
            } with ::temp.gui.prog.data;

            // Ability switch
            ::temp.gui.pref.ability = "§a§l✔";
            execute run {
                $execute if entity @p[ tag = !skills.ability.$(name) ] run ::temp.gui.pref.ability = "§c§l❌";
            } with ::temp.gui.prog;
            execute run {
                $item replace entity @s container.18 with minecraft:redstone_torch[ custom_data = { skills_lib_gui:1b }, custom_name = '[{"text":"Ability Toggle ","italic":false,"color":"yellow"},{"text":"§7[$(ability)§7]","italic":false}]', lore = [ '[{"text":"Enable or disable this","italic":false,"color":"gray"}]', '[{"text":"ability.","italic":false,"color":"gray"}]', '[""]', '{"text":"Click to toggle!","color":"yellow","italic":false}' ]];
            } with ::temp.gui.pref;

            switch(skills.gui.prog.page:@s) {
                case 1: GUI.prog.start(); $lvlstart = 1; $lvlend = 21;
                case 2: GUI.prog.mid(); $lvlstart = 22; $lvlend = 43;
                case 3: GUI.prog.mid(); $lvlstart = 44; $lvlend = 65;
                case 4: GUI.prog.mid(); $lvlstart = 66; $lvlend = 87;
                case 5: GUI.prog.end(); $lvlstart = 88; $lvlend = 99;
            }

            GUI.prog.fill();

            item replace entity @s container.17 with book[ custom_data = { skills_lib_gui:1b }, custom_name = '["",{"text":"Task Rewards","italic":false,"color":"#996666"}]', lore = [ '["",{"text":"See","italic":false,"color":"white"},{"text":" ","italic":false,"color":"gray"},{"text":"XP","italic":false,"color":"aqua"},{"text":" ","italic":false,"color":"gray"},{"text":"values for each","italic":false,"color":"white"},{"text":" ","italic":false,"color":"gray"},{"text":"Tasks.","italic":false,"color":"gold"}]', '["",{"text":"Find out which actions pay off","italic":false,"color":"gray"}]', '["",{"text":"the most!","italic":false,"color":"gray"}]', '[""]', '["",{"text":"Click to view!","italic":false,"color":"yellow"}]' ]];
        }

        function 3() {
            // Tasks
            GUI.Mask.2();

            item replace entity @s container.0 with arrow[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"Go Back","color":"gray","italic":false}' ];
            item replace entity @s container.18 with barrier[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"Close","color":"red","italic":false}' ];

            ::temp.gui.tasks.index = skills.gui.index:@s;
            execute run { $::temp.gui.tasks.name = ::DB.Indexes.$(index); } with ::temp.gui.tasks;
            execute run {
                $::temp.gui.tasks.item = ::DB.Skills.$(name).item;
            } with ::temp.gui.tasks;
            execute run {
                $item replace entity @s container.9 with $(item)[ custom_data = { skills_lib_gui:1b }, custom_name = '["",{"text":"$(name) Task Rewards","italic":false,"color":"yellow"}]', lore = [ '["",{"text":"Here, you can find all ","italic":false,"color":"white"},{"text":"actions","italic":false,"color":"gold"}]', '["",{"text":"that grant ","italic":false,"color":"white"},{"text":"XP","italic":false,"color":"aqua"},{"text":". Check how much","italic":false,"color":"white"}]', '["",{"text":"each ","italic":false,"color":"white"},{"text":"task rewards you","italic":false,"color":"dark_purple"},{"text":". Use this","italic":false,"color":"white"}]', '["",{"text":"to optimize your skill","italic":false,"color":"white"}]', '["",{"text":"progression!","italic":false,"color":"white"}]' ], !attribute_modifiers, enchantment_glint_override = true ];
            } with ::temp.gui.tasks;
            // Get data
            execute run {
                $::temp.gui.tasks_.tab = ::DB.Skills.$(name).Tasks;
            } with ::temp.gui.tasks;


            $len_tab = execute if data storage prodiges_skills:prodiges_skills temp.gui.tasks_.tab[ ];
            $i = 0;
            $page_number = $len_tab;
            $page_number /= 21;

            $i = skills.gui.tasks.page:@s;
            $i *= 21;
            GUI.Tasks.fill();
            // Sliders
            item replace entity @s container.26 with paper[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"Next Page »","color":"yellow","italic":false, "bold":true}' ];
            item replace entity @s container.8 with paper[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"« Previous Page","color":"yellow","italic":false, "bold":true}' ];

            if (skills.gui.tasks.page:@s == $page_number) {
                item replace entity @s container.26 with paper[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"Next Page »","color":"gray","italic":false}' ];
            }
            if (skills.gui.tasks.page:@s == 0) {
                item replace entity @s container.8 with paper[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"« Previous Page","color":"gray","italic":false}' ];
            }
        }

        function 4() {
            // Preferences
            GUI.Mask.2();

            item replace entity @s container.21 with arrow[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"Go Back","color":"gray","italic":false}' ];
            item replace entity @s container.23 with barrier[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"Close","color":"red","italic":false}' ];
            JMC.put('execute as @p run loot replace entity @n[type=chest_minecart, tag=skillsLIB] container.22 loot {"type":"minecraft:command","pools":[{"rolls":1,"entries":[{"type":"minecraft:item","name":"minecraft:player_head","functions":[{"function":"minecraft:set_name","entity":"this","target":"custom_name","name":{"text":"Profile & Preferences","color":"light_purple","italic":false}},{"function":"minecraft:fill_player_head","entity":"this"},{"function":"minecraft:set_custom_data","tag":"{skills_lib_gui:1b}"},{"function":"minecraft:set_lore","entity":"this","lore":[{"text":"Manage your §6settings §fand view your","type":"text","color":"white","italic":false},{"text":"§6stats§r. Customize your experience!","type":"text","color":"white","italic":false}],"mode":"append"}],"conditions":[]}]}]}');
            item replace entity @s container.4 with paper[ custom_data = { skills_lib_gui:1b }, custom_name = '["",{"text":"How to Change Preferences?","italic":false,"color":"yellow","bold":true}]', lore = [ '["",{"text":"♦","italic":false,"bold":true,"color":"dark_gray"},{"text":" Click on any setting to toggle","italic":false,"color":"white"}]', '["",{"text":" it ","italic":false,"color":"white"},{"text":"on or off","italic":false,"color":"aqua"},{"text":".","italic":false,"color":"white"}]', '[""]', '["",{"text":"♦ ","italic":false,"bold":true,"color":"dark_gray"},{"text":"Your changes will ","italic":false,"color":"white"},{"text":"instantly","italic":false,"color":"gold"}]', '["",{"text":" apply—customize your experience","italic":false,"color":"white"}]', '["",{"text":" freely!","italic":false,"color":"white"}]' ]];
            ::temp.gui.pref.xp_notif = "§a§l✔";
            if (entity @p[ tag = !skills.pref.xp_notif ]) { ::temp.gui.pref.xp_notif = "§c§l❌"; }

            ::temp.gui.pref.lvl_notif = "§a§l✔";
            if (entity @p[ tag = !skills.pref.lvl_notif ]) { ::temp.gui.pref.lvl_notif = "§c§l❌"; }

            ::temp.gui.pref.skill_prog = "§a§l✔";
            if (entity @p[ tag = !skills.pref.skill_prog ]) { ::temp.gui.pref.skill_prog = "§c§l❌"; }

            ::temp.gui.pref.lvl_broadcast = "§a§l✔";
            if (entity @p[ tag = !skills.pref.lvl_broadcast ]) { ::temp.gui.pref.lvl_broadcast = "§c§l❌"; }

            ::temp.gui.pref.sound = "§a§l✔";
            if (entity @p[ tag = !skills.pref.sound ]) { ::temp.gui.pref.sound = "§c§l❌"; }

            execute run {
                $item replace entity @s container.11 with ender_eye[
                    custom_data = { skills_lib_gui:1b }, custom_name = '["",{"text":"Level Up Broadcast.","italic":false,"color":"light_purple"},{"text":" ","italic":false},{"text":"[","italic":false,"color":"gray"},{"text":"$(lvl_broadcast)","italic":false},{"text":"]","italic":false,"color":"gray"}]', lore = [ '["",{"text":"Toggle broadcast of ","italic":false,"color":"white"},{"text":"level-up","italic":false,"color":"gold"}]', '["",{"text":"messages","italic":false,"color":"gold"},{"text":" to all players.","italic":false,"color":"white"}]', '["",{"text":"Let everyone know when you level","italic":false,"color":"gray"}]', '["",{"text":"up your skills with a public","italic":false,"color":"gray"}]', '["",{"text":"announcement!","italic":false,"color":"gray"}]', '[""]', '["",{"text":"Click to toggle!","italic":false,"color":"yellow"}]' ]];
                    $item replace entity @s container.12 with bell[
                        custom_data = { skills_lib_gui:1b }, custom_name = '["",{"text":"XP Notifications","italic":false,"color":"light_purple"},{"text":" ","italic":false,"color":"yellow"},{"text":"[","italic":false,"color":"gray"},{"text":"$(xp_notif)","italic":false},{"text":"]","italic":false,"color":"gray"}]', lore = [ '["",{"text":"Toggle notifications for ","italic":false,"color":"white"},{"text":"XP gains","italic":false,"color":"gold"},{"text":".","italic":false,"color":"white"}]', '["",{"text":"Stay informed when you progress!","italic":false,"color":"gray"}]', '[""]', '["",{"text":"Click to toggle!","italic":false,"color":"yellow"}]' ]];
                        $item replace entity @s container.13 with fire_charge[
                            custom_data = { skills_lib_gui:1b }, custom_name = '["",{"text":"Level-Up Notification","italic":false,"color":"light_purple"},{"text":" ","italic":false,"color":"yellow"},{"text":"[","italic":false,"color":"gray"},{"text":"$(lvl_notif)","italic":false},{"text":"]","italic":false,"color":"gray"}]', lore = [ '["",{"text":"Toggle ","italic":false,"color":"white"},{"text":"level-up","italic":false,"color":"gold"},{"text":" notifications.","italic":false,"color":"white"}]', '["",{"text":"Receive a visual cue and a sound","italic":false,"color":"gray"}]', '["",{"text":"effect every time you level up!","italic":false,"color":"gray"}]', '[""]', '["",{"text":"Click to toggle!","italic":false,"color":"yellow"}]' ]];
                            $item replace entity @s container.14 with note_block[
                                custom_data = { skills_lib_gui:1b }, custom_name = '["",{"text":"Sound Effects ","italic":false,"color":"light_purple"},{"text":"[","italic":false,"color":"gray"},{"text":"$(sound)","italic":false},{"text":"]","italic":false,"color":"gray"}]', lore = [ '["",{"text":"Manage the in-game ","italic":false,"color":"white"},{"text":"sound effects","italic":false,"color":"gold"},{"text":".","italic":false,"color":"white"}]', '["",{"text":"Enhance your gaming experience","italic":false,"color":"gray"}]', '["",{"text":"or reduce distractions!","italic":false,"color":"gray"}]', '[""]', '["",{"text":"Click to toggle!","italic":false,"color":"yellow"}]', '["",{"text":" ","italic":false}]' ]];
                                $item replace entity @s container.15 with minecraft:totem_of_undying[
                                    custom_data = { skills_lib_gui:1b }, custom_name = '["",{"text":"Skill Progression","italic":false,"color":"light_purple"},{"text":" ","italic":false},{"text":"[","italic":false,"color":"gray"},{"text":"$(skill_prog)","italic":false},{"text":"]","italic":false,"color":"gray"}]', lore = [ '["",{"text":"Toggle ","italic":false,"color":"white"},{"text":"skill progression","italic":false,"color":"gold"},{"text":" on or","italic":false,"color":"white"}]', '["",{"text":"off.","italic":false,"color":"white"}]', '["",{"text":"Disable skill leveling temporarily","italic":false,"color":"gray"}]', '["",{"text":"if you want to pause your growth!","italic":false,"color":"gray"}]', '[""]', '["",{"text":"Click to toggle!","italic":false,"color":"yellow"}]' ]];
                                } with ::temp.gui.pref;
                            }

                            function 5() {
                                // Shop
                                GUI.Mask.2();

                                item replace entity @s container.21 with arrow[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"Go Back","color":"gray","italic":false}' ];
                                item replace entity @s container.23 with barrier[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"Close","color":"red","italic":false}' ];
                                item replace entity @s container.22 with player_head[ profile = { id:[ I; 1434832075, -102998962, -1229628019, 1369636598 ], properties:[ { name:"textures", value:"eyJ0ZXh0dXJlcyI6eyJTS0lOIjp7InVybCI6Imh0dHA6Ly90ZXh0dXJlcy5taW5lY3JhZnQubmV0L3RleHR1cmUvNTRjZGZiODhjZjhjMzY1NjMwNDI1NGU0ZDY3YTBhYjAyZjZkMjdjNzlmMWIxZTQwNGRjM2E3Y2U0ZWIyZGUwMCJ9fX0=" } ] }, custom_data = { skills_lib_gui:1b }, custom_name = '["",{"text":"Shop","italic":false,"color":"green"}]', lore = [ '["",{"text":"Buy ","italic":false,"color":"white"},{"text":"boosters","italic":false,"color":"gold"},{"text":", ","italic":false,"color":"white"},{"text":"XP","italic":false,"color":"gold"},{"text":", ","italic":false,"color":"white"},{"text":"prestige","italic":false,"color":"gold"},{"text":", and","italic":false,"color":"white"}]', '["",{"text":"more! Unlock exclusive perks to","italic":false,"color":"white"}]', '["",{"text":"enhance your gameplay experience!","italic":false,"color":"white"}]' ]];
                                // Profile & Preferences

                                ::temp.gui.profile.sp = skills.player.sp:@p;

                                ::temp.gui.profile.booster_xp = "§c-";
                                $xp_duration = skills.booster.1.duration:@p;
                                if ($xp_duration > 1) {
                                    ::temp.gui.profile.booster_xp_duration = $xp_duration;
                                    ::temp.gui.profile.booster_xp_power = skills.booster.1.power:@p;

                                    execute run {
                                        $::temp.gui.profile.booster_xp = "§bx$(booster_xp_power) XP Booster §7- $(booster_xp_duration) minute(s) left";
                                    } with ::temp.gui.profile;
                                }

                                ::temp.gui.profile.booster_sp = "§c-";
                                $sp_duration = skills.booster.2.duration:@p;
                                if ($sp_duration > 1) {
                                    ::temp.gui.profile.booster_sp_duration = $sp_duration;
                                    ::temp.gui.profile.booster_sp_power = skills.booster.2.power:@p;

                                    execute run {
                                        $::temp.gui.profile.booster_sp = "§6x$(booster_sp_power) Skill Point Booster §7- $(booster_sp_duration) minute(s) left";
                                    } with ::temp.gui.profile;
                                }

                                execute run {
                                    JMC.put('$execute as @p run loot replace entity @n[type=chest_minecart, tag=skillsLIB] container.4 loot {"type":"minecraft:command","pools":[{"rolls":1,"entries":[{"type":"minecraft:item","name":"minecraft:player_head","functions":[{"function":"minecraft:set_name","entity":"this","target":"custom_name","name":{"text":"Profile","color":"light_purple","italic":false}},{"function":"minecraft:fill_player_head","entity":"this"},{"function":"minecraft:set_custom_data","tag":"{skills_lib_gui:1b}"},{"function":"minecraft:set_lore","entity":"this","lore":[{"text":""},{"text":"§8§l♦ §rPoints: ","type":"text","extra":[{"text":"$(sp) SP","type":"text","color":"gold","italic":false}],"color":"#A888B5","italic":false},{"text":""},{"text":"Active Boosters:","color":"yellow","italic":false},{"text":"§8• $(booster_xp)","italic":false},{"text":"§8• $(booster_sp)","italic":false}],"mode":"append"}],"conditions":[]}]}]}');
                                } with ::temp.gui.profile;
                                // Items
                                $mod = skills.gui.shop.boost_state:@s;
                                $mod %= 4;
                                switch($mod) {
                                    case 0: ::temp.gui.shop.model = "minecraft:diamond_sword";
                                    case 1: ::temp.gui.shop.model = "minecraft:iron_pickaxe";
                                    case 2: ::temp.gui.shop.model = "minecraft:leather_helmet";
                                    case 3: ::temp.gui.shop.model = "minecraft:golden_chestplate";
                                }
                                execute run {
                                    $item replace entity @s container.11 with stone[ item_model = "$(model)", custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"Special Items","color":"aqua","italic":false}', lore = [ '["",{"text":"Browse and purchase ","italic":false,"color":"white"},{"text":"exclusive","italic":false,"color":"light_purple"}]', '["",{"text":"tools ","italic":false,"color":"light_purple"},{"text":"and","italic":false,"color":"white"},{"text":" armor","italic":false,"color":"light_purple"},{"text":".","italic":false,"color":"white"}]', '["",{"text":"Unlock powerful gear!","italic":false,"color":"gray"}]', '[""]', '["",{"text":"Click to view!","italic":false,"color":"yellow"}]' ]];
                                } with ::temp.gui.shop;
                                // Skill Crate
                                ::temp.gui.shop.cooldown = skills.crate.cooldown:@p;
                                if (skills.crate.cooldown:@p > 0) {
                                    execute run { $::temp.gui.shop.crate_state = "§7You are still on a cooldown! ($(cooldown) minute(s))"; } with ::temp.gui.shop;
                                    ::temp.gui.shop.crate_color = "red";
                                    ::temp.gui.shop.profile = { id:[ I; -1082168181, 1071530784, -1128679516, -2846883 ], properties:[ { name:"textures", value:"eyJ0ZXh0dXJlcyI6eyJTS0lOIjp7InVybCI6Imh0dHA6Ly90ZXh0dXJlcy5taW5lY3JhZnQubmV0L3RleHR1cmUvZWJjZGYwZmYwNzEyYWUzZGU1NTRjMzcyNjA3NzYxMDAwZDNiMGI2Yjg2MTNiOGEyYzZkZGEwMGNkMTBkNzhkOCJ9fX0=" } ] };
                                } else {
                                    ::temp.gui.shop.crate_state = "§eClick to open!";
                                    ::temp.gui.shop.crate_color = "light_purple";
                                    ::temp.gui.shop.profile = { id:[ I; 1747670542, -1865006816, -1902654712, 1202578603 ], properties:[ { name:"textures", value:"eyJ0ZXh0dXJlcyI6eyJTS0lOIjp7InVybCI6Imh0dHA6Ly90ZXh0dXJlcy5taW5lY3JhZnQubmV0L3RleHR1cmUvY2MxYjJmNTkyY2ZjOGQzNzJkY2Y1ZmQ0NGVlZDY5ZGRkYzY0NjAxZDc4NDZkNzI2MTlmNzA1MTFkODA0M2E4OSJ9fX0=" } ] };
                                }
                                execute run {
                                    $item replace entity @s container.13 with player_head[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"Skill Crate","color":"$(crate_color)","italic":false}', lore = [ '["",{"text":"Open special crates to obtain","italic":false,"color":"white"}]', '["",{"text":"unique tools","italic":false,"color":"gold"},{"text":" and ","italic":false,"color":"white"},{"text":"boosters","italic":false,"color":"aqua"},{"text":",","italic":false,"color":"white"}]', '["",{"text":"and ","italic":false,"color":"white"},{"text":"loot","italic":false,"color":"light_purple"},{"text":".","italic":false,"color":"white"}]', '["",{"text":"(i) You have 1 free crate","italic":false,"color":"gray"}]', '{"text":"every hour!","italic":false,"color":"gray"}', '[""]', '["",{"text":"$(crate_state)","italic":false}]' ], profile = $(profile) ];
                                } with ::temp.gui.shop;
                                // Boosters
                                $mod = skills.gui.shop.boost_state:@s;
                                $mod %= 2;
                                if ($mod == 1) {
                                    ::temp.gui.shop.booster_item = "experience_bottle";
                                } else {
                                    ::temp.gui.shop.booster_item = "gold_ingot";
                                }

                                execute run {
                                    $item replace entity @s container.15 with $(booster_item)[ custom_data = { skills_lib_gui:1b }, custom_name = '["",{"text":"Boosters","italic":false,"color":"green"}]', lore = [ '[{"text":"Boosters temporarily ","italic":false,"color":"white"},{"text":"increase","italic":false,"color":"gold"}]', '["",{"text":"your XP or Skill Point","italic":false,"color":"gold"},{"text":" gain.","italic":false,"color":"white"}]', '[{"text":"Speed up your progressoin!","italic":false,"color":"gray"}]', '[""]', '{"text":"Click to view!","italic":false,"color":"yellow"}' ], enchantment_glint_override = true ];
                                } with ::temp.gui.shop;
                            }

                            function 6() {
                                // Settings Global
                                GUI.Mask.3();

                                item replace entity @s container.21 with arrow[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"Go Back","color":"gray","italic":false}' ];
                                item replace entity @s container.23 with barrier[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"Close","color":"red","italic":false}' ];
                                item replace entity @s container.22 with command_block[ custom_data = { skills_lib_gui:1b }, custom_name = '["",{"text":"Configuration Panel","italic":false,"color":"red"}]', lore = [ '["",{"text":"Modify all server-wide settings","italic":false,"color":"white"}]', '["",{"text":"here.","italic":false,"color":"white"}]' ]];

                                item replace entity @s container.11 with carrot[ custom_data = { skills_lib_gui:1b }, custom_name = '["",{"text":"Rewards","italic":false,"color":"red"}]', lore = [ '["",{"text":"Configure the rewards players","italic":false,"color":"white"}]', '["",{"text":"receive when they level up their","italic":false,"color":"white"}]', '["",{"text":"skills.","italic":false,"color":"white"}]', '[""]', '["",{"text":"Click to see how!","italic":false,"color":"yellow"}]' ]];
                                item replace entity @s container.12 with minecraft:experience_bottle[ custom_data = { skills_lib_gui:1b }, custom_name = '["",{"text":"XP from Tasks","italic":false,"color":"red"}]', lore = [ '["",{"text":"Adjust the amount of XP players","italic":false,"color":"white"}]', '["",{"text":"earn from completing each tasks.","italic":false,"color":"white"}]', '[""]', '["",{"text":"Click to see how!","italic":false,"color":"yellow"}]' ]];
                                item replace entity @s container.13 with gold_nugget[ custom_data = { skills_lib_gui:1b }, custom_name = '["",{"text":"Points per Task","italic":false,"color":"red"}]', lore = [ '["",{"text":"Set the number of Skill Points players","italic":false,"color":"white"}]', '[{"text":"gain for each task they complete.","italic":false,"color":"white"}]', '[""]', '["",{"text":"Click to see how!","italic":false,"color":"yellow"}]' ]];
                                item replace entity @s container.14 with wooden_pickaxe[ custom_data = { skills_lib_gui:1b }, custom_name = '["",{"text":"Add Tasks","italic":false,"color":"red"}]', lore = [ '["",{"text":"Add new tasks to the skill","italic":false,"color":"white"}]', '["",{"text":"system.","italic":false,"color":"white"}]', '[""]', '["",{"text":"Click to see how!","italic":false,"color":"yellow"}]' ], !attribute_modifiers ];
                                item replace entity @s container.15 with hopper[ custom_data = { skills_lib_gui:1b }, custom_name = '["",{"text":"Reset Everyone\'s Skills","italic":false,"color":"red"}]', lore = [ '["",{"text":"Reset the skills of all players","italic":false,"color":"white"}]', '["",{"text":"on the server.","italic":false,"color":"white"}]', '[""]', '["",{"text":"Click to see how!","italic":false,"color":"yellow"}]' ]];



                            }

                            function 7() {
                                // Prestige
                                GUI.Mask.1();

                                item replace entity @s container.21 with arrow[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"Go Back","color":"gray","italic":false}' ];
                                item replace entity @s container.22 with netherite_scrap[ custom_data = { skills_lib_gui:1b }, custom_name = '["",{"text":"Prestiges","italic":false,"color":"dark_purple"}]', lore = [ '[{"text":"Once you reach ","italic":false,"color":"white"},{"text":"level","italic":false,"color":"gold"},{"text":" ","italic":false,"color":"white"},{"text":"100","italic":false},{"text":" (C) in a","italic":false,"color":"white"}]', '["",{"text":"skill, you can reset it to gain","italic":false,"color":"white"}]', '["",{"text":"a ","italic":false,"color":"white"},{"text":"permanent bonus","italic":false,"color":"green"},{"text":"!","italic":false,"color":"white"}]', '[{"text":"Grow even stronger over time!","italic":false,"color":"gray"}]' ], enchantment_glint_override = true ];
                                item replace entity @s container.23 with barrier[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"Close","color":"red","italic":false}' ];
                                item replace entity @s container.4 with paper[ custom_data = { skills_lib_gui:1b }, custom_name = '["",{"text":"How to Choose a Skill to Prestige","italic":false,"color":"yellow","bold":true}]', lore = [ '["",{"text":"To choose, click on the skill you","italic":false,"color":"white"}]', '["",{"text":"want to reset (with level 100).","italic":false,"color":"white"}]', '[""]', '["",{"text":"You\'ll gain a bonus and a special","italic":false,"color":"white"}]', '["",{"text":"title upon prestiging.","italic":false,"color":"white"}]' ]];

                                $slot = 11;
                                for ($index = 0; $index < #lenSkills; $index++) {
                                    ::temp.gui.prestige.index = $index;
                                    execute run { $::temp.gui.prestige.name = ::DB.Indexes.$(index); } with ::temp.gui.prestige;

                                    execute run {
                                        ::temp.gui.prestige.slot = $slot;

                                        $::temp.gui.prestige.name = ::DB.Skills.$(name).name;
                                        $::temp.gui.prestige.item = ::DB.Skills.$(name).item;
                                        $::temp.gui.prestige.desc1 = ::DB.Skills.$(name).desc1;
                                        $::temp.gui.prestige.desc2 = ::DB.Skills.$(name).desc2;
                                        $::temp.gui.prestige.ability_desc1 = ::DB.Skills.$(name).prestige.ability_desc1;
                                        $::temp.gui.prestige.ability_desc2 = ::DB.Skills.$(name).prestige.ability_desc2;
                                        $::temp.gui.prestige.ability = ::DB.Skills.$(name).prestige.ability;

                                        $scoreboard players operation $lvl skills.__variable__ = @p skills.$(name).lvl;
                                        $scoreboard players operation $prestige_lvl skills.__variable__ = @p skills.$(name).prestige;

                                        $prestige_power = $prestige_lvl;
                                        $prestige_power *= 5;
                                        ::temp.gui.prestige.power = $prestige_power;
                                        ::temp.gui.prestige.lvl_int = $lvl;
                                        ::temp.gui.prestige.lvl = $lvl;
                                        roman_conv(lvl, temp.gui.prestige);

                                        ::temp.gui.prestige.prestige_lvl = $prestige_lvl;
                                        roman_conv(prestige_lvl, temp.gui.prestige);

                                        $prestige_lvl += 1;
                                        ::temp.gui.prestige.prestige_next = $prestige_lvl;
                                        roman_conv(prestige_next, temp.gui.prestige);
                                        $prestige_power = $prestige_lvl;
                                        $prestige_power *= 5;
                                        ::temp.gui.prestige.power_next = $prestige_power;

                                        ::temp.gui.prestige.color_1 = "gray";
                                        ::temp.gui.prestige.color_2 = "dark_gray";
                                        ::temp.gui.prestige.glint = "false";
                                        $execute if score @p skills.$(name).lvl matches 100 run {
                                            ::temp.gui.prestige.color_1 = "light_purple";
                                            ::temp.gui.prestige.color_2 = "dark_purple";
                                            ::temp.gui.prestige.glint = "true";
                                        }

                                        $execute if score @p skills.$(name).prestige matches ..4 run GUI.Macro.prestige_set() with ::temp.gui.prestige;

                                        $execute if score @p skills.$(name).prestige matches 5 run GUI.Macro.prestige_set_max() with ::temp.gui.prestige;
                                    } with ::temp.gui.prestige;

                                    $slot++;
                                }
                            }

                            function 8() {
                                // Special Items
                                GUI.Mask.2();
                                item replace entity @s container.0 with arrow[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"Go Back","color":"gray","italic":false}' ];
                                item replace entity @s container.9 with stone[ item_model = "minecraft:leather_helmet", custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"Special Items","color":"aqua","italic":false}', lore = [ '["",{"text":"Browse and purchase ","italic":false,"color":"white"},{"text":"exclusive","italic":false,"color":"light_purple"}]', '["",{"text":"tools ","italic":false,"color":"light_purple"},{"text":"and","italic":false,"color":"white"},{"text":" armor","italic":false,"color":"light_purple"},{"text":".","italic":false,"color":"white"}]', '["",{"text":"Unlock powerful gear!","italic":false,"color":"gray"}]' ]];
                                item replace entity @s container.18 with barrier[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"Close","color":"red","italic":false}' ];

                                len_array($len_items, DB.Shop.specialItems);
                                Hardcode.repeatLists(
                                    [ "[start]", "[end]" ],
                                    () => {
                                        for ($slot = [ start ]; $slot < [ end ]; $slot++) {
                                            $len_items -= 1;
                                            if ($len_items < 0) { return 0; }
                                            ::temp.gui.items.del();
                                            ::temp.gui.items.slot = $slot;
                                            ::temp.gui.items.index = $len_items;

                                            GUI.Items.set_param() with ::temp.gui.items;
                                            GUI.items.set_item() with ::temp.gui.items;
                                        }
                                    },
                                    [ ["1", "10", "19" ], [ "8", "17", "26" ]]
                                );
                            }

                            function 9() {
                                // Boosters
                                GUI.Mask.2();
                                item replace entity @s container.21 with arrow[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"Go Back","color":"gray","italic":false}' ];
                                item replace entity @s container.22 with experience_bottle[ custom_data = { skills_lib_gui:1b }, custom_name = '["",{"text":"Boosters","italic":false,"color":"green"}]', lore = [ '[{"text":"Boosters temporarily ","italic":false,"color":"white"},{"text":"increase","italic":false,"color":"gold"}]', '["",{"text":"your XP or Skill Point","italic":false,"color":"gold"},{"text":" gain.","italic":false,"color":"white"}]', '[{"text":"Speed up your progressoin!","italic":false,"color":"gray"}]' ], enchantment_glint_override = true ];
                                item replace entity @s container.23 with barrier[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"Close","color":"red","italic":false}' ];
                                // Profile & Preferences

                                ::temp.gui.profile.sp = skills.player.sp:@p;

                                ::temp.gui.profile.booster_xp = "§c-";
                                $xp_duration = skills.booster.1.duration:@p;
                                if ($xp_duration > 1) {
                                    ::temp.gui.profile.booster_xp_duration = $xp_duration;
                                    ::temp.gui.profile.booster_xp_power = skills.booster.1.power:@p;

                                    execute run {
                                        $::temp.gui.profile.booster_xp = "§bx$(booster_xp_power) XP Booster §7- $(booster_xp_duration) minute(s) left";
                                    } with ::temp.gui.profile;
                                }

                                ::temp.gui.profile.booster_sp = "§c-";
                                $sp_duration = skills.booster.2.duration:@p;
                                if ($sp_duration > 1) {
                                    ::temp.gui.profile.booster_sp_duration = $sp_duration;
                                    ::temp.gui.profile.booster_sp_power = skills.booster.2.power:@p;

                                    execute run {
                                        $::temp.gui.profile.booster_sp = "§6x$(booster_sp_power) Skill Point Booster §7- $(booster_sp_duration) minute(s) left";
                                    } with ::temp.gui.profile;
                                }

                                execute run {
                                    JMC.put('$execute as @p run loot replace entity @n[type=chest_minecart, tag=skillsLIB] container.4 loot {"type":"minecraft:command","pools":[{"rolls":1,"entries":[{"type":"minecraft:item","name":"minecraft:player_head","functions":[{"function":"minecraft:set_name","entity":"this","target":"custom_name","name":{"text":"Profile","color":"light_purple","italic":false}},{"function":"minecraft:fill_player_head","entity":"this"},{"function":"minecraft:set_custom_data","tag":"{skills_lib_gui:1b}"},{"function":"minecraft:set_lore","entity":"this","lore":[{"text":""},{"text":"§8§l♦ §rPoints: ","type":"text","extra":[{"text":"$(sp) SP","type":"text","color":"gold","italic":false}],"color":"#A888B5","italic":false},{"text":""},{"text":"Active Boosters:","color":"yellow","italic":false},{"text":"§8• $(booster_xp)","italic":false},{"text":"§8• $(booster_sp)","italic":false}],"mode":"append"}],"conditions":[]}]}]}');
                                } with ::temp.gui.profile;

                                Hardcode.repeatLists(
                                    [ "[slot]", "[item]", "[power]", "[duration]", "[color]", "[cost]", "[type]" ],
                                    () => {
                                        if ($sp > [ cost ]) {
                                            ::temp.gui.Boosters.glint = true;
                                            ::temp.gui.Boosters.sp_color = "§6";
                                        } else {
                                            ::temp.gui.Boosters.glint = false;
                                            ::temp.gui.Boosters.sp_color = "§8";
                                        }
                                        ::temp.gui.Boosters.color = "[color]";
                                        ::temp.gui.Boosters.slot = [ slot ];
                                        ::temp.gui.Boosters.power = [ power ];
                                        ::temp.gui.Boosters.duration = [ duration ];
                                        ::temp.gui.Boosters.item = "[item]";
                                        ::temp.gui.Boosters.cost = [ cost ];
                                        ::temp.gui.Boosters.type = "[type]";
                                        GUI.Boosters.set_item() with ::temp.gui.Boosters;
                                    },
                                    [ ["10", "11", "12", "14", "15", "16" ], [ "experience_bottle", "experience_bottle", "experience_bottle", "gold_ingot", "gold_ingot", "gold_ingot" ], [ "2", "3", "5", "2", "5", "8" ], [ "15", "60", "120", "20", "30", "60" ], [ "aqua", "aqua", "aqua", "gold", "gold", "gold" ], [ "35", "50", "150", "50", "100", "200" ], [ "XP", "XP", "XP", "SP", "SP", "SP" ]]
                                );
                            }
                        }

                        class prog {
                            function ability_switch() {
                                index_to_name({ storage: temp.gui.prog.name });
                                execute run {
                                    $execute if entity @p[ tag = skills.ability.$(name) ] run return run tag @p remove skills.ability.$(name);
                                    $tag @p add skills.ability.$(name);
                                } with ::temp.gui.prog;
                                playsound minecraft:entity.arrow.hit_player ambient @p[ tag = skills.pref.sound ] ~ ~ ~ 1 0;
                            }

                            function fill() {
                                Hardcode.repeatLists(
                                    [ "[start]", "[end]" ],
                                    () => {
                                        for ($slot = [ start ]; $slot < [ end ]; $slot++) {
                                            if ($lvlstart > 100) { return 0; }
                                            ::temp.gui.prog.data.slot = $slot;
                                            ::temp.gui.prog.data.lvlcheck_int = $lvlstart;
                                            ::temp.gui.prog.data.lvlcheck = $lvlstart;
                                            roman_conv(lvlcheck, temp.gui.prog.data);
                                            // Claimed ?
                                            ::temp.gui.prog.data.lvl_id = $lvlstart;
                                            $claimed = false;
                                            execute run {
                                                $execute if entity @p[ tag = !skills.claimed.$(name).$(lvl_id) ] run { $claimed = true; }
                                            } with ::temp.gui.prog.data;

                                            // Set rewards
                                            $mod = $lvlstart;
                                            $mod %= 10;

                                            if ($mod == 0) {
                                                ::temp.gui.prog.data.point = ::DB.Rewards.3.point;
                                                ::temp.gui.prog.data.show = ::DB.Rewards.3.show;
                                            }
                                            else if ($mod == 6 || $mod == 2) {
                                                ::temp.gui.prog.data.point = ::DB.Rewards.2.point;
                                                ::temp.gui.prog.data.show = ::DB.Rewards.2.show;
                                            }
                                            else {
                                                ::temp.gui.prog.data.point = ::DB.Rewards.1.point;
                                                ::temp.gui.prog.data.show = ::DB.Rewards.1.show;
                                            }
                                            GUI.prog.set_items() with ::temp.gui.prog.data;
                                        }
                                    },
                                    [ ["1", "10", "19" ], [ "8", "17", "26" ]]
                                );
                            }

                            function set_items() {
                                $scoreboard players operation $lvl skills.__variable__ = @p skills.$(name).lvl;
                                if ($lvl < $lvlstart) {
                                    execute run {
                                        $item replace entity @s container.$(slot) with minecraft:charcoal[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"$(name) §4§l$(lvlcheck)","color":"red","italic":false}', lore = [ '[{"text":"Level $(lvlcheck_int)","italic":false,"color":"blue"}]', '[{"text":"Rewards:","italic":false,"color":"yellow"}]', '[{"text":"§8- $(show)"}]', '[{"text":"§8- §6+$(point) Skill Points (SP)"}]', '[""]', '["",{"text":"You cannot claim this!","italic":false,"color":"red"}]' ]];
                                    } with ::temp.gui.prog.data;
                                    if ($lvlstart == 100) {
                                        execute run {
                                            $item replace entity @s container.$(slot) with minecraft:charcoal[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"$(name) §4§l$(lvlcheck)","color":"red","italic":false}', lore = [ '[{"text":"Level $(lvlcheck_int)","italic":false,"color":"blue"}]', '["",{"text":"This is the maximum level","italic":false,"color":"red"}]' ]];
                                        } with ::temp.gui.prog.data;
                                    }

                                } else if ($lvl > $lvlstart && $claimed) {
                                    execute run {
                                        $item replace entity @s container.$(slot) with quartz[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"$(name) §8§l$(lvlcheck)","color":"gray","italic":false}', lore = [ '[{"text":"Level $(lvlcheck_int)","italic":false,"color":"blue"}]', '[{"text":"Rewards:","italic":false,"color":"yellow"}]', '[{"text":"§8- $(show)"}]', '[{"text":"§8- §6+$(point) Skill Points (SP)"}]', '[""]', '["",{"text":"You already claimed this!","italic":false,"color":"green"}]' ]];
                                    } with ::temp.gui.prog.data;
                                } else if ($lvl > $lvlstart && !$claimed) {
                                    execute run {
                                        $item replace entity @s container.$(slot) with large_amethyst_bud[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"$(name) §5§l$(lvlcheck)","color":"light_purple","italic":false}', lore = [ '[{"text":"Level $(lvlcheck_int)","italic":false,"color":"blue"}]', '[{"text":"Rewards:","italic":false,"color":"yellow"}]', '[{"text":"§8- $(show)"}]', '[{"text":"§8- §6+$(point) Skill Points (SP)"}]', '[""]', '["",{"text":"Click to claim!","italic":false,"color":"light_purple"}]' ]];
                                    } with ::temp.gui.prog.data;
                                } else if ($lvl == 100 && $lvlstart == 100) {
                                    execute run {
                                        $item replace entity @s container.$(slot) with minecraft:dragon_egg[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"$(name) §5§l$(lvlcheck)","color":"light_purple","italic":false}', lore = [ '[{"text":"Level $(lvlcheck_int)","italic":false,"color":"blue"}]', '["",{"text":"Maximum Level reached!","italic":false,"color":"dark_purple"}]', '[""]', '[{"text":"Click to go to the Prestige Menu!","color":"yellow","italic":false}]' ]];
                                    } with ::temp.gui.prog.data;
                                } else if ($lvlstart == 100) {
                                    execute run {
                                        $item replace entity @s container.$(slot) with minecraft:charcoal[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"$(name) §4§l$(lvlcheck)","color":"red","italic":false}', lore = [ '[{"text":"Level $(lvlcheck_int)","italic":false,"color":"blue"}]', '[""]', '["",{"text":"You cannot claim this!","italic":false,"color":"red"}]' ]];
                                    } with ::temp.gui.prog.data;
                                } else {
                                    execute run {
                                        $item replace entity @s container.$(slot) with amethyst_shard[ custom_data = { skills_lib_gui:1b }, custom_name = '["",{"text":"$(name) ","italic":false,"color":"#A888B5"},{"text":"§l$(lvl)","italic":false,"color":"#EFB6C8"}]', lore = [ '[{"text":"Level $(lvlcheck_int)","italic":false,"color":"blue"}]', '["",{"text":"$(desc1)","italic":false,"color":"white"}]', '["",{"text":"$(desc2)","italic":false,"color":"white"}]', '[""]', '["",{"text":"Progress to $(name)","italic":false,"color":"gray"},{"text":" $(nextLvl)","italic":false,"bold":true,"color":"#EFB6C8"},{"text":": ","italic":false,"color":"gray"},{"text":"$(100ratio)%","italic":false,"color":"#8174A0"}]', '["",{"text":"$(bar)","italic":false,"color":"white"},{"text":" $(xp)","italic":false,"color":"#EFB6C8"},{"text":"/","italic":false,"color":"#8174A0"},{"text":"$(xpToNext) ","italic":false,"color":"#EFB6C8"}]', '[""]', '[{"text":"Rewards:","italic":false,"color":"yellow"}]', '[{"text":"§8- $(show)"}]', '[{"text":"§8- §6+$(point) Skill Points (SP)"}]', ], !attribute_modifiers, enchantment_glint_override = true ];
                                    } with ::temp.gui.prog.data;
                                }

                                $lvlstart++;
                            }

                            function start() {
                                item replace entity @s container.26 with paper[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"Next Page »","color":"yellow","italic":false, "bold":true}' ];
                                item replace entity @s container.8 with map[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"« Previous Page","color":"gray","italic":false}' ];
                            }

                            function mid() {
                                item replace entity @s container.26 with paper[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"Next Page »","color":"yellow","italic":false, "bold":true}' ];
                                item replace entity @s container.8 with paper[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"« Previous Page","color":"yellow","italic":false, "bold":true}' ];
                            }

                            function end() {
                                item replace entity @s container.26 with map[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"Next Page »","color":"gray","italic":false}' ];
                                item replace entity @s container.8 with paper[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"« Previous Page","color":"yellow","italic":false, "bold":true}' ];
                            }
                        }

                        class Tasks {
                            function fill() {
                                Hardcode.repeatLists(
                                    [ "[start]", "[end]" ],
                                    () => {
                                        for ($slot = [ start ]; $slot < [ end ]; $slot++) {
                                            ::temp.gui.tasks.del();
                                            ::temp.gui.tasks.slot = $slot;
                                            ::temp.gui.tasks.i = $i;
                                            GUI.Tasks.get_data() with ::temp.gui.tasks;
                                            GUI.Tasks.set_items() with ::temp.gui.tasks;
                                            $i++;
                                        }
                                    },
                                    [ ["1", "10", "19" ], [ "8", "17", "26" ]]
                                );
                            }

                            function get_data() {
                                $::temp.gui.tasks += ::temp.gui.tasks_.tab[ $(i) ];
                            }

                            function set_items() {
                                $item replace entity @s container.$(slot) with $(item_repr)[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"$(item_name) §b+$(xp) xp","color":"gray","italic":false}', !attribute_modifiers ];
                            }
                        }

                        class Prestige {
                            function Click() {
                                $scoreboard players operation $p_lvl skills.__variable__ = @p skills.$(name).prestige;
                                $scoreboard players operation $lvl skills.__variable__ = @p skills.$(name).lvl;
                                if ($lvl < 100) {
                                    execute run {
                                        $Text.tellraw(@p, "&<red, bold>Skills ♦ &<red>You need to be Level C (100) in &<gold>$(name) &<red>to Prestige.");
                                    } with ::temp.gui.prestige;

                                    playsound minecraft:entity.enderman.teleport ambient @p[ tag = skills.pref.sound ] ~ ~ ~ 1 1;
                                } else if ($p_lvl == 5) {
                                    execute run {
                                        $Text.tellraw(@p, "&<red, bold>Skills ♦ &<red>You cannot Prestige in &<gold>$(name) &<red>any anymore.");
                                    } with ::temp.gui.prestige;

                                    playsound minecraft:entity.enderman.teleport ambient @p[ tag = skills.pref.sound ] ~ ~ ~ 1 1;
                                } else {
                                    execute run {
                                        $::temp.gui.prestige.ability = ::DB.Skills.$(name).prestige.ability;
                                        $::temp.gui.prestige.ability_desc1 = ::DB.Skills.$(name).prestige.ability_desc1;
                                        $::temp.gui.prestige.ability_desc2 = ::DB.Skills.$(name).prestige.ability_desc2;

                                        $p_lvl++;
                                        ::temp.gui.prestige.lvl = $p_lvl;
                                        roman_conv(lvl, temp.gui.prestige);
                                        $power = $p_lvl;
                                        $power *= 5;
                                        ::temp.gui.prestige.power = $power;

                                        execute run {
                                            $Text.tellraw(@p, "&<#8174A0, bold>Skills ♦ &<green>You Prestiged &<gold>$(name)&<#8174A0>.");
                                            $tellraw @p [ "", { "text":"You unlocked §l$(ability) $(lvl):", "color":"#EFB6C8" }, { "text":"\n $(ability_desc1)\n $(ability_desc2)\n " }, { "text":"\u2192 ", "bold":true, "color":"dark_gray" }, { "text":"+$(power)%", "bold":true, "color":"red" } ];

                                        } with ::temp.gui.prestige;


                                        // Operations
                                        $scoreboard players add @p skills.$(name).prestige 1;
                                        $scoreboard players set @p skills.$(name).lvl 1;
                                        $scoreboard players set @p skills.$(name).xp 0;
                                        $execute store result score @p skills.$(name).xpToNext run data get storage prodiges_skills:prodiges_skills DB.Skills.$(name).xpstart;
                                        playsound minecraft:entity.ender_dragon.growl ambient @p[ tag = skills.pref.sound ] ~ ~ ~ 1 1;
                                    } with ::temp.gui.prestige;
                                }
                            }
                        }

                        class Items {
                            function set_param() {
                                $::temp.gui.items.type = ::DB.Shop.specialItems[ $(index) ].type;
                                $::temp.gui.items.item_name = ::DB.Shop.specialItems[ $(index) ].item_name;
                                $::temp.gui.items.rarity = ::DB.Shop.specialItems[ $(index) ].rarity;
                                $::temp.gui.items.item_repr = ::DB.Shop.specialItems[ $(index) ].item_repr;
                                $::temp.gui.items.ench_0_name = ::DB.Shop.specialItems[ $(index) ].Enchants[ 0 ].name;
                                $::temp.gui.items.ench_0_level = ::DB.Shop.specialItems[ $(index) ].Enchants[ 0 ].level;
                                $::temp.gui.items.ench_1_name = ::DB.Shop.specialItems[ $(index) ].Enchants[ 1 ].name;
                                $::temp.gui.items.ench_1_level = ::DB.Shop.specialItems[ $(index) ].Enchants[ 1 ].level;
                                // roman_conv(ench_0_level, temp.gui.items);
                                // roman_conv(ench_1_level, temp.gui.items);
                                $::temp.gui.items.desc1 = ::DB.Shop.specialItems[ $(index) ].desc1;
                                $::temp.gui.items.desc2 = ::DB.Shop.specialItems[ $(index) ].desc2;
                                $$cost = ::DB.Shop.specialItems[ $(index) ].cost;
                                ::temp.gui.items.cost = $cost;
                                $sp = skills.player.sp:@p;
                                if ($cost > $sp) {
                                    ::temp.gui.items.sp_color = "§8";
                                } else {
                                    ::temp.gui.items.sp_color = "§6";
                                }
                            }

                            function set_item() {
                                // set avec param
                                $item replace entity @s container.$(slot) with $(item_repr)[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"$(item_name) §8§l♦ $(sp_color)$(cost) SP","italic":false}', lore = [ '[{"text":"Skills - $(type)","italic":false,"color":"blue"}]', '[{"text":"$(rarity)","italic":false,"color":"blue"}]', '[""]', '[{"text":"$(desc1)","italic":true,"color":"light_purple"}]', '[{"text":"$(desc2)","italic":true,"color":"light_purple"}]', '[""]', '["",{"text":"Click to buy!","italic":false,"color":"yellow"}]' ], enchantments = { $(ench_0_name):$(ench_0_level), $(ench_1_name):$(ench_1_level) } ];
                            }

                            function click() {
                                len_array($len_items, DB.Shop.specialItems);
                                Hardcode.repeatLists(
                                    [ "[start]", "[end]" ],
                                    () => {
                                        for ($slot = [ start ]; $slot < [ end ]; $slot++) {
                                            $len_items -= 1;
                                            if ($len_items < 0) { return 0; }
                                            ::temp.gui.items.del();
                                            ::temp.gui.items.slot = $slot;

                                            execute run {
                                                $execute unless data entity @s Items[ { Slot:$(slot)b } ] run {
                                                    ::temp.gui.items.id = $len_items;
                                                    GUI.Items.click_slot() with ::temp.gui.items;
                                                }
                                            } with ::temp.gui.items;
                                        }
                                    },
                                    [ ["1", "10", "19" ], [ "8", "17", "26" ]]
                                );
                            }

                            function click_slot() {
                                $::temp.gui.items.item_name = ::DB.Shop.specialItems[ $(id) ].item_name;
                                $::temp.gui.items.cost = ::DB.Shop.specialItems[ $(id) ].cost;
                                GUI.Items.buy() with ::temp.gui.items;
                            }

                            function buy() {
                                $sp = skills.player.sp:@p;
                                $scoreboard players set $cost skills.__variable__ $(cost);
                                len_inv($len_inv);
                                if ($sp < $cost) {
                                    execute run { $Text.tellraw(@p, "&<red, bold>Skills ♦ &<red>Not enough SP to buy $(item_name)&<red>."); } with ::temp.gui.items;
                                    playsound minecraft:entity.enderman.teleport ambient @p[ tag = skills.pref.sound ] ~ ~ ~ 1 1;
                                } else if ($len_inv > 34) {
                                    Text.tellraw(@p, "&<red, bold>Skills ♦ &<red>Inventory is full.");
                                    playsound minecraft:entity.enderman.teleport ambient @p[ tag = skills.pref.sound ] ~ ~ ~ 1 1;
                                } else {
                                    execute run {
                                        $Player.specialItems.give_from_id({ id: $(id) });
                                        $Text.tellraw(@p, "&<green, bold>Skills ♦ &<green>You bought $(item_name) &<green>for &<gold>&<$cost> SP&<green>.");
                                    } with ::temp.gui.items;
                                    playsound minecraft:block.note_block.pling ambient @p[ tag = skills.pref.sound ] ~ ~ ~ 1 2;
                                    skills.player.sp:@p -= $cost;
                                }
                            }
                        }

                        class Boosters {
                            function set_item() {
                                $item replace entity @s container.$(slot) with $(item)[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"x$(power) $(type) Booster §7- $(duration) min §8§l♦ $(sp_color)$(cost) SP","color":$(color),"italic":false}', lore = [ '[{"text":"Skills","color":"blue","italic":false}]', '[""]', '[{"text":"Click to buy!","color":"yellow","italic":false}]' ], enchantment_glint_override = $(glint) ];
                            }

                            function click() {
                                $sp = skills.player.sp:@p;
                                len_inv($invlen);
                                Hardcode.repeatLists(
                                    [ "[slot]", "[item]", "[power]", "[duration]", "[color]", "[cost]", "[type_int]", "[type]" ],
                                    () => {
                                        if (!data entity @s Items[ { Slot:[ slot ]b } ]) {
                                            if ($sp < [ cost ]) {
                                                Text.tellraw(@p, "&<red, bold>Skills ♦ &<red>Not enough SP to buy &<[color]>x[power] [type] Booster&<red>.");
                                                playsound minecraft:entity.enderman.teleport ambient @p[ tag = skills.pref.sound ] ~ ~ ~ 1 1;
                                            } else if ($invlen > 34) {
                                                Text.tellraw(@p, "&<red, bold>Skills ♦ &<red>Inventory is full.");
                                                playsound minecraft:entity.enderman.teleport ambient @p[ tag = skills.pref.sound ] ~ ~ ~ 1 1;
                                            } else {
                                                Player.Booster.give({ type_int: [ type_int ], type: "[type]", power: [ power ], duration: [ duration ], booster_color: "[color]", model: [ item ] });
                                                playsound minecraft:block.note_block.pling ambient @p[ tag = skills.pref.sound ] ~ ~ ~ 1 2;
                                                skills.player.sp:@p -= [ cost ];
                                                Text.tellraw(@p, "&<green, bold>Skills ♦ &<green>You bought a &<[color]>x[power] [type] Booster &<green>for &<gold>[cost] SP&<green>.");
                                            }
                                        }
                                    },
                                    [ ["10", "11", "12", "14", "15", "16" ], [ "experience_bottle", "experience_bottle", "experience_bottle", "gold_ingot", "gold_ingot", "gold_ingot" ], [ "2", "3", "5", "2", "5", "8" ], [ "15", "60", "120", "20", "30", "60" ], [ "aqua", "aqua", "aqua", "gold", "gold", "gold" ], [ "35", "50", "150", "50", "100", "200" ], [ "1", "1", "1", "2", "2", "2" ], [ "XP", "XP", "XP", "SP", "SP", "SP" ]]
                                );
                            }
                        }
                    }
