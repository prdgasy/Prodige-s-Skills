import 'Menu/Pages/Main.jmc';
import 'Menu/Pages/Progress.jmc';

class Menu.Pages {
    function 1() {
        Menu.Pages.Main.__set__();
    }

    function 2() {
        Menu.Pages.Progress.__set__();
    }

    function 3() {
        Menu.Pages.Tasks.__set__();
    }

    function 4() {
        // Preferences
        GUI.Mask.2();

        item replace entity @s container.21 with arrow[custom_data = { __namespace__: 1b }, custom_name = '{"text":"Go Back","color":"gray","italic":false}'];
        item replace entity @s container.23 with barrier[custom_data = { __namespace__: 1b }, custom_name = '{"text":"Close","color":"red","italic":false}'];
        JMC.put('execute as @p run loot replace entity @n[type=chest_minecart, tag=skillsLIB] container.22 loot {"type":"minecraft:command","pools":[{"rolls":1,"entries":[{"type":"minecraft:item","name":"minecraft:player_head","functions":[{"function":"minecraft:set_name","entity":"this","target":"custom_name","name":{"text":"Profile & Preferences","color":"light_purple","italic":false}},{"function":"minecraft:fill_player_head","entity":"this"},{"function":"minecraft:set_custom_data","tag":"{__namespace__: 1b}"},{"function":"minecraft:set_lore","entity":"this","lore":[{"text":"Manage your §6settings §fand view your","type":"text","color":"white","italic":false},{"text":"§6stats§r. Customize your experience!","type":"text","color":"white","italic":false}],"mode":"append"}],"conditions":[]}]}]}');
        item replace entity @s container.4 with paper[custom_data = { __namespace__: 1b }, custom_name = '["",{"text":"How to Change Preferences?","italic":false,"color":"yellow","bold":true}]', lore = ['["",{"text":"♦","italic":false,"bold":true,"color":"dark_gray"},{"text":" Click on any setting to toggle","italic":false,"color":"white"}]', '["",{"text":" it ","italic":false,"color":"white"},{"text":"on or off","italic":false,"color":"aqua"},{"text":".","italic":false,"color":"white"}]', '[""]', '["",{"text":"♦ ","italic":false,"bold":true,"color":"dark_gray"},{"text":"Your changes will ","italic":false,"color":"white"},{"text":"instantly","italic":false,"color":"gold"}]', '["",{"text":" apply—customize your experience","italic":false,"color":"white"}]', '["",{"text":" freely!","italic":false,"color":"white"}]']];
        ::temp.gui.pref.xp_notif = "§a§l✔";
        if (entity @p[ tag = !prodiges_skills.pref.xp_notif ]) { ::temp.gui.pref.xp_notif = "§c§l❌"; }

        ::temp.gui.pref.lvl_notif = "§a§l✔";
        if (entity @p[ tag = !prodiges_skills.pref.lvl_notif ]) { ::temp.gui.pref.lvl_notif = "§c§l❌"; }

        ::temp.gui.pref.skill_prog = "§a§l✔";
        if (entity @p[ tag = !prodiges_skills.pref.skill_prog ]) { ::temp.gui.pref.skill_prog = "§c§l❌"; }

        ::temp.gui.pref.lvl_broadcast = "§a§l✔";
        if (entity @p[ tag = !prodiges_skills.pref.lvl_broadcast ]) { ::temp.gui.pref.lvl_broadcast = "§c§l❌"; }

        ::temp.gui.pref.sound = "§a§l✔";
        if (entity @p[ tag = !prodiges_skills.pref.sound ]) { ::temp.gui.pref.sound = "§c§l❌"; }

        execute run {
            $item replace entity @s container.11 with ender_eye[custom_data = { __namespace__: 1b }, custom_name = '["",{"text":"Level Up Broadcast.","italic":false,"color":"light_purple"},{"text":" ","italic":false},{"text":"[","italic":false,"color":"gray"},{"text":"$(lvl_broadcast)","italic":false},{"text":"]","italic":false,"color":"gray"}]', lore = ['["",{"text":"Toggle broadcast of ","italic":false,"color":"white"},{"text":"level-up","italic":false,"color":"gold"}]', '["",{"text":"messages","italic":false,"color":"gold"},{"text":" to all players.","italic":false,"color":"white"}]', '["",{"text":"Let everyone know when you level","italic":false,"color":"gray"}]', '["",{"text":"up your skills with a public","italic":false,"color":"gray"}]', '["",{"text":"announcement!","italic":false,"color":"gray"}]', '[""]', '["",{"text":"Click to toggle!","italic":false,"color":"yellow"}]']];
            $item replace entity @s container.12 with bell[custom_data = { __namespace__: 1b }, custom_name = '["",{"text":"XP Notifications","italic":false,"color":"light_purple"},{"text":" ","italic":false,"color":"yellow"},{"text":"[","italic":false,"color":"gray"},{"text":"$(xp_notif)","italic":false},{"text":"]","italic":false,"color":"gray"}]', lore = ['["",{"text":"Toggle notifications for ","italic":false,"color":"white"},{"text":"XP gains","italic":false,"color":"gold"},{"text":".","italic":false,"color":"white"}]', '["",{"text":"Stay informed when you progress!","italic":false,"color":"gray"}]', '[""]', '["",{"text":"Click to toggle!","italic":false,"color":"yellow"}]']];
            $item replace entity @s container.13 with fire_charge[custom_data = { __namespace__: 1b }, custom_name = '["",{"text":"Level-Up Notification","italic":false,"color":"light_purple"},{"text":" ","italic":false,"color":"yellow"},{"text":"[","italic":false,"color":"gray"},{"text":"$(lvl_notif)","italic":false},{"text":"]","italic":false,"color":"gray"}]', lore = ['["",{"text":"Toggle ","italic":false,"color":"white"},{"text":"level-up","italic":false,"color":"gold"},{"text":" notifications.","italic":false,"color":"white"}]', '["",{"text":"Receive a visual cue and a sound","italic":false,"color":"gray"}]', '["",{"text":"effect every time you level up!","italic":false,"color":"gray"}]', '[""]', '["",{"text":"Click to toggle!","italic":false,"color":"yellow"}]']];
            $item replace entity @s container.14 with note_block[custom_data = { __namespace__: 1b }, custom_name = '["",{"text":"Sound Effects ","italic":false,"color":"light_purple"},{"text":"[","italic":false,"color":"gray"},{"text":"$(sound)","italic":false},{"text":"]","italic":false,"color":"gray"}]', lore = ['["",{"text":"Manage the in-game ","italic":false,"color":"white"},{"text":"sound effects","italic":false,"color":"gold"},{"text":".","italic":false,"color":"white"}]', '["",{"text":"Enhance your gaming experience","italic":false,"color":"gray"}]', '["",{"text":"or reduce distractions!","italic":false,"color":"gray"}]', '[""]', '["",{"text":"Click to toggle!","italic":false,"color":"yellow"}]', '["",{"text":" ","italic":false}]']];
            $item replace entity @s container.15 with minecraft:totem_of_undying[custom_data = { __namespace__: 1b }, custom_name = '["",{"text":"Skill Progression","italic":false,"color":"light_purple"},{"text":" ","italic":false},{"text":"[","italic":false,"color":"gray"},{"text":"$(skill_prog)","italic":false},{"text":"]","italic":false,"color":"gray"}]', lore = ['["",{"text":"Toggle ","italic":false,"color":"white"},{"text":"skill progression","italic":false,"color":"gold"},{"text":" on or","italic":false,"color":"white"}]', '["",{"text":"off.","italic":false,"color":"white"}]', '["",{"text":"Disable skill leveling temporarily","italic":false,"color":"gray"}]', '["",{"text":"if you want to pause your growth!","italic":false,"color":"gray"}]', '[""]', '["",{"text":"Click to toggle!","italic":false,"color":"yellow"}]']];
        } with ::temp.gui.pref;
    }

    function 5() {
        // Shop
        GUI.Mask.2();

        item replace entity @s container.21 with arrow[custom_data = { __namespace__: 1b }, custom_name = '{"text":"Go Back","color":"gray","italic":false}'];
        item replace entity @s container.23 with barrier[custom_data = { __namespace__: 1b }, custom_name = '{"text":"Close","color":"red","italic":false}'];
        item replace entity @s container.22 with player_head[ profile = { id:[ I; 1434832075, -102998962, -1229628019, 1369636598 ], properties:[ { name:"textures", value:"eyJ0ZXh0dXJlcyI6eyJTS0lOIjp7InVybCI6Imh0dHA6Ly90ZXh0dXJlcy5taW5lY3JhZnQubmV0L3RleHR1cmUvNTRjZGZiODhjZjhjMzY1NjMwNDI1NGU0ZDY3YTBhYjAyZjZkMjdjNzlmMWIxZTQwNGRjM2E3Y2U0ZWIyZGUwMCJ9fX0=" } ] }, custom_data = { __namespace__: 1b }, custom_name = '["",{"text":"Shop","italic":false,"color":"green"}]', lore = ['["",{"text":"Buy ","italic":false,"color":"white"},{"text":"boosters","italic":false,"color":"gold"},{"text":", ","italic":false,"color":"white"},{"text":"XP","italic":false,"color":"gold"},{"text":", ","italic":false,"color":"white"},{"text":"prestige","italic":false,"color":"gold"},{"text":", and","italic":false,"color":"white"}]', '["",{"text":"more! Unlock exclusive perks to","italic":false,"color":"white"}]', '["",{"text":"enhance your gameplay experience!","italic":false,"color":"white"}]']];
        // Profile & Preferences

        ::temp.gui.profile.sp = prodiges_skills.player.sp:@p;

        ::temp.gui.profile.booster_xp = "§c-";
        $xp_duration = prodiges_skills.booster.1.duration:@p;
        if ($xp_duration > 1) {
            ::temp.gui.profile.booster_xp_duration = $xp_duration;
            ::temp.gui.profile.booster_xp_power = prodiges_skills.booster.1.power:@p;

            execute run {
                $::temp.gui.profile.booster_xp = "§bx$(booster_xp_power) XP Booster §7- $(booster_xp_duration) minute(s) left";
            } with ::temp.gui.profile;
        }

        ::temp.gui.profile.booster_sp = "§c-";
        $sp_duration = prodiges_skills.booster.2.duration:@p;
        if ($sp_duration > 1) {
            ::temp.gui.profile.booster_sp_duration = $sp_duration;
            ::temp.gui.profile.booster_sp_power = prodiges_skills.booster.2.power:@p;

            execute run {
                $::temp.gui.profile.booster_sp = "§6x$(booster_sp_power) Skill Point Booster §7- $(booster_sp_duration) minute(s) left";
            } with ::temp.gui.profile;
        }

        execute run {
            // JMC.put('$execute as @p run loot replace entity @n[type=chest_minecart, tag=skillsLIB] container.4 loot {"type":"minecraft:command","pools":[{"rolls":1,"entries":[{"type":"minecraft:item","name":"minecraft:player_head","functions":[{"function":"minecraft:set_name","entity":"this","target":"custom_name","name":{"text":"Profile","color":"light_purple","italic":false}},{"function":"minecraft:fill_player_head","entity":"this"},{"function":"minecraft:set_custom_data","tag":"{__namespace__: 1b}"},{"function":"minecraft:set_lore","entity":"this","lore":[{"text":""},{"text":"§8§l♦ §rPoints: ","type":"text","extra":[{"text":"$(sp) SP","type":"text","color":"gold","italic":false}],"color":"green","italic":false},{"text":""},{"text":"Active Boosters:","color":"yellow","italic":false},{"text":"§8• $(booster_xp)","italic":false},{"text":"§8• $(booster_sp)","italic":false}],"mode":"append"}],"conditions":[]}]}]}');
        } with ::temp.gui.profile;
        // Items
        $mod = prodiges_skills.gui.shop.boost_state:@s;
        $mod %= 4;
        switch($mod) {
            case 0: ::temp.gui.shop.model = "minecraft:diamond_sword";
            case 1: ::temp.gui.shop.model = "minecraft:iron_pickaxe";
            case 2: ::temp.gui.shop.model = "minecraft:leather_helmet";
            case 3: ::temp.gui.shop.model = "minecraft:golden_chestplate";
        }
        execute run {
            $item replace entity @s container.11 with stone[ item_model = "$(model)", custom_data = { __namespace__: 1b }, custom_name = '{"text":"Special Items","color":"aqua","italic":false}', lore = ['["",{"text":"Browse and purchase ","italic":false,"color":"white"},{"text":"exclusive","italic":false,"color":"light_purple"}]', '["",{"text":"tools ","italic":false,"color":"light_purple"},{"text":"and","italic":false,"color":"white"},{"text":" armor","italic":false,"color":"light_purple"},{"text":".","italic":false,"color":"white"}]', '["",{"text":"Unlock powerful gear!","italic":false,"color":"gray"}]', '[""]', '["",{"text":"Click to view!","italic":false,"color":"yellow"}]']];
        } with ::temp.gui.shop;
        // Skill Crate
        ::temp.gui.shop.cooldown = prodiges_skills.crate.cooldown:@p;
        if (prodiges_skills.crate.cooldown:@p > 0) {
            execute run { $::temp.gui.shop.crate_state = "§7You are still on a cooldown! ($(cooldown) minute(s))"; } with ::temp.gui.shop;
            ::temp.gui.shop.crate_color = "red";
            ::temp.gui.shop.profile = { id:[ I; -1082168181, 1071530784, -1128679516, -2846883 ], properties:[ { name:"textures", value:"eyJ0ZXh0dXJlcyI6eyJTS0lOIjp7InVybCI6Imh0dHA6Ly90ZXh0dXJlcy5taW5lY3JhZnQubmV0L3RleHR1cmUvZWJjZGYwZmYwNzEyYWUzZGU1NTRjMzcyNjA3NzYxMDAwZDNiMGI2Yjg2MTNiOGEyYzZkZGEwMGNkMTBkNzhkOCJ9fX0=" } ] };
        } else {
            ::temp.gui.shop.crate_state = "§eClick to open!";
            ::temp.gui.shop.crate_color = "light_purple";
            ::temp.gui.shop.profile = { id:[ I; 1747670542, -1865006816, -1902654712, 1202578603 ], properties:[ { name:"textures", value:"eyJ0ZXh0dXJlcyI6eyJTS0lOIjp7InVybCI6Imh0dHA6Ly90ZXh0dXJlcy5taW5lY3JhZnQubmV0L3RleHR1cmUvY2MxYjJmNTkyY2ZjOGQzNzJkY2Y1ZmQ0NGVlZDY5ZGRkYzY0NjAxZDc4NDZkNzI2MTlmNzA1MTFkODA0M2E4OSJ9fX0=" } ] };
        }
        execute run {
            $item replace entity @s container.13 with player_head[custom_data = { __namespace__: 1b }, custom_name = '{"text":"Skill Crate","color":"$(crate_color)","italic":false}', lore = ['["",{"text":"Open special crates to obtain","italic":false,"color":"white"}]', '["",{"text":"unique tools","italic":false,"color":"gold"},{"text":" and ","italic":false,"color":"white"},{"text":"boosters","italic":false,"color":"aqua"},{"text":",","italic":false,"color":"white"}]', '["",{"text":"and ","italic":false,"color":"white"},{"text":"loot","italic":false,"color":"light_purple"},{"text":".","italic":false,"color":"white"}]', '["",{"text":"(i) You have 1 free crate","italic":false,"color":"gray"}]', '{"text":"every hour!","italic":false,"color":"gray"}', '[""]', '["",{"text":"$(crate_state)","italic":false}]'], profile = $(profile) ];
        } with ::temp.gui.shop;
        // Boosters
        $mod = prodiges_skills.gui.shop.boost_state:@s;
        $mod %= 2;
        if ($mod == 1) {
            ::temp.gui.shop.booster_item = "experience_bottle";
        } else {
            ::temp.gui.shop.booster_item = "gold_ingot";
        }

        execute run {
            $item replace entity @s container.15 with $(booster_item)[custom_data = { __namespace__: 1b }, custom_name = '["",{"text":"Boosters","italic":false,"color":"green"}]', lore = ['[{"text":"Boosters temporarily ","italic":false,"color":"white"},{"text":"increase","italic":false,"color":"gold"}]', '["",{"text":"your XP or Skill Point","italic":false,"color":"gold"},{"text":" gain.","italic":false,"color":"white"}]', '[{"text":"Speed up your progressoin!","italic":false,"color":"gray"}]', '[""]', '{"text":"Click to view!","italic":false,"color":"yellow"}'], enchantment_glint_override = true ];
        } with ::temp.gui.shop;
    }

    function 6() {
        // Settings Global
        GUI.Mask.3();

        item replace entity @s container.21 with arrow[custom_data = { __namespace__: 1b }, custom_name = '{"text":"Go Back","color":"gray","italic":false}'];
        item replace entity @s container.23 with barrier[custom_data = { __namespace__: 1b }, custom_name = '{"text":"Close","color":"red","italic":false}'];
        item replace entity @s container.22 with command_block[custom_data = { __namespace__: 1b }, custom_name = '["",{"text":"Configuration Panel","italic":false,"color":"red"}]', lore = ['["",{"text":"Modify all server-wide settings","italic":false,"color":"white"}]', '["",{"text":"here.","italic":false,"color":"white"}]']];

        item replace entity @s container.11 with carrot[custom_data = { __namespace__: 1b }, custom_name = '["",{"text":"Rewards","italic":false,"color":"red"}]', lore = ['["",{"text":"Configure the rewards players","italic":false,"color":"white"}]', '["",{"text":"receive when they level up their","italic":false,"color":"white"}]', '["",{"text":"prodiges_skills.","italic":false,"color":"white"}]', '[""]', '["",{"text":"Click to see how!","italic":false,"color":"yellow"}]']];
        item replace entity @s container.12 with minecraft:experience_bottle[custom_data = { __namespace__: 1b }, custom_name = '["",{"text":"XP from Tasks","italic":false,"color":"red"}]', lore = ['["",{"text":"Adjust the amount of XP players","italic":false,"color":"white"}]', '["",{"text":"earn from completing each tasks.","italic":false,"color":"white"}]', '[""]', '["",{"text":"Click to see how!","italic":false,"color":"yellow"}]']];
        item replace entity @s container.13 with gold_nugget[custom_data = { __namespace__: 1b }, custom_name = '["",{"text":"Points per Task","italic":false,"color":"red"}]', lore = ['["",{"text":"Set the number of Skill Points players","italic":false,"color":"white"}]', '[{"text":"gain for each task they complete.","italic":false,"color":"white"}]', '[""]', '["",{"text":"Click to see how!","italic":false,"color":"yellow"}]']];
        item replace entity @s container.14 with wooden_pickaxe[custom_data = { __namespace__: 1b }, custom_name = '["",{"text":"Add Tasks","italic":false,"color":"red"}]', lore = ['["",{"text":"Add new tasks to the skill","italic":false,"color":"white"}]', '["",{"text":"system.","italic":false,"color":"white"}]', '[""]', '["",{"text":"Click to see how!","italic":false,"color":"yellow"}]'], !attribute_modifiers ];
        item replace entity @s container.15 with hopper[custom_data = { __namespace__: 1b }, custom_name = '["",{"text":"Reset Everyone\'s Skills","italic":false,"color":"red"}]', lore = ['["",{"text":"Reset the skills of all players","italic":false,"color":"white"}]', '["",{"text":"on the server.","italic":false,"color":"white"}]', '[""]', '["",{"text":"Click to see how!","italic":false,"color":"yellow"}]']];



    }

    function 7() {
        // Prestige
        GUI.Mask.1();

        item replace entity @s container.21 with arrow[custom_data = { __namespace__: 1b }, custom_name = '{"text":"Go Back","color":"gray","italic":false}'];
        item replace entity @s container.22 with netherite_scrap[custom_data = { __namespace__: 1b }, custom_name = '["",{"text":"Prestiges","italic":false,"color":"dark_purple"}]', lore = ['[{"text":"Once you reach ","italic":false,"color":"white"},{"text":"level","italic":false,"color":"gold"},{"text":" ","italic":false,"color":"white"},{"text":"100","italic":false},{"text":" (C) in a","italic":false,"color":"white"}]', '["",{"text":"skill, you can reset it to gain","italic":false,"color":"white"}]', '["",{"text":"a ","italic":false,"color":"white"},{"text":"permanent bonus","italic":false,"color":"green"},{"text":"!","italic":false,"color":"white"}]', '[{"text":"Grow even stronger over time!","italic":false,"color":"gray"}]'], enchantment_glint_override = true ];
        item replace entity @s container.23 with barrier[custom_data = { __namespace__: 1b }, custom_name = '{"text":"Close","color":"red","italic":false}'];
        item replace entity @s container.4 with paper[custom_data = { __namespace__: 1b }, custom_name = '["",{"text":"How to Choose a Skill to Prestige","italic":false,"color":"yellow","bold":true}]', lore = ['["",{"text":"To choose, click on the skill you","italic":false,"color":"white"}]', '["",{"text":"want to reset (with level 100).","italic":false,"color":"white"}]', '[""]', '["",{"text":"You\'ll gain a bonus and a special","italic":false,"color":"white"}]', '["",{"text":"title upon prestiging.","italic":false,"color":"white"}]']];

        $slot = 11;
        for ($index = 0; $index < __skillsLength__; $index++) {
            ::temp.gui.prestige.index = $index;
            execute run { $::temp.gui.prestige.name = ::DB.Indexes.$(index); } with ::temp.gui.prestige;

            execute run {
                ::temp.gui.prestige.slot = $slot;

                $::temp.gui.prestige.name = ::DB.prodiges_skills.$(name).name;
                $::temp.gui.prestige.item = ::DB.prodiges_skills.$(name).item;
                $::temp.gui.prestige.desc1 = ::DB.prodiges_skills.$(name).desc1;
                $::temp.gui.prestige.desc2 = ::DB.prodiges_skills.$(name).desc2;
                $::temp.gui.prestige.ability_desc1 = ::DB.prodiges_skills.$(name).prestige.ability_desc1;
                $::temp.gui.prestige.ability_desc2 = ::DB.prodiges_skills.$(name).prestige.ability_desc2;
                $::temp.gui.prestige.ability = ::DB.prodiges_skills.$(name).prestige.ability;

                $scoreboard players operation $lvl prodiges_skills.__variable__ = @p prodiges_skills.$(name).lvl;
                $scoreboard players operation $prestige_lvl prodiges_skills.__variable__ = @p prodiges_skills.$(name).prestige;

                $prestige_power = $prestige_lvl;
                $prestige_power *= 5;
                ::temp.gui.prestige.power = $prestige_power;
                ::temp.gui.prestige.lvl_int = $lvl;
                ::temp.gui.prestige.lvl = $lvl;
                RomanConverter.toRoman(lvl, temp.gui.prestige);

                ::temp.gui.prestige.prestige_lvl = $prestige_lvl;
                RomanConverter.toRoman(prestige_lvl, temp.gui.prestige);

                $prestige_lvl += 1;
                ::temp.gui.prestige.prestige_next = $prestige_lvl;
                RomanConverter.toRoman(prestige_next, temp.gui.prestige);
                $prestige_power = $prestige_lvl;
                $prestige_power *= 5;
                ::temp.gui.prestige.power_next = $prestige_power;

                ::temp.gui.prestige.color_1 = "gray";
                ::temp.gui.prestige.color_2 = "dark_gray";
                ::temp.gui.prestige.glint = "false";
                $execute if score @p prodiges_skills.$(name).lvl matches 100 run {
                    ::temp.gui.prestige.color_1 = "light_purple";
                    ::temp.gui.prestige.color_2 = "dark_purple";
                    ::temp.gui.prestige.glint = "true";
                }

                $execute if score @p prodiges_skills.$(name).prestige matches ..4 run GUI.Macro.prestige_set() with ::temp.gui.prestige;

                $execute if score @p prodiges_skills.$(name).prestige matches 5 run GUI.Macro.prestige_set_max() with ::temp.gui.prestige;
            } with ::temp.gui.prestige;

            $slot++;
        }
    }

    function 8() {
        // Special Items
        GUI.Mask.2();
        item replace entity @s container.0 with arrow[custom_data = { __namespace__: 1b }, custom_name = '{"text":"Go Back","color":"gray","italic":false}'];
        item replace entity @s container.9 with stone[ item_model = "minecraft:leather_helmet", custom_data = { __namespace__: 1b }, custom_name = '{"text":"Special Items","color":"aqua","italic":false}', lore = ['["",{"text":"Browse and purchase ","italic":false,"color":"white"},{"text":"exclusive","italic":false,"color":"light_purple"}]', '["",{"text":"tools ","italic":false,"color":"light_purple"},{"text":"and","italic":false,"color":"white"},{"text":" armor","italic":false,"color":"light_purple"},{"text":".","italic":false,"color":"white"}]', '["",{"text":"Unlock powerful gear!","italic":false,"color":"gray"}]']];
        item replace entity @s container.18 with barrier[custom_data = { __namespace__: 1b }, custom_name = '{"text":"Close","color":"red","italic":false}'];

        len_array($len_items, DB.Shop.specialItems);
        Hardcode.repeatLists(
            [ "[start]", "[end]" ],
            () => {
                for ($slot = [ start ]; $slot < [ end ]; $slot++) {
                    $len_items -= 1;
                    if ($len_items < 0) { return 0; }
                    ::temp.gui.items.del();
                    ::temp.gui.items.slot = $slot;
                    ::temp.gui.items.index = $len_items;

                    GUI.Items.set_param() with ::temp.gui.items;
                    GUI.items.set_item() with ::temp.gui.items;
                }
            },
            [ ["1", "10", "19" ], [ "8", "17", "26" ]]
        );
    }

    function 9() {
        // Boosters
        GUI.Mask.2();
        item replace entity @s container.21 with arrow[custom_data = { __namespace__: 1b }, custom_name = '{"text":"Go Back","color":"gray","italic":false}'];
        item replace entity @s container.22 with experience_bottle[custom_data = { __namespace__: 1b }, custom_name = '["",{"text":"Boosters","italic":false,"color":"green"}]', lore = ['[{"text":"Boosters temporarily ","italic":false,"color":"white"},{"text":"increase","italic":false,"color":"gold"}]', '["",{"text":"your XP or Skill Point","italic":false,"color":"gold"},{"text":" gain.","italic":false,"color":"white"}]', '[{"text":"Speed up your progressoin!","italic":false,"color":"gray"}]'], enchantment_glint_override = true ];
        item replace entity @s container.23 with barrier[custom_data = { __namespace__: 1b }, custom_name = '{"text":"Close","color":"red","italic":false}'];
        // Profile & Preferences

        ::temp.gui.profile.sp = prodiges_skills.player.sp:@p;

        ::temp.gui.profile.booster_xp = "§c-";
        $xp_duration = prodiges_skills.booster.1.duration:@p;
        if ($xp_duration > 1) {
            ::temp.gui.profile.booster_xp_duration = $xp_duration;
            ::temp.gui.profile.booster_xp_power = prodiges_skills.booster.1.power:@p;

            execute run {
                $::temp.gui.profile.booster_xp = "§bx$(booster_xp_power) XP Booster §7- $(booster_xp_duration) minute(s) left";
            } with ::temp.gui.profile;
        }

        ::temp.gui.profile.booster_sp = "§c-";
        $sp_duration = prodiges_skills.booster.2.duration:@p;
        if ($sp_duration > 1) {
            ::temp.gui.profile.booster_sp_duration = $sp_duration;
            ::temp.gui.profile.booster_sp_power = prodiges_skills.booster.2.power:@p;

            execute run {
                $::temp.gui.profile.booster_sp = "§6x$(booster_sp_power) Skill Point Booster §7- $(booster_sp_duration) minute(s) left";
            } with ::temp.gui.profile;
        }

        execute run {
            JMC.put('$execute as @p run loot replace entity @n[type=chest_minecart, tag=skillsLIB] container.4 loot {"type":"minecraft:command","pools":[{"rolls":1,"entries":[{"type":"minecraft:item","name":"minecraft:player_head","functions":[{"function":"minecraft:set_name","entity":"this","target":"custom_name","name":{"text":"Profile","color":"light_purple","italic":false}},{"function":"minecraft:fill_player_head","entity":"this"},{"function":"minecraft:set_custom_data","tag":"{__namespace__: 1b}"},{"function":"minecraft:set_lore","entity":"this","lore":[{"text":""},{"text":"§8§l♦ §rPoints: ","type":"text","extra":[{"text":"$(sp) SP","type":"text","color":"gold","italic":false}],"color":"#A888B5","italic":false},{"text":""},{"text":"Active Boosters:","color":"yellow","italic":false},{"text":"§8• $(booster_xp)","italic":false},{"text":"§8• $(booster_sp)","italic":false}],"mode":"append"}],"conditions":[]}]}]}');
        } with ::temp.gui.profile;

        Hardcode.repeatLists(
            [ "[slot]", "[item]", "[power]", "[duration]", "[color]", "[cost]", "[type]" ],
            () => {
                if ($sp > [ cost ]) {
                    ::temp.gui.Boosters.glint = true;
                    ::temp.gui.Boosters.sp_color = "§6";
                } else {
                    ::temp.gui.Boosters.glint = false;
                    ::temp.gui.Boosters.sp_color = "§8";
                }
                ::temp.gui.Boosters.color = "[color]";
                ::temp.gui.Boosters.slot = [ slot ];
                ::temp.gui.Boosters.power = [ power ];
                ::temp.gui.Boosters.duration = [ duration ];
                ::temp.gui.Boosters.item = "[item]";
                ::temp.gui.Boosters.cost = [ cost ];
                ::temp.gui.Boosters.type = "[type]";
                GUI.Boosters.set_item() with ::temp.gui.Boosters;
            },
            [ ["10", "11", "12", "14", "15", "16" ], [ "experience_bottle", "experience_bottle", "experience_bottle", "gold_ingot", "gold_ingot", "gold_ingot" ], [ "2", "3", "5", "2", "5", "8" ], [ "15", "60", "120", "20", "30", "60" ], [ "aqua", "aqua", "aqua", "gold", "gold", "gold" ], [ "35", "50", "150", "50", "100", "200" ], [ "XP", "XP", "XP", "SP", "SP", "SP" ]]
        );
    }
}