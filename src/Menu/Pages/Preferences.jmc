class Menu.Pages.Preferences {
    @lazy function togglePref(tag) {
        if (entity @p[tag = prodiges_skills.pref.$tag]) {
            tag @p remove prodiges_skills.pref.$tag;
        } else {
            tag @p add prodiges_skills.pref.$tag;
        }
        playsound minecraft:entity.arrow.hit_player ambient @p[tag = prodiges_skills.pref.sound] ~ ~ ~ 1 0;
    }

    function __set__() {
        Menu.Mask.default();

        item replace entity @s container.21 with arrow[custom_data = { __namespace__: 1b }, custom_name = '{"text":"Go Back","color":"gray","italic":false}'];
        item replace entity @s container.23 with barrier[custom_data = { __namespace__: 1b }, custom_name = '{"text":"Close","color":"red","italic":false}'];

        // Player profile info
        JMC.put('execute as @p run loot replace entity @n[type=chest_minecart, tag=skillsLIB] container.22 loot {"type":"minecraft:command","pools":[{"rolls":1,"entries":[{"type":"minecraft:item","name":"minecraft:player_head","functions":[{"function":"minecraft:set_name","entity":"this","target":"custom_name","name":{"text":"Profile & Preferences","color":"light_purple","italic":false}},{"function":"minecraft:fill_player_head","entity":"this"},{"function":"minecraft:set_custom_data","tag":"{__namespace__: 1b}"},{"function":"minecraft:set_lore","entity":"this","lore":[{"text":"Manage your §6settings §fand view your","type":"text","color":"white","italic":false},{"text":"§6stats§r. Customize your experience!","type":"text","color":"white","italic":false}],"mode":"append"}],"conditions":[]}]}]}');

        // How to change preferences
        item replace entity @s container.4 with paper[custom_data = { __namespace__: 1b }, custom_name = '["",{"text":"How to Change Preferences?","italic":false,"color":"yellow","bold":true}]', lore = ['["",{"text":"♦","italic":false,"bold":true,"color":"dark_gray"},{"text":" Click on any setting to toggle","italic":false,"color":"white"}]', '["",{"text":" it ","italic":false,"color":"white"},{"text":"on or off","italic":false,"color":"aqua"},{"text":".","italic":false,"color":"white"}]', '[""]', '["",{"text":"♦ ","italic":false,"bold":true,"color":"dark_gray"},{"text":"Your changes will ","italic":false,"color":"white"},{"text":"instantly","italic":false,"color":"gold"}]', '["",{"text":" apply—customize your experience","italic":false,"color":"white"}]', '["",{"text":" freely!","italic":false,"color":"white"}]']];




        Menu.Pages.Preferences.fillPrefs() with ::Menu.Pages.Preferences;
    }

    function getPlayerPrefs() {
        ::Menu.Pages.Preferences.xpNotif = "§a§l✔";
        if (entity @p[tag = !prodiges_skills.pref.xpNotif]) { ::Menu.Pages.Preferences.xpNotif = "§c§l❌"; }

        ::Menu.Pages.Preferences.lvlNotif = "§a§l✔";
        if (entity @p[tag = !prodiges_skills.pref.lvlNotif]) { ::Menu.Pages.Preferences.lvlNotif = "§c§l❌"; }

        ::Menu.Pages.Preferences.skillProgression = "§a§l✔";
        if (entity @p[tag = !prodiges_skills.pref.skillProgression]) { ::Menu.Pages.Preferences.skillProgression = "§c§l❌"; }

        ::Menu.Pages.Preferences.lvlBroadcast = "§a§l✔";
        if (entity @p[tag = !prodiges_skills.pref.lvlBroadcast]) { ::Menu.Pages.Preferences.lvlBroadcast = "§c§l❌"; }

        ::Menu.Pages.Preferences.sound = "§a§l✔";
        if (entity @p[tag = !prodiges_skills.pref.sound]) { ::Menu.Pages.Preferences.sound = "§c§l❌"; }
    }

    function fillPrefs() {
        $item replace entity @s container.11 with ender_eye[custom_data = { __namespace__: 1b }, custom_name = '["",{"text":"Level Up Broadcast.","italic":false,"color":"light_purple"},{"text":" ","italic":false},{"text":"[","italic":false,"color":"gray"},{"text":"$(lvlBroadcast)","italic":false},{"text":"]","italic":false,"color":"gray"}]', lore = ['["",{"text":"Toggle broadcast of ","italic":false,"color":"white"},{"text":"level-up","italic":false,"color":"gold"}]', '["",{"text":"messages","italic":false,"color":"gold"},{"text":" to all players.","italic":false,"color":"white"}]', '["",{"text":"Let everyone know when you level","italic":false,"color":"gray"}]', '["",{"text":"up your skills with a public","italic":false,"color":"gray"}]', '["",{"text":"announcement!","italic":false,"color":"gray"}]', '[""]', '["",{"text":"Click to toggle!","italic":false,"color":"yellow"}]']];
        $item replace entity @s container.12 with bell[custom_data = { __namespace__: 1b }, custom_name = '["",{"text":"XP Notifications","italic":false,"color":"light_purple"},{"text":" ","italic":false,"color":"yellow"},{"text":"[","italic":false,"color":"gray"},{"text":"$(xpNotif)","italic":false},{"text":"]","italic":false,"color":"gray"}]', lore = ['["",{"text":"Toggle notifications for ","italic":false,"color":"white"},{"text":"XP gains","italic":false,"color":"gold"},{"text":".","italic":false,"color":"white"}]', '["",{"text":"Stay informed when you progress!","italic":false,"color":"gray"}]', '[""]', '["",{"text":"Click to toggle!","italic":false,"color":"yellow"}]']];
        $item replace entity @s container.13 with fire_charge[custom_data = { __namespace__: 1b }, custom_name = '["",{"text":"Level-Up Notification","italic":false,"color":"light_purple"},{"text":" ","italic":false,"color":"yellow"},{"text":"[","italic":false,"color":"gray"},{"text":"$(lvlNotif)","italic":false},{"text":"]","italic":false,"color":"gray"}]', lore = ['["",{"text":"Toggle ","italic":false,"color":"white"},{"text":"level-up","italic":false,"color":"gold"},{"text":" notifications.","italic":false,"color":"white"}]', '["",{"text":"Receive a visual cue and a sound","italic":false,"color":"gray"}]', '["",{"text":"effect every time you level up!","italic":false,"color":"gray"}]', '[""]', '["",{"text":"Click to toggle!","italic":false,"color":"yellow"}]']];
        $item replace entity @s container.14 with note_block[custom_data = { __namespace__: 1b }, custom_name = '["",{"text":"Sound Effects ","italic":false,"color":"light_purple"},{"text":"[","italic":false,"color":"gray"},{"text":"$(sound)","italic":false},{"text":"]","italic":false,"color":"gray"}]', lore = ['["",{"text":"Manage the in-game ","italic":false,"color":"white"},{"text":"sound effects","italic":false,"color":"gold"},{"text":".","italic":false,"color":"white"}]', '["",{"text":"Enhance your gaming experience","italic":false,"color":"gray"}]', '["",{"text":"or reduce distractions!","italic":false,"color":"gray"}]', '[""]', '["",{"text":"Click to toggle!","italic":false,"color":"yellow"}]', '["",{"text":" ","italic":false}]']];
        $item replace entity @s container.15 with minecraft:totem_of_undying[custom_data = { __namespace__: 1b }, custom_name = '["",{"text":"Skill Progression","italic":false,"color":"light_purple"},{"text":" ","italic":false},{"text":"[","italic":false,"color":"gray"},{"text":"$(skillProgression)","italic":false},{"text":"]","italic":false,"color":"gray"}]', lore = ['["",{"text":"Toggle ","italic":false,"color":"white"},{"text":"skill progression","italic":false,"color":"gold"},{"text":" on or","italic":false,"color":"white"}]', '["",{"text":"off.","italic":false,"color":"white"}]', '["",{"text":"Disable skill leveling temporarily","italic":false,"color":"gray"}]', '["",{"text":"if you want to pause your growth!","italic":false,"color":"gray"}]', '[""]', '["",{"text":"Click to toggle!","italic":false,"color":"yellow"}]']];
    }
}