class Menu.Pages.ItemShop {
    function setParam() {
        $::Menu.Pages.ItemShop.type = ::Config.Shop.specialItems[$(index)].type;
        $::Menu.Pages.ItemShop.itemName = ::Config.Shop.specialItems[$(index)].itemName;
        $::Menu.Pages.ItemShop.itemRepr = ::Config.Shop.specialItems[$(index)].itemRepr;
        $::Menu.Pages.ItemShop.enchantName0 = ::Config.Shop.specialItems[$(index)].Enchants[0].name;
        $::Menu.Pages.ItemShop.enchantLevel0 = ::Config.Shop.specialItems[$(index)].Enchants[0].level;
        $::Menu.Pages.ItemShop.enchantName1 = ::Config.Shop.specialItems[$(index)].Enchants[1].name;
        $::Menu.Pages.ItemShop.enchantLevel1 = ::Config.Shop.specialItems[$(index)].Enchants[1].level;
        ::Menu.Pages.ItemShop.enchantLevel0 = RomanConverter.toRoman(::Menu.Pages.ItemShop.enchantLevel0);
        ::Menu.Pages.ItemShop.enchantLevel1 = RomanConverter.toRoman(::Menu.Pages.ItemShop.enchantLevel1);

        $::Menu.Pages.ItemShop.lore1 = ::Config.Shop.specialItems[$(index)].lore1;
        $::Menu.Pages.ItemShop.lore2 = ::Config.Shop.specialItems[$(index)].lore2;
        $$cost = ::Config.Shop.specialItems[$(index)].cost;
        ::Menu.Pages.ItemShop.cost = $cost;
        $points = prodiges_skills.PPoints:@p;
        if ($cost > $points) {
            // Cannot buy
            ::Menu.Pages.ItemShop.pointsColor = "§8";
        } else {
            ::Menu.Pages.ItemShop.pointsColor = "§6";
        }
    }

    function setItem() {
        // set avec param
        $item replace entity @s container.$(slot) with $(itemRepr)[custom_data = { __namespace__: 1b }, custom_name = '{"text":"$(item_name) §8§l♦ $(pointsColor)$(cost) SP","italic":false}', lore = ['[{"text":"Skills - $(type)","italic":false,"color":"blue"}]', '[{"text":"$(rarity)","italic":false,"color":"blue"}]', '[""]', '[{"text":"$(lore1)","italic":true,"color":"light_purple"}]', '[{"text":"$(lore2)","italic":true,"color":"light_purple"}]', '[""]', '["",{"text":"Click to buy!","italic":false,"color":"yellow"}]'], enchantments = { $(enchantName0):$(enchantLevel0), $(enchantName1):$(enchantLevel1) } ];
    }

    function click() {
        $itemsLength = Arrays.length(::Config.Shop.specialItems);

        Hardcode.repeatLists(
            [ "[start]", "[end]" ],
            () => {
                for ($slot = [start]; $slot < [end]; $slot++) {
                    $itemsLength -= 1;
                    if ($itemsLength < 0) { return 0; }
                    ::Menu.Pages.ItemShop.del();
                    ::Menu.Pages.ItemShop.slot = $slot;

                    execute run {
                        $execute unless data entity @s Items[{ Slot:$(slot)b } ] run {
                            ::Menu.Pages.ItemShop.id = $itemsLength;
                            Menu.Pages.ItemShop.clickedOnItem() with ::Menu.Pages.ItemShop;
                        }
                    } with ::Menu.Pages.ItemShop;
                }
            },
            [["1", "10", "19" ], ["8", "17", "26"]]
        );
    }

    function clickedOnItem() {
        $::Menu.Pages.ItemShop.itemName = ::Config.Shop.specialItems[$(id)].itemName;
        $::Menu.Pages.ItemShop.cost = ::Config.Shop.specialItems[ $(id) ].cost;
        Menu.Pages.ItemShop.buy() with ::Menu.Pages.ItemShop;
    }

    function buy() {
        $points = PPoints:@p;
        $scoreboard players set $cost prodiges_skills.__variable__ $(cost);
        $leninv = Arrays.playerInv_length(@p);
        if ($points < $cost) {
            // execute run { $Text.tellraw(@p, "&<red, bold>Skills ♦ &<red>Not enough SP to buy $(item_name)&<red>."); } with ::Menu.Pages.ItemShop;
            playsound minecraft:entity.enderman.teleport ambient @p[tag = prodiges_skills.pref.sound] ~ ~ ~ 1 1;
        } else if ($leninv > 34) {
            Text.tellraw(@p, "&<red, bold>Skills ♦ &<red>Inventory is full.");
            playsound minecraft:entity.enderman.teleport ambient @p[tag = prodiges_skills.pref.sound] ~ ~ ~ 1 1;
        } else {
            execute run {
                $Player.specialItems.giveFromId({ id: $(id) });
                // $Text.tellraw(@p, "&<green, bold>Skills ♦ &<green>You bought $(item_name) &<green>for &<gold>&<$cost> SP&<green>.");
            } with ::Menu.Pages.ItemShop;
            playsound minecraft:block.note_block.pling ambient @p[tag = prodiges_skills.pref.sound] ~ ~ ~ 1 2;
            PPoints:@p -= $cost;
        }
    }
}