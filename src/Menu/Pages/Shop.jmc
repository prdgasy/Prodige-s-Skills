class Menu.Pages.Shop {
    function activeBoosters() {
        // Points
        ::Menu.Pages.Shop.points = prodiges_skills.PPoints:@p;

        // XP Booster
        ::Menu.Pages.Shop.xpBooster = "§c-";
        $xpBoosterDuration = prodiges_skills.xpBooster.duration:@p;
        if ($xpBoosterDuration > 1) {
            ::Menu.Pages.Shop.xpBoosterDuration = $xpBoosterDuration;
            ::Menu.Pages.Shop.xpBoosterPower = prodiges_skills.xpBooster.power:@p;

            execute run {
                $::Menu.Pages.Shop.xpBooster = "§bx$(xpBoosterPower) XP Booster §7- $(xpBoosterDuration) minute(s) left";
            } with ::Menu.Pages.Shop;
        }

        // PPoints Booster
        ::Menu.Pages.Shop.pointBooster = "§c-";
        $pointBoosterDuration = prodiges_skills.pointBooster.duration:@p;
        if ($pointBoosterDuration > 1) {
            ::Menu.Pages.Shop.pointBoosterDuration = $pointBoosterDuration;
            ::Menu.Pages.Shop.pointBoosterPower = prodiges_skills.pointBooster.power:@p;

            execute run {
                $::Menu.Pages.Shop.pointBooster = "§6x$(pointBoosterPower) Skill Point Booster §7- $(pointBoosterDuration) minute(s) left";
            } with ::Menu.Pages.Shop;
        }

        execute run {
            // JMC.put('$execute as @p run loot replace entity @n[type=chest_minecart, tag=skillsLIB] container.4 loot {"type":"minecraft:command","pools":[{"rolls":1,"entries":[{"type":"minecraft:item","name":"minecraft:player_head","functions":[{"function":"minecraft:set_name","entity":"this","target":"custom_name","name":{"text":"Profile","color":"light_purple","italic":false}},{"function":"minecraft:fill_player_head","entity":"this"},{"function":"minecraft:set_custom_data","tag":"{prodiges_skills: 1b}"},{"function":"minecraft:set_lore","entity":"this","lore":[{"text":""},{"text":"§8§l♦ §rPoints: ","type":"text","extra":[{"text":"$(sp) SP","type":"text","color":"gold","italic":false}],"color":"green","italic":false},{"text":""},{"text":"Active Boosters:","color":"yellow","italic":false},{"text":"§8• $(booster_xp)","italic":false},{"text":"§8• $(booster_sp)","italic":false}],"mode":"append"}],"conditions":[]}]}]}');
        } with ::Menu.Pages.Shop;
    }

    function customItemsButton() {
        $itemShopState := prodiges_skills.Menu.shop.itemShopState:@s % 4;
        switch($itemShopState) {
            case 0: ::Menu.Pages.Shop.itemShopModel = "minecraft:diamond_sword";
            case 1: ::Menu.Pages.Shop.itemShopModel = "minecraft:iron_pickaxe";
            case 2: ::Menu.Pages.Shop.itemShopModel = "minecraft:leather_helmet";
            case 3: ::Menu.Pages.Shop.itemShopModel = "minecraft:golden_chestplate";
        }
        execute run {
            $item replace entity @s container.11 with stone[ item_model = "$(model)", custom_data = { prodiges_skills: 1b }, custom_name = '{"text":"Special Items","color":"aqua","italic":false}', lore = ['["",{"text":"Browse and purchase ","italic":false,"color":"white"},{"text":"exclusive","italic":false,"color":"light_purple"}]', '["",{"text":"tools ","italic":false,"color":"light_purple"},{"text":"and","italic":false,"color":"white"},{"text":" armor","italic":false,"color":"light_purple"},{"text":".","italic":false,"color":"white"}]', '["",{"text":"Unlock powerful gear!","italic":false,"color":"gray"}]', '[""]', '["",{"text":"Click to view!","italic":false,"color":"yellow"}]']];
        } with ::Menu.Pages.Shop;
    }

    function crates() {
        // Nouvelle page pour les crates ??
        ::Menu.Pages.Shop.crateCooldown = prodiges_skills.crate.cooldown:@p;
        if (prodiges_skills.crate.cooldown:@p > 0) {
            execute run { $::Menu.Pages.Shop.crateState = "§7You are still on a cooldown! ($(crateCooldown) minute(s))"; } with ::Menu.Pages.Shop;
            ::Menu.Pages.Shop.crateColor = "red";
            ::Menu.Pages.Shop.headTexture = { id:[ I; -1082168181, 1071530784, -1128679516, -2846883 ], properties:[ { name:"textures", value:"eyJ0ZXh0dXJlcyI6eyJTS0lOIjp7InVybCI6Imh0dHA6Ly90ZXh0dXJlcy5taW5lY3JhZnQubmV0L3RleHR1cmUvZWJjZGYwZmYwNzEyYWUzZGU1NTRjMzcyNjA3NzYxMDAwZDNiMGI2Yjg2MTNiOGEyYzZkZGEwMGNkMTBkNzhkOCJ9fX0=" } ] };
        } else {
            ::Menu.Pages.Shop.crateState = "§eClick to open!";
            ::Menu.Pages.Shop.crateColor = "light_purple";
            ::Menu.Pages.Shop.headTexture = { id:[ I; 1747670542, -1865006816, -1902654712, 1202578603 ], properties:[ { name:"textures", value:"eyJ0ZXh0dXJlcyI6eyJTS0lOIjp7InVybCI6Imh0dHA6Ly90ZXh0dXJlcy5taW5lY3JhZnQubmV0L3RleHR1cmUvY2MxYjJmNTkyY2ZjOGQzNzJkY2Y1ZmQ0NGVlZDY5ZGRkYzY0NjAxZDc4NDZkNzI2MTlmNzA1MTFkODA0M2E4OSJ9fX0=" } ] };
        }
        execute run {
            $item replace entity @s container.13 with player_head[custom_data = { prodiges_skills: 1b }, custom_name = '{"text":"Skill Crate","color":"$(crateColor)","italic":false}', lore = ['["",{"text":"Open special crates to obtain","italic":false,"color":"white"}]', '["",{"text":"unique tools","italic":false,"color":"gold"},{"text":" and ","italic":false,"color":"white"},{"text":"boosters","italic":false,"color":"aqua"},{"text":",","italic":false,"color":"white"}]', '["",{"text":"and ","italic":false,"color":"white"},{"text":"loot","italic":false,"color":"light_purple"},{"text":".","italic":false,"color":"white"}]', '["",{"text":"(i) You have 1 free crate","italic":false,"color":"gray"}]', '{"text":"every hour!","italic":false,"color":"gray"}', '[""]', '["",{"text":"$(crateState)","italic":false}]'], profile = $(headTexture) ];
        } with ::Menu.Pages.Shop;
    }

    function boostersButton() {
        $mod := prodiges_skills.Menu.shop.shopState:@s % 2;
        if ($mod == 1) {
            ::Menu.Pages.Shop.boosterButton = "experience_bottle";
        } else {
            ::Menu.Pages.Shop.boosterButton = "gold_ingot";
        }

        execute run {
            $item replace entity @s container.15 with $(boosterButton)[custom_data = { prodiges_skills: 1b }, custom_name = '["",{"text":"Boosters","italic":false,"color":"green"}]', lore = ['[{"text":"Boosters temporarily ","italic":false,"color":"white"},{"text":"increase","italic":false,"color":"gold"}]', '["",{"text":"your XP or Skill Point","italic":false,"color":"gold"},{"text":" gain.","italic":false,"color":"white"}]', '[{"text":"Speed up your progressoin!","italic":false,"color":"gray"}]', '[""]', '{"text":"Click to view!","italic":false,"color":"yellow"}'], enchantment_glint_override = true ];
        } with ::Menu.Pages.Shop;
    }
}