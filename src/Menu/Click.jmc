class Menu.Click {
    function 1() {

        // Skill detect
        $slot = 11;
        for ($index = 0; $index < #lenSkills; $index++) {
            ::temp.gui.prog.slot = $slot;
            ::temp.gui.prog.index = $index;
            execute run {
                $execute unless data entity @s Items[ { Slot:$(slot)b } ] run {
                    // Set prog page:
                    $scoreboard players set @s prodiges_skills.gui.index $(index);
                    ::temp.gui.prog.index = prodiges_skills.gui.index:@s;
                    execute run { $::temp.gui.prog.name = ::DB.Indexes.$(index); } with ::temp.gui.prog;
                    execute run { $scoreboard players operation $lvl prodiges_skills.__variable__ = @p prodiges_skills.$(name).lvl; } with ::temp.gui.prog;
                    if ($lvl <= 21) { prodiges_skills.gui.prog.page:@s = 1; }
                    else if ($lvl <= 43) { prodiges_skills.gui.prog.page:@s = 2; }
                    else if ($lvl <= 65) { prodiges_skills.gui.prog.page:@s = 3; }
                    else if ($lvl <= 87) { prodiges_skills.gui.prog.page:@s = 4; }
                    else if ($lvl <= 100) { prodiges_skills.gui.prog.page:@s = 5; }


                    skillsLIB.Logic.switch_page(2);
                    $index = #lenSkills; // <= Break loop
                } with ::temp.gui.prog;

            } with ::temp.gui.prog;
            $slot++;
        }
        if (!data entity @s Items[ { Slot:4b } ]) {
            skillsLIB.Logic.switch_page(4);
        } else if (!data entity @s Items[ { Slot:8b } ]) {
            skillsLIB.Logic.switch_page(6);
        } else if (!data entity @s Items[ { Slot:22b } ]) {
            prodiges_skills.gui.booster.type:@s = 1;
            prodiges_skills.gui.booster.power:@s = 1;
            prodiges_skills.gui.booster.duration:@s = 1;

            playsound minecraft:block.amethyst_block.place ambient @p[ tag = prodiges_skills.pref.sound ] ~ ~ ~ 1 0;
            skillsLIB.Logic.switch_page(5);
        } else if (!data entity @s Items[ { Slot:26b } ]) {
            tellraw @p [ "", { "text":"Skills \u2666 ", "bold":true, "color":"#4593cd", "clickEvent":{ "action":"open_url", "value":"https://discord.gg/b2hkD4Fn43" } }, { "text":"Click ", "color":"#4593cd", "clickEvent":{ "action":"open_url", "value":"https://discord.gg/b2hkD4Fn43" } }, { "text":"here", "bold":true, "underlined":true, "color":"#4593cd", "clickEvent":{ "action":"open_url", "value":"https://discord.gg/b2hkD4Fn43" } }, { "text":" to join the ", "color":"#4593cd", "clickEvent":{ "action":"open_url", "value":"https://discord.gg/b2hkD4Fn43" } }, { "text":"Discord", "bold":true, "color":"#4593cd", "clickEvent":{ "action":"open_url", "value":"https://discord.gg/b2hkD4Fn43" } }, { "text":"!", "color":"#4593cd", "clickEvent":{ "action":"open_url", "value":"https://discord.gg/b2hkD4Fn43" } } ];
            skillsLIB.construct.close();
        } else if (!data entity @s Items[ { Slot:21b } ]) {
            playsound minecraft:block.ender_chest.open ambient @p[ tag = prodiges_skills.pref.sound ] ~ ~ ~ 1 0;
            skillsLIB.Logic.switch_page(7);
        } else if (!data entity @s Items[ { Slot:23b } ]) {
            skillsLIB.construct.close();
        }

        skillsLIB.Logic.refresh();
    }

    function 2() {
        if (!data entity @s Items[ { Slot:0b } ]) {
            skillsLIB.Logic.switch_page(1);
        } else if (!data entity @s Items[ { Slot:9b } ]) {
            playsound minecraft:block.ender_chest.open ambient @p[ tag = prodiges_skills.pref.sound ] ~ ~ ~ 1 0;
            skillsLIB.Logic.switch_page(7);
        } else if (!data entity @s Items[ { Slot:17b } ]) {
            prodiges_skills.gui.tasks.page:@s = 0;
            skillsLIB.Logic.switch_page(3);
        } else if (!data entity @s Items[ { Slot:18b } ]) {
            GUI.prog.ability_switch();
        } else {
            // Levels
            ::temp.gui.prog.index = prodiges_skills.gui.index:@s;
            execute run { $::temp.gui.prog.name = ::DB.Indexes.$(index); } with ::temp.gui.prog;

            // Get data
            execute run {
                $::temp.gui.prog.data = ::DB.prodiges_skills.$(name);
            } with ::temp.gui.prog;

            switch(prodiges_skills.gui.prog.page:@s) {
                case 1: $lvlstart = 1; $lvlend = 21;
                case 2: $lvlstart = 22; $lvlend = 43;
                case 3: $lvlstart = 44; $lvlend = 65;
                case 4: $lvlstart = 66; $lvlend = 87;
                case 5: $lvlstart = 88; $lvlend = 100;
            }

            Hardcode.repeatLists(
                [ "[start]", "[end]" ],
                () => {
                    for ($slot = [ start ]; $slot < [ end ]; $slot++) {
                        if ($lvlstart > 100) { return 0; }
                        ::temp.gui.prog.data.slot = $slot;
                        ::temp.gui.prog.data.lvl = $lvlstart;
                        RomanConverter.toRoman(lvl, temp.gui.prog.data);
                        // Claimed ?
                        ::temp.gui.prog.data.lvl_id = $lvlstart;
                        $claimed = false;
                        execute run {
                            $execute if entity @p[ tag = !prodiges_skills.claimed.$(name).$(lvl_id) ] run { $claimed = true; }
                        } with ::temp.gui.prog.data;

                        // Set rewards
                        $mod = $lvlstart;
                        $mod %= 10;

                        if ($mod == 0) {
                            ::temp.gui.prog.data.command = ::DB.Rewards.3.command;
                            ::temp.gui.prog.data.point = ::DB.Rewards.3.point;
                            ::temp.gui.prog.data.show = ::DB.Rewards.3.show;
                        }
                        else if ($mod == 6 || $mod == 2) {
                            ::temp.gui.prog.data.command = ::DB.Rewards.2.command;
                            ::temp.gui.prog.data.point = ::DB.Rewards.2.point;
                            ::temp.gui.prog.data.show = ::DB.Rewards.2.show;
                        }
                        else {
                            ::temp.gui.prog.data.command = ::DB.Rewards.1.command;
                            ::temp.gui.prog.data.point = ::DB.Rewards.1.point;
                            ::temp.gui.prog.data.show = ::DB.Rewards.1.show;
                        }

                        GUI.Macro.click_prog() with ::temp.gui.prog.data;
                        $lvlstart++;
                    }
                },
                [ ["1", "10", "19" ], [ "8", "17", "26" ]]
            );
        }
        // First page, no next button
        if (prodiges_skills.gui.prog.page:@s < 5 && !data entity @s Items[ { Slot:26b } ]) {
            prodiges_skills.gui.prog.page:@s++;
            skillsLIB.Logic.click_event();
        }
        // Last page, no prev button
        else if (prodiges_skills.gui.prog.page:@s > 1 && !data entity @s Items[ { Slot:8b } ]) {
            prodiges_skills.gui.prog.page:@s--;
            skillsLIB.Logic.click_event();
        }

        skillsLIB.Logic.refresh();
    }

    function 3() {
        if (!data entity @s Items[ { Slot:0b } ]) {
            skillsLIB.Logic.switch_page(2);
        } else if (!data entity @s Items[ { Slot:18b } ]) {
            skillsLIB.construct.close();
        }

        // First page, no next button
        if (prodiges_skills.gui.tasks.page:@s < $page_number && !data entity @s Items[ { Slot:26b } ]) {
            prodiges_skills.gui.tasks.page:@s++;
            skillsLIB.Logic.click_event();
        }
        // Last page, no prev button
        else if (prodiges_skills.gui.tasks.page:@s > 0 && !data entity @s Items[ { Slot:8b } ]) {
            prodiges_skills.gui.tasks.page:@s--;
            skillsLIB.Logic.click_event();
        }

        skillsLIB.Logic.refresh();
    }

    function 4() {
        if (!data entity @s Items[ { Slot:21b } ]) {
            skillsLIB.Logic.switch_page(1);
        } else if (!data entity @s Items[ { Slot:11b } ]) {
            preference_toggle(lvl_broadcast);
        } else if (!data entity @s Items[ { Slot:12b } ]) {
            preference_toggle(xp_notif);
        } else if (!data entity @s Items[ { Slot:13b } ]) {
            preference_toggle(lvl_notif);
        } else if (!data entity @s Items[ { Slot:14b } ]) {
            preference_toggle(sound);
        } else if (!data entity @s Items[ { Slot:15b } ]) {
            preference_toggle(skill_prog);
        } else if (!data entity @s Items[ { Slot:23b } ]) {
            skillsLIB.construct.close();
        }
        skillsLIB.Logic.refresh();
    }

    function 5() {
        if (!data entity @s Items[ { Slot:21b } ]) {
            skillsLIB.Logic.switch_page(1);
        } else if (!data entity @s Items[ { Slot:11b } ]) {
            playsound minecraft:item.armor.equip_iron ambient @p[ tag = prodiges_skills.pref.sound ] ~ ~ ~ 2 1;
            skillsLIB.Logic.switch_page(8);
        } else if (!data entity @s Items[ { Slot:13b } ]) {
            Player.Crate.open();
        } else if (!data entity @s Items[ { Slot:15b } ]) {
            playsound minecraft:item.bottle.fill ambient @p[ tag = prodiges_skills.pref.sound ] ~ ~ ~ 2 1;
            skillsLIB.Logic.switch_page(9);
        } else if (!data entity @s Items[ { Slot:23b } ]) {
            skillsLIB.construct.close();
        }

        skillsLIB.Logic.refresh();
    }

    function 6() {
        if (!data entity @s Items[ { Slot:21b } ]) {
            skillsLIB.Logic.switch_page(1);
        } else if (!data entity @s Items[ { Slot:11b } ]) {
            tellraw @p [ "", { "text":"\nSkills Config \u2666 Editing Rewards", "bold":true, "color":"yellow" }, { "text":"\n" }, { "text":"\u25ba Open the file: ", "color":"white" }, { "text":"Prodige's Skills\\data\\prodiges_skills\\function\\config\\rewards", "color":"light_purple" }, { "text":"\n\n" }, { "text":"\u25ba Replace the", "color":"white" }, { "text":" /function ...", "color":"light_purple" }, { "text":" commands with the function you want to execute when a player levels up.", "color":"white" }, { "text":"\n\n" }, { "text":"\u25ba Save the file and reload with ", "color":"white" }, { "text":"/reload", "color":"light_purple" }, { "text":".", "color":"white" } ];
            skillsLIB.Logic.click_event();
        } else if (!data entity @s Items[ { Slot:12b } ]) {
            tellraw @p [ "", { "text":"\n" }, { "text":"Skills Config \u2666 Editing XP from Tasks", "bold":true, "color":"yellow" }, { "text":"\n\u25ba Open the file: " }, { "text":"Prodige's Skills\\data\\prodiges_skills\\function\\config\\prodiges_skills.mcfunction", "color":"light_purple" }, { "text":"\n You\u2019ll see a structure like this:\n" }, { "text":"...", "color":"gray" }, { "text":"\n" }, { "text":"Mining", "color":"white" }, { "text":": " }, { "text":"{", "color":"gold" }, { "text":"\n    " }, { "text":"...", "color":"gray" }, { "text":",\n    " }, { "text":"Tasks", "color":"light_purple" }, { "text":": " }, { "text":"[", "color":"blue" }, { "text":"\n        " }, { "text":"{", "color":"aqua" }, { "text":"..., task: \"stone\",", "color":"gray" }, { "text":" xp", "color":"green" }, { "text":": 1" }, { "text":", ...", "color":"gray" }, { "text":"}", "color":"aqua" }, { "text":",\n        " }, { "text":"...", "color":"gray" }, { "text":"\n    " }, { "text":"]", "color":"blue" }, { "text":",\n    " }, { "text":"...", "color":"gray" }, { "text":".\n" }, { "text":"}", "color":"gold" }, { "text":"\n" }, { "text":"...", "color":"gray" }, { "text":"\n\u25ba In the " }, { "text":"Tasks", "color":"light_purple" }, { "text":" list, modify the " }, { "text":"xp", "color":"green" }, { "text":" key to the value you want for each task.\n\u25ba Save the file and reload with " }, { "text":"/reload", "color":"light_purple" }, { "text":".\n " } ];
            skillsLIB.Logic.click_event();
        } else if (!data entity @s Items[ { Slot:13b } ]) {
            tellraw @p [ "", { "text":"\n" }, { "text":"Skills Config \u2666 Editing Points per Task", "bold":true, "color":"yellow" }, { "text":"\n\u25ba Open the file: " }, { "text":"Prodige's Skills\\data\\prodiges_skills\\function\\config\\points.mcfunction", "color":"light_purple" }, { "text":"\n\n" }, { "text":"execute store result score $prodiges_skills.point prodiges_skills.__variable__ run random ", "italic":true, "color":"gray" }, { "text":"roll", "italic":true, "color":"gold" }, { "text":" 1", "italic":true, "color":"gold" }, { "text":"..", "italic":true, "color":"gray" }, { "text":"5", "italic":true, "color":"gold" }, { "text":"\n\n\u25ba Modify the values of the " }, { "text":"roll", "color":"gold" }, { "text":", which represent the " }, { "text":"minimum", "color":"gold" }, { "text":" and " }, { "text":"maximum", "color":"gold" }, { "text":" points you can earn.\n\n\u25ba Save the file and reload with " }, { "text":"/reload", "color":"light_purple" }, { "text":"." } ];
            skillsLIB.Logic.click_event();
        } else if (!data entity @s Items[ { Slot:14b } ]) {
            tellraw @p [ "", { "text":"\n" }, { "text":"Skills Config \u2666 Adding Tasks", "bold":true, "color":"yellow" }, { "text":"\n\u25ba Open the file: " }, { "text":"Prodige's Skills\\data\\prodiges_skills\\function\\config\\prodiges_skills.mcfunction", "color":"light_purple" }, { "text":"\n\n\u25ba Find the " }, { "text":"Tasks", "color":"light_purple" }, { "text":" list, and add a new task like this:\n" }, { "text":"{ name: \"Mining\", task: \"end_stone\", xp: 15, item_repr: \"end_stone\", item_name: \"End Stone\", criteria: \"mined\" }", "color":"gold" }, { "text":"\n\n\u25ba To remove a task, simply delete the corresponding dictionary.\n\n\u25ba Save the file and reload with " }, { "text":"/reload", "color":"light_purple" }, { "text":"." } ];
            skillsLIB.Logic.click_event();
        } else if (!data entity @s Items[ { Slot:15b } ]) {
            Text.tellraw(@p, "&<yellow, bold>Skills ♦ &<yellow>Everyone's skills were reset.");
            advancement revoke @a only prodiges_skills:__private__/player_first_join;
            skillsLIB.Logic.click_event();
        } else if (!data entity @s Items[ { Slot:23b } ]) {
            skillsLIB.construct.close();
        }
        skillsLIB.Logic.refresh();
    }

    function 7() {
        $slot = 11;
        for ($index = 0; $index < #lenSkills; $index++) {
            ::temp.gui.prestige.slot = $slot;
            ::temp.gui.prestige.index = $index;
            execute run {
                $execute unless data entity @s Items[ { Slot:$(slot)b } ] run {
                    ::temp.gui.prestige.index = $index;
                    execute run { $::temp.gui.prestige.name = ::DB.Indexes.$(index); } with ::temp.gui.prestige;

                    GUI.Prestige.Click() with ::temp.gui.prestige;

                    $index = #lenSkills; // <= Break loop
                } with ::temp.gui.prestige;

            } with ::temp.gui.prestige;
            $slot++;
        }
        if (!data entity @s Items[ { Slot:21b } ]) {
            skillsLIB.Logic.switch_page(1);
        } else if (!data entity @s Items[ { Slot:23b } ]) {
            skillsLIB.construct.close();
        }
        skillsLIB.Logic.refresh();
    }

    function 8() {
        GUI.Items.click();
        if (!data entity @s Items[ { Slot:0b } ]) {
            skillsLIB.Logic.switch_page(5);
        } else if (!data entity @s Items[ { Slot:18b } ]) {
            skillsLIB.construct.close();
        }

        skillsLIB.Logic.refresh();
    }

    function 9() {
        if (!data entity @s Items[ { Slot:21b } ]) {
            skillsLIB.Logic.switch_page(5);
        } else if (!data entity @s Items[ { Slot:23b } ]) {
            skillsLIB.construct.close();
        }
        GUI.Boosters.click();
        skillsLIB.Logic.refresh();
    }
}