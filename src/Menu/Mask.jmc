class Menu.Mask {
    function 1() {
        Hardcode.repeat(
            "[SLOT]",
            () => {
                item replace entity @s container.[SLOT] with minecraft:purple_stained_glass_pane[
                    minecraft:hide_tooltip = { }, custom_data = { __namespace__:1b }
                ];
            },
            0, 27
        );
    }
    function 2() {
