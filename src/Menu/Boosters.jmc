class Menu.Boosters {
    function set_item() {
        $item replace entity @s container.$(slot) with $(item)[ custom_data = { skills_lib_gui:1b }, custom_name = '{"text":"x$(power) $(type) Booster §7- $(duration) min §8§l♦ $(sp_color)$(cost) SP","color":$(color),"italic":false}', lore = [ '[{"text":"Skills","color":"blue","italic":false}]', '[""]', '[{"text":"Click to buy!","color":"yellow","italic":false}]' ], enchantment_glint_override = $(glint) ];
    }

    function click() {
        $sp = prodiges_skills.player.sp:@p;
        len_inv($invlen);
        Hardcode.repeatLists(
            [ "[slot]", "[item]", "[power]", "[duration]", "[color]", "[cost]", "[type_int]", "[type]" ],
            () => {
                if (!data entity @s Items[ { Slot:[ slot ]b } ]) {
                    if ($sp < [ cost ]) {
                        Text.tellraw(@p, "&<red, bold>Skills ♦ &<red>Not enough SP to buy &<[color]>x[power] [type] Booster&<red>.");
                        playsound minecraft:entity.enderman.teleport ambient @p[ tag = prodiges_skills.pref.sound ] ~ ~ ~ 1 1;
                    } else if ($invlen > 34) {
                        Text.tellraw(@p, "&<red, bold>Skills ♦ &<red>Inventory is full.");
                        playsound minecraft:entity.enderman.teleport ambient @p[ tag = prodiges_skills.pref.sound ] ~ ~ ~ 1 1;
                    } else {
                        Player.Booster.give({ type_int: [ type_int ], type: "[type]", power: [ power ], duration: [ duration ], booster_color: "[color]", model: [ item ] });
                        playsound minecraft:block.note_block.pling ambient @p[ tag = prodiges_skills.pref.sound ] ~ ~ ~ 1 2;
                        prodiges_skills.player.sp:@p -= [ cost ];
                        Text.tellraw(@p, "&<green, bold>Skills ♦ &<green>You bought a &<[color]>x[power] [type] Booster &<green>for &<gold>[cost] SP&<green>.");
                    }
                }
            },
            [ ["10", "11", "12", "14", "15", "16" ], [ "experience_bottle", "experience_bottle", "experience_bottle", "gold_ingot", "gold_ingot", "gold_ingot" ], [ "2", "3", "5", "2", "5", "8" ], [ "15", "60", "120", "20", "30", "60" ], [ "aqua", "aqua", "aqua", "gold", "gold", "gold" ], [ "35", "50", "150", "50", "100", "200" ], [ "1", "1", "1", "2", "2", "2" ], [ "XP", "XP", "XP", "SP", "SP", "SP" ]]
        );
    }
}