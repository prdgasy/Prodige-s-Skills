class Menu.Pages.Tasks {
    function fill() {
        Hardcode.repeatLists(
            [ "[start]", "[end]" ],
            () => {
                for ($slot = [start]; $slot < [end]; $slot++) {
                    // Reset datas because we using +=
                    ::Menu.Pages.Tasks.del();
                    ::Menu.Pages.Tasks.slot = $slot;
                    ::Menu.Pages.Tasks.index = $index;

                    // Add task data
                    execute run { $::Menu.Pages.Tasks += ::Menu.Pages.Tasks.tab[$(index)]; } with ::Menu.Pages.Tasks;

                    // set
                    Menu.Pages.Tasks.setTaskItem() with ::Menu.Pages.Tasks;
                    $index++;
                }
            },
            [ ["1", "10", "19" ], [ "8", "17", "26" ]]
        );
    }

    function setTaskItem() {
        $item replace entity @s container.$(slot) with $(item_repr)[custom_data = { __namespace__: 1b }, custom_name = '{"text":"$(item_name) §b+$(xp) xp","color":"gray","italic":false}', !attribute_modifiers];
    }

    function setSkillItem() {
        ::Menu.Pages.Tasks.index = prodiges_skills.Menu.index:@s;
        execute run { $::Menu.Pages.Tasks.name = ::Consts.Indexes.$(index); } with ::Menu.Pages.Tasks;
        execute run { $::Menu.Pages.Tasks.item = ::Config.Skills.$(name).item; } with ::Menu.Pages.Tasks;
        execute run {
            $item replace entity @s container.9 with $(item)[custom_data = { __namespace__: 1b }, custom_name = '["",{"text":"$(name) Task Rewards","italic":false,"color":"yellow"}]', lore = ['["",{"text":"Here, you can find all ","italic":false,"color":"white"},{"text":"actions","italic":false,"color":"gold"}]', '["",{"text":"that grant ","italic":false,"color":"white"},{"text":"XP","italic":false,"color":"aqua"},{"text":". Check how much","italic":false,"color":"white"}]', '["",{"text":"each ","italic":false,"color":"white"},{"text":"task rewards you","italic":false,"color":"dark_purple"},{"text":". Use this","italic":false,"color":"white"}]', '["",{"text":"to optimize your skill","italic":false,"color":"white"}]', '["",{"text":"progression!","italic":false,"color":"white"}]'], !attribute_modifiers, enchantment_glint_override = true];
        } with ::Menu.Pages.Tasks;
    }

    function setItems() {
        // Get array
        execute run {
            $::Menu.Pages.Tasks.tab = ::Config.Skills.$(name).Tasks;
        } with ::Menu.Pages.Tasks;

        // Calculate pages
        $tabLength = Arrays.length(::Menu.Pages.Tasks.tab);
        $index = 0;
        $pageNumber = $tabLength;
        $pageNumber /= 21;

        $index = prodiges_skills.Menu.Tasks.page:@s;
        $index *= 21;
        Menu.Pages.Tasks.fill();
    }

    function setSliders() {
        item replace entity @s container.26 with paper[custom_data = { __namespace__: 1b }, custom_name = '{"text":"Next Page »","color":"yellow","italic":false, "bold":true}'];
        item replace entity @s container.8 with paper[custom_data = { __namespace__: 1b }, custom_name = '{"text":"« Previous Page","color":"yellow","italic":false, "bold":true}'];

        if (prodiges_skills.Menu.pageTasks:@s == $pageNumber) {
            item replace entity @s container.26 with paper[custom_data = { __namespace__: 1b }, custom_name = '{"text":"Next Page »","color":"gray","italic":false}'];
        }
        if (prodiges_skills.Menu.pageTasks:@s == 0) {
            item replace entity @s container.8 with paper[custom_data = { __namespace__: 1b }, custom_name = '{"text":"« Previous Page","color":"gray","italic":false}'];
        }
    }
}