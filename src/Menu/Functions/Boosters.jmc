class Menu.Boosters {
    function setItem() {
        $item replace entity @s container.$(slot) with $(item)[custom_data = { __namespace__: 1b }, custom_name = '{"text":"x$(power) $(type) Booster §7- $(duration) min §8§l♦ $(pointColor)$(cost) SP","color":$(color),"italic":false}', lore = ['[{"text":"Skills","color":"blue","italic":false}]', '[""]', '[{"text":"Click to buy!","color":"yellow","italic":false}]'], enchantment_glint_override = $(glint)];
    }

    function click() {
        $points = prodiges_skills.player.PPoints:@p;
        len_inv($invlen);
        Hardcode.repeatLists(
            [ "[slot]", "[item]", "[power]", "[duration]", "[color]", "[cost]", "[type_int]", "[type]" ],
            () => {
                if (!data entity @s Items[ { Slot:[slot]b } ]) {
                    if ($points < [ cost ]) {
                        Text.tellraw(@p, "&<red, bold>Skills ♦ &<red>Not enough SP to buy &<[color]>x[power] [type] Booster&<red>.");
                        playsound minecraft:entity.enderman.teleport ambient @p[ tag = prodiges_skills.pref.sound ] ~ ~ ~ 1 1;
                    } else if ($invlen > 34) {
                        Text.tellraw(@p, "&<red, bold>Skills ♦ &<red>Inventory is full.");
                        playsound minecraft:entity.enderman.teleport ambient @p[ tag = prodiges_skills.pref.sound ] ~ ~ ~ 1 1;
                    } else {
                        Player.Booster.give({ type_int: [ type_int ], type: "[type]", power: [ power ], duration: [ duration ], booster_color: "[color]", model: [ item ] });
                        playsound minecraft:block.note_block.pling ambient @p[ tag = prodiges_skills.pref.sound ] ~ ~ ~ 1 2;
                        prodiges_skills.player.sp:@p -= [ cost ];
                        Text.tellraw(@p, "&<green, bold>Skills ♦ &<green>You bought a &<[color]>x[power] [type] Booster &<green>for &<gold>[cost] SP&<green>.");
                    }
                }
            },
            [ ["10", "11", "12", "14", "15", "16" ], [ "experience_bottle", "experience_bottle", "experience_bottle", "gold_ingot", "gold_ingot", "gold_ingot" ], [ "2", "3", "5", "2", "5", "8" ], [ "15", "60", "120", "20", "30", "60" ], [ "aqua", "aqua", "aqua", "gold", "gold", "gold" ], [ "35", "50", "150", "50", "100", "200" ], [ "1", "1", "1", "2", "2", "2" ], [ "XP", "XP", "XP", "PP", "PP", "PP" ]]
        );
    }

    function activeBoosters() {
        ::Menu.Pages.Boosters.points = prodiges_skills.PPoints:@p;

        ::Menu.Pages.Boosters.xpBooster = "§c-";
        $xpBoosterDuration = prodiges_skills.xpBooster.duration:@p;
        if ($xpBoosterDuration > 1) {
            ::Menu.Pages.Boosters.xpBoosterDuration = $xpBoosterDuration;
            ::Menu.Pages.Boosters.xpBoosterPower = prodiges_skills.xpBooster.power:@p;

            execute run {
                $::Menu.Pages.Boosters.booster_xp = "§bx$(xpBoosterPower) XP Booster §7- $(xpBoosterDuration) minute(s) left";
            } with ::Menu.Pages.Boosters;
        }

        ::Menu.Pages.Boosters.pointBooster = "§c-";
        $pointBoosterDuration = prodiges_skills.pointBooster.duration:@p;
        if ($pointBoosterDuration > 1) {
            ::Menu.Pages.Boosters.pointBoosterDuration = $pointBoosterDuration;
            ::Menu.Pages.Boosters.pointBoosterPower = prodiges_skills.pointBooster.power:@p;

            execute run {
                $::Menu.Pages.Boosters.booster_sp = "§6x$(pointBoosterPower) Skill Point Booster §7- $(pointBoosterDuration) minute(s) left";
            } with ::Menu.Pages.Boosters;
        }

        execute run {
            // JMC.put('$execute as @p run loot replace entity @n[type=chest_minecart, tag=skillsLIB] container.4 loot {"type":"minecraft:command","pools":[{"rolls":1,"entries":[{"type":"minecraft:item","name":"minecraft:player_head","functions":[{"function":"minecraft:set_name","entity":"this","target":"custom_name","name":{"text":"Profile","color":"light_purple","italic":false}},{"function":"minecraft:fill_player_head","entity":"this"},{"function":"minecraft:set_custom_data","tag":"{__namespace__: 1b}"},{"function":"minecraft:set_lore","entity":"this","lore":[{"text":""},{"text":"§8§l♦ §rPoints: ","type":"text","extra":[{"text":"$(sp) SP","type":"text","color":"gold","italic":false}],"color":"#A888B5","italic":false},{"text":""},{"text":"Active Boosters:","color":"yellow","italic":false},{"text":"§8• $(booster_xp)","italic":false},{"text":"§8• $(booster_sp)","italic":false}],"mode":"append"}],"conditions":[]}]}]}');
        } with ::Menu.Pages.Boosters;
    }

    function fill() {
        Hardcode.repeatLists(
            [ "[slot]", "[item]", "[power]", "[duration]", "[color]", "[cost]", "[type]" ],
            () => {
                if ($points > [cost]) {
                    ::Menu.Pages.Boosters.glint = true;
                    ::Menu.Pages.Boosters.pointColor = "§6";
                } else {
                    ::Menu.Pages.Boosters.glint = false;
                    ::Menu.Pages.Boosters.pointColor = "§8";
                }
                ::Menu.Pages.Boosters.color = "[color]";
                ::Menu.Pages.Boosters.slot = [slot];
                ::Menu.Pages.Boosters.power = [power];
                ::Menu.Pages.Boosters.duration = [duration];
                ::Menu.Pages.Boosters.item = "[item]";
                ::Menu.Pages.Boosters.cost = [cost];
                ::Menu.Pages.Boosters.type = "[type]";
                Menu.Pages.Boosters.setItem() with ::Menu.Pages.Boosters;
            },
            [ ["10", "11", "12", "14", "15", "16" ], [ "experience_bottle", "experience_bottle", "experience_bottle", "gold_ingot", "gold_ingot", "gold_ingot" ], [ "2", "3", "5", "2", "5", "8" ], [ "15", "60", "120", "20", "30", "60" ], [ "aqua", "aqua", "aqua", "gold", "gold", "gold" ], [ "35", "50", "150", "50", "100", "200" ], [ "XP", "XP", "XP", "PPoints", "PPoints", "PPoints" ]]
        );
    }
}