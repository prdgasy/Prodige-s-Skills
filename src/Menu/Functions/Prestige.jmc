class Menu.Prestige {
    function Click() {
        $scoreboard players operation $p_lvl prodiges_skills.__variable__ = @p prodiges_skills.$(name).prestige;
        $scoreboard players operation $lvl prodiges_skills.__variable__ = @p prodiges_skills.$(name).lvl;
        if ($lvl < 100) {
            execute run {
                // $Text.tellraw(@p, "&<red, bold>Skills ♦ &<red>You need to be Level C (100) in &<gold>$(name) &<red>to Prestige.");
            } with ::Menu.Pages.Prestige;

            playsound minecraft:entity.enderman.teleport ambient @p[ tag = prodiges_skills.pref.sound ] ~ ~ ~ 1 1;
        } else if ($p_lvl == 5) {
            execute run {
                // $Text.tellraw(@p, "&<red, bold>Skills ♦ &<red>You cannot Prestige in &<gold>$(name) &<red>any anymore.");
            } with ::Menu.Pages.Prestige;

            playsound minecraft:entity.enderman.teleport ambient @p[ tag = prodiges_skills.pref.sound ] ~ ~ ~ 1 1;
        } else {
            execute run {
                $::Menu.Pages.Prestige.ability = ::Config.Skills.$(name).prestige.ability;
                $::Menu.Pages.Prestige.ability_desc1 = ::Config.Skills.$(name).prestige.ability_desc1;
                $::Menu.Pages.Prestige.ability_desc2 = ::Config.Skills.$(name).prestige.ability_desc2;

                $p_lvl++;
                ::Menu.Pages.Prestige.lvl = $p_lvl;
                RomanConverter.toRoman(lvl, Menu.Pages.Prestige);
                $power = $p_lvl;
                $power *= 5;
                ::Menu.Pages.Prestige.power = $power;

                execute run {
                    $Text.tellraw(@p, "&<#8174A0, bold>Skills ♦ &<green>You Prestiged &<gold>$(name)&<#8174A0>.");
                    $tellraw @p [ "", { "text":"You unlocked §l$(ability) $(lvl):", "color":"#EFB6C8" }, { "text":"\n $(ability_desc1)\n $(ability_desc2)\n " }, { "text":"\u2192 ", "bold":true, "color":"dark_gray" }, { "text":"+$(power)%", "bold":true, "color":"red" } ];

                } with ::Menu.Pages.Prestige;


                // Operations
                $scoreboard players add @p prodiges_skills.$(name).prestige 1;
                $scoreboard players set @p prodiges_skills.$(name).lvl 1;
                $scoreboard players set @p prodiges_skills.$(name).xp 0;
                $execute store result score @p prodiges_skills.$(name).xpToNext run data get storage prodiges_skills:prodiges_skills DB.prodiges_skills.$(name).xpstart;
                playsound minecraft:entity.ender_dragon.growl ambient @p[ tag = prodiges_skills.pref.sound ] ~ ~ ~ 1 1;
            } with ::Menu.Pages.Prestige;
        }
    }

    function fill() {
        $slot = 11;
        for ($index = 0; $index < __skillsLength__; $index++) {
            ::Menu.Pages.Prestige.index = $index;
            execute run { $::Menu.Pages.Prestige.name = ::Consts.Indexes.$(index); } with ::Menu.Pages.Prestige;

            Menu.Pages.Prestige.getData() with ::Menu.Pages.Prestige;
            execute run {
                $execute if score @p prodiges_skills.$(name).prestige matches ..4 run Menu.Pages.Prestige.setItem() with ::Menu.Pages.Prestige;

                $execute if score @p prodiges_skills.$(name).prestige matches 5 run Menu.Pages.Prestige.setItemMax() with ::Menu.Pages.Prestige;
            } with ::Menu.Pages.Prestige;

            $slot++;
        }
    }

    function getData() {
        ::Menu.Pages.Prestige.slot = $slot;

        // Datas
        $::Menu.Pages.Prestige.name = ::Config.Skills.$(name).name;
        $::Menu.Pages.Prestige.item = ::Config.Skills.$(name).item;
        $::Menu.Pages.Prestige.lore1 = ::Config.Skills.$(name).lore1;
        $::Menu.Pages.Prestige.lore2 = ::Config.Skills.$(name).lore2;
        $::Menu.Pages.Prestige.abilityLore1 = ::Config.Skills.$(name).Prestige.lore1;
        $::Menu.Pages.Prestige.abilityLore2 = ::Config.Skills.$(name).Prestige.lore2;
        $::Menu.Pages.Prestige.ability = ::Config.Skills.$(name).Prestige.ability;

        $scoreboard players operation $lvl prodiges_skills.__variable__ = @p prodiges_skills.$(name).lvl;
        $scoreboard players operation $prestigeLvl prodiges_skills.__variable__ = @p prodiges_skills.$(name).prestige;

        // Prestige calculations
        $prestigePower := $prestigeLvl * 5;

        ::Menu.Pages.Prestige.power = $prestigePower;
        ::Menu.Pages.Prestige.lvl = $lvl;
        ::Menu.Pages.Prestige.lvlRoman = RomanConverter.toRoman(::Menu.Pages.Prestige.lvl);
        ::Menu.Pages.Prestige.prestigeLvl = RomanConverter.toRoman(::Menu.Pages.Prestige.prestigeLvl);

        // Next prestige
        $prestigeNextLvl := $prestigeLvl + 1;
        ::Menu.Pages.Prestige.prestigeNextLvl = $prestigeNextLvl;
        ::Menu.Pages.Prestige.prestigeNextLvl = RomanConverter.toRoman(Menu.Pages.Prestige.prestigeNextLvl);

        $prestigeNextPower := $prestigeNextLvl * 5;
        ::Menu.Pages.Prestige.prestigeNextPower = $prestigeNextPower;

        // Max level
        ::Menu.Pages.Prestige.color1 = "gray";
        ::Menu.Pages.Prestige.color2 = "dark_gray";
        ::Menu.Pages.Prestige.glint = "false";
        $execute if score @p prodiges_skills.$(name).lvl matches 100 run {
            ::Menu.Pages.Prestige.color1 = "light_purple";
            ::Menu.Pages.Prestige.color2 = "dark_purple";
            ::Menu.Pages.Prestige.glint = "true";
        }
    }

    function setItem() {
        $item replace entity @s container.$(slot) with $(item)[
            custom_data = { __namespace__: 1b },
            custom_name = '[{"text":"$(name) ","italic":false,"color":"$(color_1)"}, {"text":"$(lvl) §8§l♦ ","italic":false,"color":"$(color_2)","bold":true}, {"text":"[","color":"dark_gray"},{"text":"$(prestige_lvl)","bold":true,"color":"red"},{"text":"]","color":"dark_gray"}]',
            lore = [
                '[{"text":"Level $(lvl_int)","italic":false,"color":"blue"}]',
                '[{"text":"$(desc1) ","italic":false,"color":"white"}]',
                '[{"text":"$(desc2) ","italic":false,"color":"white"}]',

                '[""]',
                '["",{"text":"♦","italic":false,"bold":true,"color":"dark_gray"},{"text":" ","italic":false},{"text":"Prestige:","italic":false,"color":"#a888b5"},{"text":" ","italic":false},{"text":"$(name) §8§l♦ §8[§c§l$(prestige_lvl)§8]","italic":false,"color":"#efb6c8"}]',
                '[""]',
                '["",{"text":"♦","italic":false,"bold":true,"color":"dark_gray"},{"text":" ","italic":false},{"text":"Ability:","italic":false,"color":"#a888b5"},{"text":" ","italic":false},{"text":"§l$(ability)","italic":false,"color":"#efb6c8"}]',
                '["",{"text":"  ","italic":false},{"text":"$(ability_desc1)  ","italic":false,"color":"#efb6c8"}]',
                '["",{"text":"  $(ability_desc2)","italic":false,"color":"#efb6c8"}]',
                '[{"text":"→ ","italic":false,"bold":true,"color":"dark_gray"}, {"text":"$(power)% ","italic":false,"bold":false,"color":"red"}]',
                '[{"text":"→ ","italic":false,"bold":true,"color":"dark_gray"}, {"text":"§l+$(power_next)% §rat next Prestige","bold":false,"italic":false,"color":"aqua"}]',

                '[""]',
                '[{"text":"Click to Prestige!","italic":false,"color":"$(color_1)"}]'
            ],

            !minecraft:attribute_modifiers,
            enchantment_glint_override = $(glint)
        ];
    }

    function setItemMax() {
        $item replace entity @s container.$(slot) with $(item)[
            custom_data = { __namespace__: 1b },
            custom_name = '[{"text":"$(name) ","italic":false,"color":"$(color_1)"}, {"text":"$(lvl) §8§l♦ ","italic":false,"color":"$(color_2)","bold":true}, {"text":"[","color":"dark_gray"},{"text":"$(prestige_lvl)","bold":true,"color":"red"},{"text":"]","color":"dark_gray"}]',
            lore = [
                '[{"text":"Level $(lvl_int)","italic":false,"color":"blue"}]',
                '[{"text":"$(desc1) ","italic":false,"color":"white"}]',
                '[{"text":"$(desc2) ","italic":false,"color":"white"}]',

                '[""]',
                '["",{"text":"♦","italic":false,"bold":true,"color":"dark_gray"},{"text":" ","italic":false},{"text":"Prestige:","italic":false,"color":"#a888b5"},{"text":" ","italic":false},{"text":"$(name) §8§l♦ §8[§c§l$(prestige_lvl)§8]","italic":false,"color":"#efb6c8"}]',
                '[""]',
                '["",{"text":"♦","italic":false,"bold":true,"color":"dark_gray"},{"text":" ","italic":false},{"text":"Ability:","italic":false,"color":"#a888b5"},{"text":" ","italic":false},{"text":"§l$(ability)","italic":false,"color":"#efb6c8"}]',
                '["",{"text":"  ","italic":false},{"text":"$(ability_desc1)  ","italic":false,"color":"#efb6c8"}]',
                '["",{"text":"  $(ability_desc2)","italic":false,"color":"#efb6c8"}]',
                '[{"text":"→ ","italic":false,"bold":true,"color":"dark_gray"}, {"text":"$(power)% ","italic":false,"bold":false,"color":"red"}]'
            ],

            !minecraft:attribute_modifiers
        ];
    }
}