class Menu.Masks {
    function purple() {
        Hardcode.repeat(
            "[SLOT]",
            () => {
                JMC.put('item replace entity @s container.[SLOT] with minecraft:purple_stained_glass_pane[minecraft:hide_tooltip = { }, custom_data = { __namespace__: 1b }]');
            },
            0, 27
        );
    }

    function gray() {
        Hardcode.repeat(
            "[SLOT]",
            () => {
                JMC.put('item replace entity @s container.[SLOT] with minecraft:gray_stained_glass_pane[minecraft:hide_tooltip = { }, custom_data = { __namespace__: 1b }]');
            },
            0, 9
        );
        Hardcode.repeat(
            "[SLOT]",
            () => {
                JMC.put('item replace entity @s container.[SLOT] with minecraft:black_stained_glass_pane[minecraft:hide_tooltip = { }, custom_data = { __namespace__: 1b }]');
            },
            9, 18
        );
        Hardcode.repeat(
            "[SLOT]",
            () => {
                JMC.put('item replace entity @s container.[SLOT] with minecraft:gray_stained_glass_pane[minecraft:hide_tooltip = { }, custom_data = { __namespace__: 1b }]');
            },
            18, 27
        );
    }
}