class Menu.Masks {
    function purple() {
        Hardcode.repeat(
            "[SLOT]",
            () => {
                JMC.put('item replace entity @s container.[SLOT] with minecraft:purple_stained_glass_pane[custom_data = { prodiges_skills: 1b }, tooltip_display = { } ]');
            },
            0, 27
        );
    }

    function gray() {
        Hardcode.repeat(
            "[SLOT]",
            () => {
                JMC.put('item replace entity @s container.[SLOT] with minecraft:gray_stained_glass_pane[custom_data = { prodiges_skills: 1b }, tooltip_display = { } ]');
            },
            0, 9
        );
        Hardcode.repeat(
            "[SLOT]",
            () => {
                JMC.put('item replace entity @s container.[SLOT] with minecraft:black_stained_glass_pane[custom_data = { prodiges_skills: 1b }, tooltip_display = { } ]');
            },
            9, 18
        );
        Hardcode.repeat(
            "[SLOT]",
            () => {
                JMC.put('item replace entity @s container.[SLOT] with minecraft:gray_stained_glass_pane[custom_data = { prodiges_skills: 1b }, tooltip_display = { } ]');
            },
            18, 27
        );
    }
}