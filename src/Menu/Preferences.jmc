class Menu.Preference {
    @lazy function toggleTag(tag) {
        if (entity @p[ tag = prodiges_skills.pref.$tag ]) {
            tag @p remove prodiges_skills.pref.$tag;
        } else {
            tag @p add prodiges_skills.pref.$tag;
        }
        playsound minecraft:entity.arrow.hit_player ambient @p[tag = prodiges_skills.pref.sound] ~ ~ ~ 1 0;
    }
}