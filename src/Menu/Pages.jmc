import 'Menu/Pages/Main.jmc';
import 'Menu/Pages/Progress.jmc';
import 'Menu/Pages/Tasks.jmc';
import 'Menu/Pages/Preferencecs.jmc';
import 'Menu/Pages/Shop.jmc';
import 'Menu/Pages/Prestige.jmc';
import 'Menu/Pages/ItemShop.jmc';
import 'Menu/Pages/Boosters.jmc';

class Menu.Pages {
    function Main() {
        Menu.Mask.default();

        // Prestiges
        item replace entity @s container.21 with netherite_scrap[custom_data = { __namespace__: 1b }, custom_name = '["",{"text":"Prestiges","italic":false,"color":"dark_purple"}]', lore = ['[{"text":"Once you reach ","italic":false,"color":"white"},{"text":"level","italic":false,"color":"gold"},{"text":" ","italic":false,"color":"white"},{"text":"100","italic":false},{"text":" (C) in a","italic":false,"color":"white"}]', '["",{"text":"skill, you can reset it to gain","italic":false,"color":"white"}]', '["",{"text":"a ","italic":false,"color":"white"},{"text":"permanent bonus","italic":false,"color":"green"},{"text":"!","italic":false,"color":"white"}]', '[{"text":"Grow even stronger over time!","italic":false,"color":"gray"}]', '[""]', '[{"text":"Click to view!","color":"yellow","italic":false}]'], enchantment_glint_override = true ];

        // close
        item replace entity @s container.23 with barrier[custom_data = { __namespace__: 1b }, custom_name = '{"text":"Close","color":"red","italic":false}'];

        // Config Panel
        if (entity @p[tag = global.admin]) {
            item replace entity @s container.8 with command_block[custom_data = { __namespace__: 1b }, custom_name = '["",{"text":"Configuration Panel","italic":false,"color":"red"}]', lore = ['["",{"text":"Modify all server-wide settings","italic":false,"color":"white"}]', '["",{"text":"here.","italic":false,"color":"white"}]', '[""]', '["",{"text":"Click to view!","italic":false,"color":"yellow"}]']];
        }

        // Shop
        item replace entity @s container.22 with player_head[ profile = { id:[ I; 1434832075, -102998962, -1229628019, 1369636598 ], properties:[ { name:"textures", value:"eyJ0ZXh0dXJlcyI6eyJTS0lOIjp7InVybCI6Imh0dHA6Ly90ZXh0dXJlcy5taW5lY3JhZnQubmV0L3RleHR1cmUvNTRjZGZiODhjZjhjMzY1NjMwNDI1NGU0ZDY3YTBhYjAyZjZkMjdjNzlmMWIxZTQwNGRjM2E3Y2U0ZWIyZGUwMCJ9fX0=" } ] }, custom_data = { __namespace__: 1b }, custom_name = '["",{"text":"Shop","italic":false,"color":"green"}]', lore = ['["",{"text":"Buy ","italic":false,"color":"white"},{"text":"boosters","italic":false,"color":"gold"},{"text":", ","italic":false,"color":"white"},{"text":"XP","italic":false,"color":"gold"},{"text":", ","italic":false,"color":"white"},{"text":"prestige","italic":false,"color":"gold"},{"text":", and","italic":false,"color":"white"}]', '["",{"text":"more! Unlock exclusive perks to","italic":false,"color":"white"}]', '["",{"text":"enhance your gameplay experience!","italic":false,"color":"white"}]', '[""]', '["",{"text":"Click to view!","italic":false,"color":"yellow"}]']];

        // Discord
        item replace entity @s container.26 with player_head[ profile = { id:[ I; -566027055, -1373812234, -1824937619, -1364409557 ], properties:[ { name:"textures", value:"eyJ0ZXh0dXJlcyI6eyJTS0lOIjp7InVybCI6Imh0dHA6Ly90ZXh0dXJlcy5taW5lY3JhZnQubmV0L3RleHR1cmUvNzg3M2MxMmJmZmI1MjUxYTBiODhkNWFlNzVjNzI0N2NiMzlhNzVmZjFhODFjYmU0YzhhMzliMzExZGRlZGEifX19" } ] }, custom_data = { __namespace__: 1b }, custom_name = '{"text":"Join the discord","color":"blue","italic":false}', lore = ['[{"text":"Need help ?","color":"white","italic":false}]', '[""]', '[{"text":"Click to join the discord!","color":"yellow","italic":false}]']];

        // Profile & Preferences
        Menu.Pages.Main.profileAndPreferences();

        // Skills
        Menu.Pages.Main.skills();
    }

    function Progress() {
        Menu.Mask.default();

        // Go back
        item replace entity @s container.0 with arrow[custom_data = { __namespace__: 1b }, custom_name = '{"text":"Go Back","color":"gray","italic":false}'];

        // Ou est l'index ?
        Menu.Pages.Progress.getSkillName() with ::Menu.Pages.Progress;

        // Get data
        Menu.Pages.Progress.getData() with ::Menu.Pages.Progress;

        // Get scores and set storages
        Menu.Pages.Progress.getScoresAndStorages() with ::Menu.Pages.Progress;
        
        // Prestige item
        execute run {
            $item replace entity @s container.9 with $(item)[custom_data = { __namespace__: 1b }, custom_name = '["", { "text":"🏆", "italic":false, "bold":true, "color":"yellow" }, { "text":" ", "italic":false }, { "text":"Prestige Your Skill!", "italic":false, "color":"yellow", "bold":false } ]', lore = ['["", { "text":"Once you reach ", "italic":false, "color":"white" }, { "text":"Level", "italic":false, "color":"light_purple" }, { "text":" ", "italic":false, "color":"white" }, { "text":"C ", "italic":false, "color":"dark_purple" }, { "text":"(100", "italic":false, "color":"gray" }, { "text":")", "italic":false, "color":"gray" }, { "text":",", "italic":false, "color":"white" } ]', '["", { "text":"you can ", "italic":false, "color":"white" }, { "text":"Prestige", "italic":false, "color":"aqua" }, { "text":" your skill!", "italic":false, "color":"white" } ]', '["", { "text":"Unlock ", "italic":false, "color":"gray" }, { "text":"exclusive bonuses", "italic":false, "color":"gray" }, { "text":" and", "italic":false, "color":"gray" } ]', '["", { "text":"showcase your mastery", "italic":false, "color":"gray" } ]', '[""]', '["", { "text":"Click here to view!", "italic":false, "color":"yellow" } ]'], !attribute_modifiers, enchantment_glint_override = true ];
        } with ::Menu.Pages.Progress.data;

        // Ability switch
        ::Menu.Pages.Progress.ability = "§a§l✔";
        execute run {
            $execute if entity @p[ tag = !prodiges_skills.ability.$(name) ] run ::Menu.Pages.Progress.ability = "§c§l❌";
        } with ::Menu.Pages.Progress;
        execute run {
            $item replace entity @s container.18 with minecraft:redstone_torch[custom_data = { __namespace__: 1b }, custom_name = '[{ "text":"Ability Toggle ", "italic":false, "color":"yellow" }, { "text":"§7[$(ability)§7]", "italic":false } ]', lore = ['[{ "text":"Enable or disable this", "italic":false, "color":"gray" } ]', '[{ "text":"ability.", "italic":false, "color":"gray" } ]', '[""]', '{ "text":"Click to toggle!", "color":"yellow", "italic":false } ']];
        } with ::Menu.Pages.Progress;

        // Set page

        Menu.Pages.Progress.setProgressPage();

        // Rewards
        item replace entity @s container.17 with book[custom_data = { __namespace__: 1b }, custom_name = '["", { "text":"Task Rewards", "italic":false, "color":"#996666" } ]', lore = ['["", { "text":"See", "italic":false, "color":"white" }, { "text":" ", "italic":false, "color":"gray" }, { "text":"XP", "italic":false, "color":"aqua" }, { "text":" ", "italic":false, "color":"gray" }, { "text":"values for each", "italic":false, "color":"white" }, { "text":" ", "italic":false, "color":"gray" }, { "text":"Tasks.", "italic":false, "color":"gold" } ]', '["", { "text":"Find out which actions pay off", "italic":false, "color":"gray" } ]', '["", { "text":"the most!", "italic":false, "color":"gray" } ]', '[""]', '["", { "text":"Click to view!", "italic":false, "color":"yellow" } ]']];
    }

    function Tasks() {
        Menu.Mask.blackGrayBlack();

        item replace entity @s container.0 with arrow[custom_data = { __namespace__: 1b }, custom_name = '{ "text":"Go Back", "color":"gray", "italic":false } '];
        item replace entity @s container.18 with barrier[custom_data = { __namespace__: 1b }, custom_name = '{ "text":"Close", "color":"red", "italic":false } '];

        // Set Skill Item
        Menu.Pages.Tasks.setSkillItem();

        // Get data
        Menu.Pages.Tasks.setItems();

        // Sliders
        Menu.Pages.Tasks.setSliders();
    }

    function Preferences() {
        Menu.Mask.default();

        item replace entity @s container.21 with arrow[custom_data = { __namespace__: 1b }, custom_name = '{ "text":"Go Back", "color":"gray", "italic":false } '];
        item replace entity @s container.23 with barrier[custom_data = { __namespace__: 1b }, custom_name = '{ "text":"Close", "color":"red", "italic":false } '];

        // Player profile info
        JMC.put('execute as @p run loot replace entity @n[type = chest_minecart, tag = skillsLIB] container.22 loot { "type":"minecraft:command", "pools":[{ "rolls":1, "entries":[{ "type":"minecraft:item", "name":"minecraft:player_head", "functions":[{ "function":"minecraft:set_name", "entity":"this", "target":"custom_name", "name":{ "text":"Profile & Preferences", "color":"light_purple", "italic":false } }, { "function":"minecraft:fill_player_head", "entity":"this" }, { "function":"minecraft:set_custom_data", "tag":"{__namespace__: 1b}" }, { "function":"minecraft:set_lore", "entity":"this", "lore":[{ "text":"Manage your §6settings §fand view your", "type":"text", "color":"white", "italic":false }, { "text":"§6stats§r. Customize your experience!", "type":"text", "color":"white", "italic":false } ], "mode":"append" } ], "conditions":[] } ] } ] } ');

        // How to change preferences
        item replace entity @s container.4 with paper[custom_data = { __namespace__: 1b }, custom_name = '["", { "text":"How to Change Preferences?", "italic":false, "color":"yellow", "bold":true } ]', lore = ['["", { "text":"♦", "italic":false, "bold":true, "color":"dark_gray" }, { "text":" Click on any setting to toggle", "italic":false, "color":"white" } ]', '["", { "text":" it ", "italic":false, "color":"white" }, { "text":"on or off", "italic":false, "color":"aqua" }, { "text":".", "italic":false, "color":"white" } ]', '[""]', '["", { "text":"♦ ", "italic":false, "bold":true, "color":"dark_gray" }, { "text":"Your changes will ", "italic":false, "color":"white" }, { "text":"instantly", "italic":false, "color":"gold" } ]', '["", { "text":" apply—customize your experience", "italic":false, "color":"white" } ]', '["", { "text":" freely!", "italic":false, "color":"white" } ]']];




        Menu.Pages.Preferences.fillPrefs() with ::Menu.Pages.Preferences;
    }

    function Shop() {
        Menu.Mask.default();

        item replace entity @s container.21 with arrow[custom_data = { __namespace__: 1b }, custom_name = '{ "text":"Go Back", "color":"gray", "italic":false } '];
        item replace entity @s container.23 with barrier[custom_data = { __namespace__: 1b }, custom_name = '{ "text":"Close", "color":"red", "italic":false } '];

        // Infos about the Shop
        item replace entity @s container.22 with player_head[profile = { id:[I; 1434832075, -102998962, -1229628019, 1369636598], properties:[{ name:"textures", value:"eyJ0ZXh0dXJlcyI6eyJTS0lOIjp7InVybCI6Imh0dHA6Ly90ZXh0dXJlcy5taW5lY3JhZnQubmV0L3RleHR1cmUvNTRjZGZiODhjZjhjMzY1NjMwNDI1NGU0ZDY3YTBhYjAyZjZkMjdjNzlmMWIxZTQwNGRjM2E3Y2U0ZWIyZGUwMCJ9fX0=" } ] }, custom_data = { __namespace__: 1b }, custom_name = '["", { "text":"Shop", "italic":false, "color":"green" } ]', lore = ['["", { "text":"Buy ", "italic":false, "color":"white" }, { "text":"boosters", "italic":false, "color":"gold" }, { "text":", ", "italic":false, "color":"white" }, { "text":"XP", "italic":false, "color":"gold" }, { "text":", ", "italic":false, "color":"white" }, { "text":"prestige", "italic":false, "color":"gold" }, { "text":", and", "italic":false, "color":"white" } ]', '["", { "text":"more! Unlock exclusive perks to", "italic":false, "color":"white" } ]', '["", { "text":"enhance your gameplay experience!", "italic":false, "color":"white" } ]']];

        // Active boosters & infos
        Menu.Pages.Shop.activeBoosters();

        // Items
        Menu.Pages.Shop.customItemsButton();

        // Skill Crate
        Menu.Pages.Shop.crates();

        // Boosters
        Menu.Pages.Shop.boostersButton();
    }

    function Prestige() {
        Menu.Mask.fullPurple();

        item replace entity @s container.21 with arrow[custom_data = { __namespace__: 1b }, custom_name = '{ "text":"Go Back", "color":"gray", "italic":false } '];
        item replace entity @s container.22 with netherite_scrap[custom_data = { __namespace__: 1b }, custom_name = '["", { "text":"Prestiges", "italic":false, "color":"dark_purple" } ]', lore = ['[{ "text":"Once you reach ", "italic":false, "color":"white" }, { "text":"level", "italic":false, "color":"gold" }, { "text":" ", "italic":false, "color":"white" }, { "text":"100", "italic":false }, { "text":" (C) in a", "italic":false, "color":"white" } ]', '["", { "text":"skill, you can reset it to gain", "italic":false, "color":"white" } ]', '["", { "text":"a ", "italic":false, "color":"white" }, { "text":"permanent bonus", "italic":false, "color":"green" }, { "text":"!", "italic":false, "color":"white" } ]', '[{ "text":"Grow even stronger over time!", "italic":false, "color":"gray" } ]'], enchantment_glint_override = true ];
        item replace entity @s container.23 with barrier[custom_data = { __namespace__: 1b }, custom_name = '{ "text":"Close", "color":"red", "italic":false } '];
        item replace entity @s container.4 with paper[custom_data = { __namespace__: 1b }, custom_name = '["", { "text":"How to Choose a Skill to Prestige", "italic":false, "color":"yellow", "bold":true } ]', lore = ['["", { "text":"To choose, click on the skill you", "italic":false, "color":"white" } ]', '["", { "text":"want to reset (with level 100).", "italic":false, "color":"white" } ]', '[""]', '["", { "text":"You\'ll gain a bonus and a special", "italic":false, "color":"white" } ]', '["", { "text":"title upon prestiging.", "italic":false, "color":"white" } ]']];

        Menu.Pages.Prestige.fill();
    }

    function ItemShop() {
        Menu.Mask.default();

        item replace entity @s container.0 with arrow[custom_data = { __namespace__: 1b }, custom_name = '{ "text":"Go Back", "color":"gray", "italic":false } '];
        item replace entity @s container.9 with stone[ item_model = "minecraft:leather_helmet", custom_data = { __namespace__: 1b }, custom_name = '{ "text":"Special Items", "color":"aqua", "italic":false } ', lore = ['["", { "text":"Browse and purchase ", "italic":false, "color":"white" }, { "text":"exclusive", "italic":false, "color":"light_purple" } ]', '["", { "text":"tools ", "italic":false, "color":"light_purple" }, { "text":"and", "italic":false, "color":"white" }, { "text":" armor", "italic":false, "color":"light_purple" }, { "text":".", "italic":false, "color":"white" } ]', '["", { "text":"Unlock powerful gear!", "italic":false, "color":"gray" } ]']];
        item replace entity @s container.18 with barrier[custom_data = { __namespace__: 1b }, custom_name = '{ "text":"Close", "color":"red", "italic":false } '];

        $itemsLength = Arrays.length(::Config.Shop.specialItems);
        Hardcode.repeatLists(
            [ "[start]", "[end]" ],
            () => {
                for ($slot = [start]; $slot < [end]; $slot++) {
                    $itemsLength -= 1;
                    // Stop if no more items
                    if ($itemsLength < 0) { return 0; }
                    ::Menu.Pages.ItemShop.del();
                    ::Menu.Pages.ItemShop.slot = $slot;
                    ::Menu.Pages.ItemShop.index = $itemsLength;

                    Menu.Pages.ItemShop.setParam() with ::Menu.Pages.ItemShop;
                    Menu.Pages.ItemShop.setItem() with ::Menu.Pages.ItemShop;
                }
            },
            [ ["1", "10", "19" ], [ "8", "17", "26" ]]
        );
    }

    function Boosters() {
        Menu.Mask.default();
        item replace entity @s container.21 with arrow[custom_data = { __namespace__: 1b }, custom_name = '{ "text":"Go Back", "color":"gray", "italic":false } '];
        item replace entity @s container.22 with experience_bottle[custom_data = { __namespace__: 1b }, custom_name = '["", { "text":"Boosters", "italic":false, "color":"green" } ]', lore = ['[{ "text":"Boosters temporarily ", "italic":false, "color":"white" }, { "text":"increase", "italic":false, "color":"gold" } ]', '["", { "text":"your XP or Skill Point", "italic":false, "color":"gold" }, { "text":" gain.", "italic":false, "color":"white" } ]', '[{ "text":"Speed up your progressoin!", "italic":false, "color":"gray" } ]'], enchantment_glint_override = true ];
        item replace entity @s container.23 with barrier[custom_data = { __namespace__: 1b }, custom_name = '{ "text":"Close", "color":"red", "italic":false } '];

        // Active boosters & infos
        Menu.Pages.Shop.activeBoosters();

        // Fill
        Menu.Pages.Boosters.fill();
    }
}