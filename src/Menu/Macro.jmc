// a supprimer
class Menu.Macro {
    function click_prog() {
        $execute unless data entity @s Items[ { Slot:$(slot)b } ] run {
            $scoreboard players operation $lvl prodiges_skills.__variable__ = @p prodiges_skills.$(name).lvl;

            if ($lvl < $lvlstart) {
                Text.tellraw(@p, "&<red, bold>Skills ♦ &<red>You cannot claim this reward yet.");
                execute at @p run playsound minecraft:entity.enderman.teleport ambient @p[ tag = prodiges_skills.pref.sound ] ~ ~ ~ 1 1;
            } else if ($lvl > $lvlstart && $claimed) {
                Text.tellraw(@p, "&<red, bold>Skills ♦ &<red>You already claimed this reward.");
                execute at @p run playsound minecraft:entity.enderman.teleport ambient @p[ tag = prodiges_skills.pref.sound ] ~ ~ ~ 1 1;
            } else if ($lvl > $lvlstart && !$claimed) {
                execute run {
                    $tag @p remove prodiges_skills.claimed.$(name).$(lvl_id);
                    // $Text.tellraw(@p, "&<green, bold>Skills ♦ &<green>You have claimed &<light_purple>$(name) &<dark_purple, bold>$(lvl)&<green>!");
                    // $$(command);
                    // $Text.tellraw(@p, " &<dark_gray>- $(show)");
                    // $Text.tellraw(@p, " &<dark_gray>- &<gold>+$(point) Skill Points (SP)");
                    execute at @p run playsound minecraft:entity.arrow.hit_player ambient @p[ tag = prodiges_skills.pref.sound ] ~ ~ ~ 1 2;
                } with ::temp.gui.prog.data;
            } else if ($lvl == 100 && $lvlstart == 100) {
                playsound minecraft:block.ender_chest.open ambient @p[ tag = prodiges_skills.pref.sound ] ~ ~ ~ 1 0;
                skillsLIB.Logic.switch_page(7);
            } else {
                execute run {
                    // $Text.tellraw(@p, "&<yellow, bold>Skills ♦ &<gold>$(name) $(lvl) &<yellow>is still in progress.");
                } with ::temp.gui.prog.data;
            }
        } with ::temp.gui.prog.data;

    }

    function prestige_set() {
        $item replace entity @s container.$(slot) with $(item)[
            custom_data = { __namespace__: 1b },
            custom_name = '[{"text":"$(name) ","italic":false,"color":"$(color_1)"}, {"text":"$(lvl) §8§l♦ ","italic":false,"color":"$(color_2)","bold":true}, {"text":"[","color":"dark_gray"},{"text":"$(prestige_lvl)","bold":true,"color":"red"},{"text":"]","color":"dark_gray"}]',
            lore = [
                '[{"text":"Level $(lvl_int)","italic":false,"color":"blue"}]',
                '[{"text":"$(desc1) ","italic":false,"color":"white"}]',
                '[{"text":"$(desc2) ","italic":false,"color":"white"}]',

                '[""]',
                '["",{"text":"♦","italic":false,"bold":true,"color":"dark_gray"},{"text":" ","italic":false},{"text":"Prestige:","italic":false,"color":"#a888b5"},{"text":" ","italic":false},{"text":"$(name) §8§l♦ §8[§c§l$(prestige_lvl)§8]","italic":false,"color":"#efb6c8"}]',
                '[""]',
                '["",{"text":"♦","italic":false,"bold":true,"color":"dark_gray"},{"text":" ","italic":false},{"text":"Ability:","italic":false,"color":"#a888b5"},{"text":" ","italic":false},{"text":"§l$(ability)","italic":false,"color":"#efb6c8"}]',
                '["",{"text":"  ","italic":false},{"text":"$(ability_desc1)  ","italic":false,"color":"#efb6c8"}]',
                '["",{"text":"  $(ability_desc2)","italic":false,"color":"#efb6c8"}]',
                '[{"text":"→ ","italic":false,"bold":true,"color":"dark_gray"}, {"text":"$(power)% ","italic":false,"bold":false,"color":"red"}]',
                '[{"text":"→ ","italic":false,"bold":true,"color":"dark_gray"}, {"text":"§l+$(power_next)% §rat next Prestige","bold":false,"italic":false,"color":"aqua"}]',

                '[""]',
                '[{"text":"Click to Prestige!","italic":false,"color":"$(color_1)"}]'
            ],

            !minecraft:attribute_modifiers,
            enchantment_glint_override = $(glint)
        ];
    }

    function prestige_set_max() {
        $item replace entity @s container.$(slot) with $(item)[
            custom_data = { __namespace__: 1b },
            custom_name = '[{"text":"$(name) ","italic":false,"color":"$(color_1)"}, {"text":"$(lvl) §8§l♦ ","italic":false,"color":"$(color_2)","bold":true}, {"text":"[","color":"dark_gray"},{"text":"$(prestige_lvl)","bold":true,"color":"red"},{"text":"]","color":"dark_gray"}]',
            lore = [
                '[{"text":"Level $(lvl_int)","italic":false,"color":"blue"}]',
                '[{"text":"$(desc1) ","italic":false,"color":"white"}]',
                '[{"text":"$(desc2) ","italic":false,"color":"white"}]',

                '[""]',
                '["",{"text":"♦","italic":false,"bold":true,"color":"dark_gray"},{"text":" ","italic":false},{"text":"Prestige:","italic":false,"color":"#a888b5"},{"text":" ","italic":false},{"text":"$(name) §8§l♦ §8[§c§l$(prestige_lvl)§8]","italic":false,"color":"#efb6c8"}]',
                '[""]',
                '["",{"text":"♦","italic":false,"bold":true,"color":"dark_gray"},{"text":" ","italic":false},{"text":"Ability:","italic":false,"color":"#a888b5"},{"text":" ","italic":false},{"text":"§l$(ability)","italic":false,"color":"#efb6c8"}]',
                '["",{"text":"  ","italic":false},{"text":"$(ability_desc1)  ","italic":false,"color":"#efb6c8"}]',
                '["",{"text":"  $(ability_desc2)","italic":false,"color":"#efb6c8"}]',
                '[{"text":"→ ","italic":false,"bold":true,"color":"dark_gray"}, {"text":"$(power)% ","italic":false,"bold":false,"color":"red"}]'
            ],

            !minecraft:attribute_modifiers
        ];
    }
}