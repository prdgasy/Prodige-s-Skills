class Player.Crate {
    function open() {
        // as menu
        len_inv($invlen);
        if (skills.crate.cooldown:@p > 0) {
            // Text.tellraw(@p, "&<red, bold>Skills ♦ &<red>You are still on a cooldown (&<skills.crate.cooldown:@p> minute(s))."); // SOUCIS DE QUOTES MALFORMEE
            playsound minecraft:entity.enderman.teleport ambient @p[ tag = prodiges_skills.pref.sound ] ~ ~ ~ 1 1;
        } else if ($invlen > 34) {
            Text.tellraw(@p, "&<red, bold>Skills ♦ &<red>Inventory is full.");
            playsound minecraft:entity.enderman.teleport ambient @p[ tag = prodiges_skills.pref.sound ] ~ ~ ~ 1 1;
        } else {
            playsound minecraft:block.chest.open ambient @p[ tag = prodiges_skills.pref.sound ] ~ ~ ~ 1 0;
            playsound minecraft:entity.wind_charge.wind_burst ambient @p[ tag = prodiges_skills.pref.sound ] ~ ~ ~ 1 0;
            skills.crate.cooldown:@p = 60;
            len_array($len_crate, DB.Shop.crate);
            $len_crate -= 1;
            ::temp.gui.crate.len = $len_crate;
            execute run { $::temp.gui.crate.i = random value 0..$(len); } with ::temp.gui.crate;

            execute run {
                $::temp.gui.crate = ::DB.Shop.crate[ $(i) ];
            } with ::temp.gui.crate;

            execute run {
                $$(command);
            } with ::temp.gui.crate;
            // Separé car $$(command) defini $(rerp)
            execute run {
                $tellraw @p [
                    "",
                    { "text":"\n ♦ ", "bold":true, "color":"aqua" },
                    { "text":"Skill Crate", "bold":true, "color":"gold" },
                    { "text":" ♦\n", "bold":true, "color":"aqua" },
                    { "text":"\n §l\u25BA §eRewards:\n", "bold":false, "color":"yellow" },
                    { "text":" \u0020 \u25CF ", "color":"gray" },
                    { "text":"$(repr)" }
                ];
            } with ::temp.gui.crate;
        }
    }

}