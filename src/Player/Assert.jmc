// DEPLACER CELA DANS MENU.JMC

class Player.Assert {
    function inventoryFull() {
        Text.tellraw(@p, "&<red, bold>Skills ♦ &<red>Inventory full! Free up some space."); playsound minecraft:entity.enderman.teleport ambient @p[ tag = prodiges_skills.pref.sound ] ~ ~ ~ 1 1;
    }

    function notEnoughSP() {
        Text.tellraw(@p, "&<red, bold>Skills ♦ &<red>Not enough Skill Point to buy this."); playsound minecraft:entity.enderman.teleport ambient @p[ tag = prodiges_skills.pref.sound ] ~ ~ ~ 1 1;
    }

    function upgradeMax() {
        Text.tellraw(@p, "&<red, bold>Skills ♦ &<red>You cannot upgrade this Talent anymore.");
        playsound entity.item.picked_up ambient @p[ tag = prodiges_skills.pref.sound ] ~ ~ ~ 1 0;
    }
}