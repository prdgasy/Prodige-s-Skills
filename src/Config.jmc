            { type: "Foraging", itemName: "§2Whispers of the Grove", itemRepr: "diamond_axe", Enchants: [{ name: "efficiency", level: 5 }, { name: "fortune", level: 2 } ], cost: 400, lore1: "Crafted from ancient oaks, cleaves wood.", lore2: "Brings bountiful harvests with every swing." },
            { type: "Combat", itemName: "§4Doombringer", itemRepr: "diamond_sword", Enchants: [{ name: "sharpness", level: 4 }, { name: "knockback", level: 2 } ], cost: 350, lore1: "Once swung by fallen champions.", lore2: "Each cut leaves a lasting scar." },
            { type: "Agility", itemName: "§3Windrunner’s Grace", itemRepr: "chainmail_boots", Enchants: [{ name: "soul_speed", level: 3 }, { name: "swift_sneak", level: 2 } ], cost: 350, lore1: "Worn by those who outrun fate.", lore2: "Moves swiftly over any terrain." },
            { type: "Defense", itemName: "§9Titan’s Guard", itemRepr: "shield", Enchants: [{ name: "thorns", level: 4 }, { name: "mending", level: 1 } ], cost: 300, lore1: "Forged in battle, unbreakable shield.", lore2: "Stands strong against all enemies." },
            { type: "Excavation", itemName: "§6Dune Reaver", itemRepr: "diamond_shovel", Enchants: [{ name: "efficiency", level: 4 }, { name: "silk_touch", level: 1 } ], cost: 300, lore1: "Crafted by nomads, carves soft sand.", lore2: "Digs with unnatural precision." },
            { type: "Farming", itemName: "§aReaper’s Gift", itemRepr: "diamond_hoe", Enchants: [{ name: "fortune", level: 3 }, { name: "efficiency", level: 4 } ], cost: 250, lore1: "Blessed by harvest spirits, reaps fast.", lore2: "Ensures bountiful yields every season." },
            { type: "Foraging", itemName: "§2Ancient Timber", itemRepr: "iron_axe", Enchants: [{ name: "sharpness", level: 2 }, { name: "efficiency", level: 4 } ], cost: 250, lore1: "Axe of old, fells trees fast.", lore2: "Its edge never dulls with age." },
            { type: "Mining", itemName: "§7Stonebreaker", itemRepr: "diamond_pickaxe", Enchants: [{ name: "efficiency", level: 4 }, { name: "silk_touch", level: 1 } ], cost: 200, lore1: "Forged by dwarves, unearths riches.", lore2: "Its power grows with each strike." },
            { type: "Combat", itemName: "§4Crimson Fang", itemRepr: "iron_sword", Enchants: [{ name: "fire_aspect", level: 1 }, { name: "unbreaking", level: 2 } ], cost: 200, lore1: "Forged in blood, sears the flesh.", lore2: "Strikes fear into all enemies." },
            { type: "Defense", itemName: "§9Ironclad Resolve", itemRepr: "iron_chestplate", Enchants: [{ name: "protection", level: 3 }, { name: "unbreaking", level: 1 } ], cost: 180, lore1: "Armor of knights, sturdy and strong.", lore2: "Withstands battles, time after time." },
            { type: "Agility", itemName: "§3Storm Chaser", itemRepr: "iron_boots", Enchants: [{ name: "feather_falling", level: 3 }, { name: "unbreaking", level: 2 } ], cost: 150, lore1: "Swift as thunder, light as air.", lore2: "Never slows, even in storms." },
            { type: "Farming", itemName: "§aGolden Tiller", itemRepr: "golden_hoe", Enchants: [{ name: "efficiency", level: 3 }, { name: "unbreaking", level: 1 } ], cost: 120, lore1: "Glows under sunlight, works the land.", lore2: "Fields flourish in its presence." },
            { type: "Mining", itemName: "§7Earthshaper", itemRepr: "stone_pickaxe", Enchants: [{ name: "unbreaking", level: 3 }, { name: "efficiency", level: 5 } ], cost: 100, lore1: "Carved from bedrock’s deep veins.", lore2: "Cuts through stone like butter." },
            { type: "Excavation", itemName: "§6The Wyrm’s Digger", itemRepr: "iron_shovel", Enchants: [{ name: "efficiency", level: 2 }, { name: "unbreaking", level: 1 } ], cost: 75, lore1: "Used to dig through time-worn ruins.", lore2: "Uncovers forgotten artifacts from deep." }
        ];
    }

    function Crate() {
        ::DB.Shop.Crates = [
            // Spécial Items (random)
            { command: "function prodiges_skills:player/specialitems/give_random", repr: "-" },

            // Advanced Loot
            { command: "function prodiges_skills:rewards/advanced", repr: "§aAdvanced Loot" },
            { command: "function prodiges_skills:rewards/advanced", repr: "§aAdvanced Loot" },

            // Boosters
            { command: "function prodiges_skills:player/booster/give {type: \"XP\", power: 4, type_int:1, duration: 45, booster_color: \"aqua\", model: \"experience_bottle\"}", repr: "§bx4 XP Booster - 45 min" },
            { command: "function prodiges_skills:player/booster/give {type: \"SP\", power: 4, type_int:2, duration: 20, booster_color: \"gold\", model: \"gold_ingot\"}", repr: "§6x4 SP Booster - 20 min" },
            { command: "function prodiges_skills:player/booster/give {type: \"XP\", power: 3, type_int:1, duration: 30, booster_color: \"blue\", model: \"experience_bottle\"}", repr: "§bx3 XP Booster - 30 min" },
            { command: "function prodiges_skills:player/booster/give {type: \"SP\", power: 2, type_int:2, duration: 15, booster_color: \"yellow\", model: \"gold_ingot\"}", repr: "§6x2 SP Booster - 15 min" },

            // Basic Loot
            { command: "function prodiges_skills:rewards/basic", repr: "§7Basic Loot" },
            { command: "function prodiges_skills:rewards/basic", repr: "§7Basic Loot" },
            { command: "function prodiges_skills:rewards/basic", repr: "§7Basic Loot" },
            { command: "function prodiges_skills:rewards/basic", repr: "§7Basic Loot" },

            // Skill Points (SP)
            { command: "scoreboard players add @p skills.player.sp 250", repr: "§6250 Skill Points (SP)" },
            { command: "scoreboard players add @p skills.player.sp 150", repr: "§6150 Skill Points (SP)" },
            { command: "scoreboard players add @p skills.player.sp 80", repr: "§680 Skill Points (SP)" },
            { command: "scoreboard players add @p skills.player.sp 50", repr: "§650 Skill Points (SP)" },
            { command: "scoreboard players add @p skills.player.sp 40", repr: "§640 Skill Points (SP)" }
        ];
    }
}




